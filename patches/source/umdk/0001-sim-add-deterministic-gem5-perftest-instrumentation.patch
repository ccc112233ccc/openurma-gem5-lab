diff --git a/src/urma/common/ub_get_clock.c b/src/urma/common/ub_get_clock.c
index d5a30e0..5b64716 100644
--- a/src/urma/common/ub_get_clock.c
+++ b/src/urma/common/ub_get_clock.c
@@ -131,6 +131,20 @@ static double proc_get_cpu_mhz(bool cpu_freq_warn)
 
 double get_cpu_mhz(bool cpu_freq_warn)
 {
+#if defined(__aarch64__)
+    /*
+     * get_cycles() reads CNTVCT_EL0 on AArch64, whose exact rate is exposed
+     * by CNTFRQ_EL0.  Reading it directly avoids the >200 ms wall-clock
+     * regression below.  That regression is particularly harmful inside a
+     * conservatively synchronized simulator because it creates millions of
+     * otherwise irrelevant synchronization barriers after the measurement.
+     */
+    uint64_t counter_hz;
+    asm volatile("mrs %0, cntfrq_el0" : "=r" (counter_hz));
+    if (counter_hz != 0) {
+        return (double)counter_hz / CLOCK_SEC_TO_USEC;
+    }
+#endif
     double sample, proc, delta;
     sample = gettime_get_cpu_mhz();
     proc = proc_get_cpu_mhz(cpu_freq_warn);
diff --git a/src/urma/tools/urma_perftest/CMakeLists.txt b/src/urma/tools/urma_perftest/CMakeLists.txt
index 60369ad..ae60707 100644
--- a/src/urma/tools/urma_perftest/CMakeLists.txt
+++ b/src/urma/tools/urma_perftest/CMakeLists.txt
@@ -19,6 +19,33 @@ target_link_libraries(urma_perftest
         urma pthread m
 )
 
+# OpenURMA's gem5-only build adds a runtime-selectable m5 pseudo-op transport.
+# Keeping the paths as cache variables leaves the upstream/physical build
+# unchanged when they are not supplied.
+set(OPENURMA_GEM5_M5_LIBRARY "" CACHE FILEPATH
+    "Optional gem5 libm5.a used by the OpenURMA simulation instrumentation")
+set(OPENURMA_GEM5_M5_INCLUDE_DIR "" CACHE PATH
+    "Optional directory containing gem5/m5ops.h")
+set(OPENURMA_GEM5_M5_MMAP_INCLUDE_DIR "" CACHE PATH
+    "Optional directory containing m5_mmap.h")
+set(OPENURMA_GEM5_M5_DISPATCH_INCLUDE_DIR "" CACHE PATH
+    "Optional directory containing ou-m5ops.h")
+
+if(OPENURMA_GEM5_M5_LIBRARY)
+    if(NOT OPENURMA_GEM5_M5_INCLUDE_DIR OR
+       NOT OPENURMA_GEM5_M5_MMAP_INCLUDE_DIR OR
+       NOT OPENURMA_GEM5_M5_DISPATCH_INCLUDE_DIR)
+        message(FATAL_ERROR
+            "All OpenURMA gem5 m5 include directories are required with libm5")
+    endif()
+    target_compile_definitions(urma_perftest PRIVATE OPENURMA_GEM5_M5OPS=1)
+    target_include_directories(urma_perftest PRIVATE
+        "${OPENURMA_GEM5_M5_INCLUDE_DIR}"
+        "${OPENURMA_GEM5_M5_MMAP_INCLUDE_DIR}"
+        "${OPENURMA_GEM5_M5_DISPATCH_INCLUDE_DIR}")
+    target_link_libraries(urma_perftest PRIVATE "${OPENURMA_GEM5_M5_LIBRARY}")
+endif()
+
 install(TARGETS urma_perftest
     DESTINATION /usr/bin
 )
