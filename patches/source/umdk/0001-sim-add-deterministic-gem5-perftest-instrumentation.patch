+/* Nearest-rank percentile, returned as a zero-based array index. */
+static uint64_t percentile_index(uint64_t count, double percentile)
+{
+    uint64_t rank = (uint64_t)ceil((double)count * percentile);
+    if (rank == 0) {
+        return 0;
+    }
+    return rank > count ? count - 1 : rank - 1;
+}
