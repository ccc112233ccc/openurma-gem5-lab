+#define OPENURMA_DIST_WARMUP_DELTAS (5)
+
+/*
+ * A distributed gem5 run must not let either event queue cross the peer
+ * channel's lookahead while latency traffic is in flight.  Keep process
+ * TCP control-plane setup and resource creation outside that very fine-grained
+ * barrier, then enter/leave it collectively around only the ping-pong loop.
+ * A short ON/OFF rendezvous before connecting first aligns both event queues,
+ * so launching the server earlier cannot turn host waiting time into a large
+ * virtual-time skew. The AArch64 build invokes gem5 in-process, avoiding a
+ * fork/exec while synchronization is active. Native gem5 CPUs use the magic
+ * instruction; KVM uses the runtime-selected m5ops MMIO address transport.
+ */
+static bool dist_sync_requested(void)
+{
+    const char *value = getenv("OPENURMA_DIST_SYNC");
+    return value != NULL && value[0] != '\0' && strcmp(value, "0") != 0;
+}
+
+static bool roi_stats_requested(void)
+{
+    const char *value = getenv("OPENURMA_ROI_STATS");
+    return value != NULL && value[0] != '\0' && strcmp(value, "0") != 0;
+}
+
+static bool cpu_switch_requested(void)
+{
+    const char *value = getenv("OPENURMA_CPU_SWITCH");
+    return value != NULL && strcmp(value, "server_o3") == 0;
+}
+
+static uint64_t latency_warmup_deltas(void)
+{
+    return dist_sync_requested() ? OPENURMA_DIST_WARMUP_DELTAS : 0;
+}
+
+static int toggle_dist_sync(const char *phase)
+{
+#if defined(__aarch64__)
+#if defined(OPENURMA_GEM5_M5OPS)
+    if (ou_m5ops_dist_toggle_sync() != 0) {
+        (void)fprintf(stderr,
+            "Failed to %s distributed virtual-time synchronization.\n", phase);
+        return -1;
+    }
+#else
+    /* gem5 arm64 m5_dist_toggle_sync pseudo instruction (op 0x62). */
+    __asm__ __volatile__(".inst 0xff620110" ::: "x0", "memory");
+#endif
+    (void)phase;
+    return 0;
+#else
+    int ret = system("/usr/bin/ou-dist-sync");
+    if (ret != 0) {
+        (void)fprintf(stderr, "Failed to %s distributed virtual-time synchronization, status:%d.\n",
+            phase, ret);
+        return -1;
+    }
+    return 0;
+#endif
+}
+
+int perftest_dist_time_rendezvous(const perftest_config_t *cfg)
+{
+    if (!dist_sync_requested()) {
+        return 0;
+    }
+    if (cfg->cmd != PERFTEST_SEND_LAT || cfg->time_type.bs.iterations != 1 ||
+        cfg->pair_num != 1 || cfg->jettys != 1) {
+        (void)fprintf(stderr,
+            "Distributed virtual-time synchronization currently supports only "
+            "iteration-mode send_lat with one pair and one jetty.\n");
+        return -1;
+    }
+
+    /*
+     * DistIface's first toggle performs an immediate collective control
+     * barrier and schedules both event queues at the same tick.  The second
+     * collective toggle is executed only after that common barrier releases,
+     * then disables periodic synchronization for the control-plane setup.
+     */
+    if (toggle_dist_sync("enable pre-test rendezvous") != 0) {
+        return -1;
+    }
+    if (toggle_dist_sync("disable pre-test rendezvous") != 0) {
+        return -1;
+    }
+    return 0;
+}
+
+/*
+ * Delimit the traffic loop in gem5's statistics stream.  The pseudo-op
+ * arguments are delay and period in x0/x1; both are zero so the operation is
+ * applied once at the current simulated time.  Keeping this outside the hot
+ * path means it cannot perturb any reported latency sample.
+ */
+static int gem5_roi_stats(bool reset)
+{
+#if defined(__aarch64__)
+#if defined(OPENURMA_GEM5_M5OPS)
+    return reset ? ou_m5ops_reset_stats() : ou_m5ops_dump_stats();
+#else
+    if (reset) {
+        __asm__ __volatile__(
+            "mov x0, xzr\n\t"
+            "mov x1, xzr\n\t"
+            ".inst 0xff400110"
+            ::: "x0", "x1", "memory");
+    } else {
+        __asm__ __volatile__(
+            "mov x0, xzr\n\t"
+            "mov x1, xzr\n\t"
+            ".inst 0xff410110"
+            ::: "x0", "x1", "memory");
+    }
+    return 0;
+#endif
+#else
+    (void)reset;
+    (void)fprintf(stderr, "OPENURMA_ROI_STATS requires the AArch64 gem5 guest build.\n");
+    return -1;
+#endif
+}
+
+/*
+ * Switch between the fast boot CPU and the server-style O3 ROI CPU.  The
+ * simulator handles the switchcpu exit event and resumes at the instruction
+ * following this pseudo-op.  Calling it a second time switches back.
+ */
+static int gem5_switch_roi_cpu(const char *phase)
+{
+#if defined(__aarch64__)
+#if defined(OPENURMA_GEM5_M5OPS)
+    if (ou_m5ops_switch_cpu() != 0) {
+        (void)fprintf(stderr, "Failed to switch gem5 CPU while trying to %s.\n", phase);
+        return -1;
+    }
+#else
+    /* gem5 arm64 m5_switch_cpu pseudo instruction (op 0x52). */
+    __asm__ __volatile__(".inst 0xff520110" ::: "memory");
+#endif
+    (void)phase;
+    return 0;
+#else
+    (void)fprintf(stderr,
+        "OPENURMA_CPU_SWITCH=server_o3 requires the AArch64 gem5 guest build (%s).\n", phase);
+    return -1;
+#endif
+}
+
+#define PERFTEST_NSEC_PER_USEC (1000.0)
+
+#if defined(OPENURMA_GEM5_M5OPS)
+typedef enum perftest_clock_mode {
+    PERFTEST_CLOCK_NATIVE = 0,
+    PERFTEST_CLOCK_GEM5_ADDR,
+} perftest_clock_mode_t;
+
+static perftest_clock_mode_t g_perftest_clock_mode = PERFTEST_CLOCK_NATIVE;
+#endif
+static bool g_perftest_clock_initialized;
+
+/*
+ * Address-mode m5ops are required by KVM, where userspace access to CNTVCT
+ * is not guaranteed and the architectural counter rate can differ after an
+ * O3 takeover.  Resolve the mode and map /dev/mem once before any timestamp
+ * is taken; the hot path then contains no environment lookup or mmap.
+ */
+int perftest_clock_init(void)
+{
+    if (g_perftest_clock_initialized) {
+        return 0;
+    }
+
+#if defined(OPENURMA_GEM5_M5OPS)
+    int address_mode = ou_m5ops_address_mode();
+    if (address_mode < 0) {
+        return -1;
+    }
+    if (address_mode != 0) {
+        if (ou_m5ops_prepare_address() != 0) {
+            return -1;
+        }
+        g_perftest_clock_mode = PERFTEST_CLOCK_GEM5_ADDR;
+        (void)fprintf(stderr,
+            "OpenURMA gem5 timing source: m5_rpns_addr (integer ns, 1000 ticks/us).\n");
+    }
+#endif
+
+    g_perftest_clock_initialized = true;
+    return 0;
+}
+
+static inline uint64_t perftest_get_time(void)
+{
+#if defined(OPENURMA_GEM5_M5OPS)
+    if (g_perftest_clock_mode == PERFTEST_CLOCK_GEM5_ADDR) {
+        return m5_rpns_addr();
+    }
+#endif
+    return get_cycles();
+}
+
+double perftest_time_units_per_usec(bool cpu_freq_warn)
+{
+#if defined(OPENURMA_GEM5_M5OPS)
+    if (g_perftest_clock_mode == PERFTEST_CLOCK_GEM5_ADDR) {
+        return PERFTEST_NSEC_PER_USEC;
+    }
+#endif
+    return get_cpu_mhz(cpu_freq_warn);
+}
 
