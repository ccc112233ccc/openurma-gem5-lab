+// An external timing fence runs DMA events while guest contexts are paused.
+// Remember wakeups until the fence commits, without changing ordinary guest
+// quiesce and interrupt handling outside that short interval.
+std::unordered_map<ThreadContext *, bool> externalActivationFences;
+
+} // anonymous namespace
+
+void
+blockExternalActivation(ThreadContext *context)
+{
+    assert(context);
+    const auto [position, inserted] =
+        externalActivationFences.emplace(context, false);
+    (void)position;
+    assert(inserted);
+}
+
+bool
+unblockExternalActivation(ThreadContext *context)
+{
+    const auto found = externalActivationFences.find(context);
+    assert(found != externalActivationFences.end());
+    const bool requested = found->second;
+    externalActivationFences.erase(found);
+    return requested;
+}
