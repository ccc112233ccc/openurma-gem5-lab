     _cqe_tap     ("_cqe_tap"),
@@ -4035,6 +4037,7 @@ NICTopologySC::peer_ring_drain(sc_core::sc_time &delay)
     if (!ring_) return;
     const gem5::Tick effective_now = checked_tick_sum(
         gem5::curTick(), delay.value());
+    const gem5::Tick effective_wire_now = adapter_wire_tick(effective_now);
     while (true) {
         uint32_t selected_port = ub_port_count_;
         uint64_t selected_tail = 0;
@@ -4049,7 +4052,7 @@ NICTopologySC::peer_ring_drain(sc_core::sc_time &delay)
                 continue;
             const auto *hdr = reinterpret_cast<const OuRingSlotHeader *>(
                 peer_ring_slot(rx_dir_, port, tail));
-            if (hdr->receive_tick > effective_now)
+            if (hdr->receive_tick > effective_wire_now)
                 continue;
             if (!selected_hdr || hdr->receive_tick < selected_hdr->receive_tick ||
                 (hdr->receive_tick == selected_hdr->receive_tick &&
@@ -4102,8 +4105,8 @@ NICTopologySC::peer_ring_drain(sc_core::sc_time &delay)
         ++peer_port_rx_packets_[selected_port];
         peer_port_rx_bytes_[selected_port] +=
             static_cast<uint64_t>(payload_bytes) + peer_link_overhead_bytes_;
-        peer_last_rx_arrival_ = std::max(peer_last_rx_arrival_,
-                                         hdr->receive_tick);
+        peer_last_rx_arrival_ = std::max(
+            peer_last_rx_arrival_, adapter_local_tick(hdr->receive_tick));
         if (ou_packet_trace_enabled()) {
