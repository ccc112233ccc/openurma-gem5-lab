                       << " src_port=" << hdr->source_port
@@ -4117,6 +4120,26 @@ NICTopologySC::peer_ring_drain(sc_core::sc_time &delay)
     }
 }
 
+gem5::Tick
+NICTopologySC::adapter_wire_tick(gem5::Tick local_tick) const
+{
+    if (peer_transport_ != "switch-adapter" || !peer_sync_local_active_)
+        return local_tick;
+    panic_if(local_tick < adapter_sync_tick_started_,
+             "adapter local tick %llu precedes phase epoch %llu",
+             (unsigned long long)local_tick,
+             (unsigned long long)adapter_sync_tick_started_);
+    return local_tick - adapter_sync_tick_started_;
+}
+
+gem5::Tick
+NICTopologySC::adapter_local_tick(gem5::Tick wire_tick) const
+{
+    if (peer_transport_ != "switch-adapter" || !peer_sync_local_active_)
+        return wire_tick;
+    return checked_tick_sum(adapter_sync_tick_started_, wire_tick);
+}
+
 bool
 NICTopologySC::peer_ring_tx_full()
 {
@@ -4145,10 +4168,10 @@ NICTopologySC::peer_ring_tx_available()
 }
 
 uint64_t
-NICTopologySC::adapterSyncStep()
+NICTopologySC::adapter_sync_step()
 {
     panic_if(peer_transport_ != "switch-adapter" || peer_node_id_ < 0,
-             "adapterSyncStep requires a cross-process switch adapter");
+             "adapter_sync_step requires a cross-process switch adapter");
     panic_if(peer_link_latency_ == 0,
              "adapter local synchronization requires positive lookahead");
     peer_ring_map();
@@ -4156,6 +4179,7 @@ NICTopologySC::adapterSyncStep()
     peer_ring_drain(delay);
 
     const gem5::Tick now = gem5::curTick();
+    const gem5::Tick wire_now = adapter_wire_tick(now);
     const uint64_t remote_phase = __atomic_load_n(
         &ring_->peer_sync_phase, __ATOMIC_ACQUIRE);
     if (remote_phase > peer_sync_phase_ && (remote_phase & 1) == 0) {
@@ -4168,7 +4192,7 @@ NICTopologySC::adapterSyncStep()
                   << " tick=" << now << "\n";
         return gem5::MaxTick;
     }
-    if (peer_last_sync_sent_ != now) {
+    if (peer_last_sync_sent_ != wire_now) {
         // Avoid publishing a partial multi-port promise: either every output
         // FIFO has room for this virtual-time horizon or none is modified.
         for (uint32_t port = 0; port < ub_port_count_; ++port) {
@@ -4189,9 +4213,9 @@ NICTopologySC::adapterSyncStep()
             std::memset(header, 0, sizeof(*header));
             header->type = static_cast<uint32_t>(
                 openurma_adapter::MessageType::Sync);
-            header->send_tick = now;
+            header->send_tick = wire_now;
             header->receive_tick = checked_tick_sum(
-                now, peer_link_latency_);
+                wire_now, peer_link_latency_);
             header->sequence = peer_tx_seq_++;
             header->source_port = port;
             header->destination_port = port;
@@ -4199,7 +4223,7 @@ NICTopologySC::adapterSyncStep()
             __atomic_store_n(&direction.head.value, head + 1,
                              __ATOMIC_RELEASE);
         }
-        peer_last_sync_sent_ = now;
+        peer_last_sync_sent_ = wire_now;
     }
 
     gem5::Tick next = gem5::MaxTick;
@@ -4216,13 +4240,48 @@ NICTopologySC::adapterSyncStep()
         panic_if(header->protocol_version != openurma_adapter::Version,
                  "adapter protocol version %u is unsupported",
                  header->protocol_version);
-        panic_if(header->receive_tick < now,
+        panic_if(header->receive_tick < wire_now,
                  "adapter delivered stale timestamp %llu below current %llu",
                  (unsigned long long)header->receive_tick,
-                 (unsigned long long)now);
+                 (unsigned long long)wire_now);
         next = std::min<gem5::Tick>(next, header->receive_tick);
     }
-    return next == gem5::MaxTick ? 0 : next;
+    return next == gem5::MaxTick ? 0 : adapter_local_tick(next);
+}
+
+void
+NICTopologySC::process_adapter_sync_event()
+{
+    // Follow the SimBricks gem5 adapter pattern: this callback is itself the
+    // conservative horizon in gem5's event queue. If the peer has not yet
+    // published a future timestamp, remain in C++ and poll the shared-memory
+    // FIFO instead of returning through Python and repeatedly re-entering
+    // m5.simulate(). Once a future promise exists, schedule this event at that
+    // exact tick; no ordinary gem5 event can run beyond it first.
+    while (peer_sync_local_active_) {
+        ++adapter_sync_steps_;
+        const gem5::Tick safe_tick = adapter_sync_step();
+        if (safe_tick == 0) {
+            ++adapter_sync_wait_polls_;
+            continue;
+        }
+        if (safe_tick == gem5::MaxTick) {
+            // The peer is frozen at its OFF pseudo instruction. Leave this
+            // event unscheduled so the local guest can run to the matching
+            // instruction; adapterSyncToggle(false) completes the handshake.
+            return;
+        }
+        if (safe_tick <= gem5::curTick()) {
+            // A promise for the tick currently being serviced is legal.  As
+            // in the SimBricks adapter, keep polling/consuming in C++ until
+            // the peer publishes a strictly future conservative horizon.
+            ++adapter_sync_wait_polls_;
+            continue;
+        }
+        ++adapter_sync_event_slices_;
+        gem5::curEventQueue()->schedule(&adapter_sync_event_, safe_tick);
+        return;
+    }
 }
 
 bool
@@ -4232,17 +4291,43 @@ NICTopologySC::adapterSyncToggle(bool active)
              "adapterSyncToggle requires a cross-process switch adapter");
     peer_ring_map();
     if (active != peer_sync_local_active_) {
+        if (adapter_sync_event_.scheduled())
+            gem5::curEventQueue()->deschedule(&adapter_sync_event_);
         ++peer_sync_phase_;
         panic_if(bool(peer_sync_phase_ & 1) != active,
                  "adapter synchronization phase parity is inconsistent");
         peer_sync_local_active_ = active;
         peer_last_sync_sent_ = gem5::MaxTick;
+        if (active) {
+            adapter_sync_steps_ = 0;
+            adapter_sync_wait_polls_ = 0;
+            adapter_sync_event_slices_ = 0;
+            adapter_sync_host_started_ = std::chrono::steady_clock::now();
+            adapter_sync_tick_started_ = gem5::curTick();
+        }
         __atomic_store_n(&ring_->local_sync_phase, peer_sync_phase_,
                          __ATOMIC_RELEASE);
     }
     const uint64_t remote_phase = __atomic_load_n(
         &ring_->peer_sync_phase, __ATOMIC_ACQUIRE);
     if (remote_phase >= peer_sync_phase_) {
+        if (active && !adapter_sync_event_.scheduled()) {
+            gem5::curEventQueue()->schedule(
+                &adapter_sync_event_, gem5::curTick());
+        } else if (!active) {
+            const double host_seconds =
+                std::chrono::duration<double>(
+                    std::chrono::steady_clock::now() -
+                    adapter_sync_host_started_).count();
+            std::cerr << "[NIC adapter-sync-profile] host_seconds="
+                      << host_seconds
+                      << " virtual_ticks="
+                      << (gem5::curTick() - adapter_sync_tick_started_)
+                      << " steps=" << adapter_sync_steps_
+                      << " wait_polls=" << adapter_sync_wait_polls_
+                      << " event_slices=" << adapter_sync_event_slices_
+                      << "\n";
+        }
         std::cerr << "[NIC adapter-sync] toggle active=" << active
                   << " local_phase=" << peer_sync_phase_
                   << " remote_phase=" << remote_phase
@@ -4401,8 +4486,8 @@ NICTopologySC::peer_send(uint8_t op, uint32_t dcna, uint32_t rtoken,
         std::memset(hdr, 0, sizeof(*hdr));
         hdr->payload_length = plen;
         hdr->type = OU_RING_DATA;
-        hdr->send_tick = tx_tick;
-        hdr->receive_tick = arrival_tick;
+        hdr->send_tick = adapter_wire_tick(tx_tick);
+        hdr->receive_tick = adapter_wire_tick(arrival_tick);
         hdr->sequence = peer_tx_seq_++;
         hdr->source_port = src_port;
         hdr->destination_port = dst_port;
