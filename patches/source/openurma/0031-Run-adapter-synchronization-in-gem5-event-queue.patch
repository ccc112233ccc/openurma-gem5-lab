@@ -244,12 +255,9 @@ class NICTopologySC : public sc_core::sc_module
     uint64_t dmaPendingRequests() const;
     bool dmaBeginRoi();
     bool dmaIdle();
-    // Called between m5.simulate() slices by the SimBricks-style local
-    // synchronization loop. It drains messages legal at curTick(), publishes
-    // one null-message promise per physical link, and returns the earliest
-    // inbound timestamp that bounds the next safe simulation slice. Zero
-    // means the switch has not published a bound on every link yet.
-    uint64_t adapterSyncStep();
+    // The guest toggle enters/leaves a C++ event-queue adapter. Python handles
+    // only this infrequent collective boundary; DATA/SYNC polling and virtual
+    // time progression stay inside gem5's event queue.
     bool adapterSyncToggle(bool active);
 
