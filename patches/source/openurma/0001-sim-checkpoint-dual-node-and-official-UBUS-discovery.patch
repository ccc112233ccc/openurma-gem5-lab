+template <class T>
+void
+ouStoreLe(std::vector<uint8_t> &bytes, size_t offset, T value)
+{
+    for (size_t i = 0; i < sizeof(T); ++i)
+        bytes.at(offset + i) = static_cast<uint8_t>(value >> (8 * i));
