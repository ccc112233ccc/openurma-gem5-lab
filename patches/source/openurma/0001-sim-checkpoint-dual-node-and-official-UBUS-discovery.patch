+	while (pins->count) {
+		range = &pins->ranges[--pins->count];
+		if (make_dirty && range->writable)
+			unpin_user_pages_dirty_lock(range->pages,
+						    range->page_count, true);
+		else
+			unpin_user_pages(range->pages, range->page_count);
+		kvfree(range->pages);
+		memset(range, 0, sizeof(*range));
