+uint32_t
+NICTopologySC::modeled_wqebbs(const FrontendDescriptor &desc,
+                              uint32_t payload_bytes) const
+{
+    // With control_bytes=0 the provider's opcode-aware physical result is the
+    // authoritative compatibility value (important for atomic/special WQEs).
+    if (sq_control_bytes_ == 0) {
+        return desc.schema_valid ? desc.provider_wqebbs : 1;
+    }
+    if (wqebb_bytes_ == 0)
+        return desc.schema_valid ? desc.provider_wqebbs : 1;
