+/* Pin one complete userspace interval for simulated device DMA.  The page
+ * array is retained by the owning resource so its backing pages cannot be
+ * reclaimed.  Phase 1 still relies on the normal URMA lifetime rule that the
+ * application leaves the registered VA mapping intact until destroy. */
+static int ou_pin_user_range(struct openurma_pinned_range *range,
+			     u64 addr, u64 len, bool writable)
+{
+	unsigned long first_page, last_page, page_count;
+	unsigned long pinned_count = 0;
+	unsigned int gup_flags = FOLL_LONGTERM;
+	u64 last_addr;
+	int ret = 0;
+
+	if (!len)
+		return -EINVAL;
+	if (check_add_overflow(addr, len - 1, &last_addr) ||
+	    addr > ULONG_MAX || last_addr > ULONG_MAX)
+		return -EOVERFLOW;
+
+	first_page = (unsigned long)addr & PAGE_MASK;
+	last_page = (unsigned long)last_addr & PAGE_MASK;
+	page_count = ((last_page - first_page) >> PAGE_SHIFT) + 1;
+	if (!page_count || page_count > UINT_MAX ||
+	    page_count > SIZE_MAX / sizeof(*range->pages))
+		return -EOVERFLOW;
+
+	range->pages = kvmalloc_array(page_count, sizeof(*range->pages),
+				      GFP_KERNEL);
+	if (!range->pages)
+		return -ENOMEM;
+	if (writable)
+		gup_flags |= FOLL_WRITE;
+
+	/* oe66's pin_user_pages() expects an externally held mmap_lock.  Its
+	 * fast variant performs the lockless walk and slow faulting fallback
+	 * internally; bounded chunks mirror the official UDMA driver. */
+	while (pinned_count < page_count) {
+		unsigned long remaining = page_count - pinned_count;
+		int chunk = min_t(unsigned long, remaining,
+				  PAGE_SIZE / sizeof(struct page *));
+		int pinned;
+
+		pinned = pin_user_pages_fast(first_page +
+					     pinned_count * PAGE_SIZE,
+					     chunk, gup_flags,
+					     range->pages + pinned_count);
+		if (pinned <= 0) {
+			ret = pinned < 0 ? pinned : -EFAULT;
+			goto err_unpin;
+		}
+		pinned_count += (unsigned int)pinned;
+		cond_resched();
+	}
+
+	range->page_start = first_page;
+	range->page_count = page_count;
+	range->writable = writable;
+	return 0;
+
+err_unpin:
+	if (pinned_count)
+		unpin_user_pages(range->pages, pinned_count);
+	kvfree(range->pages);
+	range->pages = NULL;
+	return ret;
+}
