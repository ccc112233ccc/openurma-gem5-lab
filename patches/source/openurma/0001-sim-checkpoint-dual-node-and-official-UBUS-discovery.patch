+	if (pins->count >= ARRAY_SIZE(pins->ranges))
+		return -E2BIG;
+	ret = ou_pin_user_range(&pins->ranges[pins->count], addr, len,
+				writable);
+	if (!ret)
+		pins->count++;
+	return ret;
