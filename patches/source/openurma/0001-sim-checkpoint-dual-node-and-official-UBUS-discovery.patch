+# SPDX-License-Identifier: MIT
+
+cmake_minimum_required(VERSION 3.16)
+project(openurma_ummu_sim_shim VERSION 1.0.0 LANGUAGES C)
+
+set(UMMU_API_INCLUDE_DIR "" CACHE PATH "Directory containing the official ummu_api.h")
+set(UMMU_UAPI_INCLUDE_DIR "" CACHE PATH "Directory containing the official ummu_core.h")
+
+if(NOT EXISTS "${UMMU_API_INCLUDE_DIR}/ummu_api.h")
+    message(FATAL_ERROR
+        "UMMU_API_INCLUDE_DIR must name the directory containing official ummu_api.h")
+endif()
+if(NOT EXISTS "${UMMU_UAPI_INCLUDE_DIR}/ummu_core.h")
+    message(FATAL_ERROR
+        "UMMU_UAPI_INCLUDE_DIR must name the directory containing official ummu_core.h")
+endif()
+
+find_package(Threads REQUIRED)
+
+add_library(ummu_sim SHARED ummu_sim_shim.c)
+target_include_directories(ummu_sim PRIVATE
+    "${UMMU_API_INCLUDE_DIR}"
+    "${UMMU_UAPI_INCLUDE_DIR}")
+target_compile_features(ummu_sim PRIVATE c_std_11)
+target_compile_options(ummu_sim PRIVATE
+    -Wall -Wextra -Werror -Wshadow -Wconversion
+    -fstack-protector-strong)
+target_link_libraries(ummu_sim PRIVATE Threads::Threads)
+target_link_options(ummu_sim PRIVATE
+    -Wl,-z,defs
+    -Wl,-z,relro
+    -Wl,-z,now)
+set_target_properties(ummu_sim PROPERTIES
+    OUTPUT_NAME ummu
+    VERSION "${PROJECT_VERSION}"
+    SOVERSION 1)
+
+include(CTest)
+if(BUILD_TESTING)
+    add_executable(ummu_sim_selftest selftest.c)
+    target_include_directories(ummu_sim_selftest PRIVATE
+        "${UMMU_API_INCLUDE_DIR}"
+        "${UMMU_UAPI_INCLUDE_DIR}")
+    target_compile_features(ummu_sim_selftest PRIVATE c_std_11)
+    target_compile_options(ummu_sim_selftest PRIVATE
+        -Wall -Wextra -Werror -Wshadow -Wconversion)
+    target_link_libraries(ummu_sim_selftest PRIVATE ummu_sim Threads::Threads)
+    add_test(NAME ummu_sim_selftest COMMAND ummu_sim_selftest)
+endif()
diff --git a/integration/umdk/ummu_shim/README.md b/integration/umdk/ummu_shim/README.md
new file mode 100644
index 0000000..b7a850d
--- /dev/null
+++ b/integration/umdk/ummu_shim/README.md
@@ -0,0 +1,37 @@
+# Simulation-only UMMU ABI shim
+
+This directory provides a small `libummu.so.1` for compiling and exercising
+the stock UMDK UDMA userspace provider in the OpenURMA gem5 guest.  It uses the
+official `ummu_api.h` and `ummu_core.h`; no copy of those ABI headers is kept
+here.
+
+The shim allocates process-local raw TIDs and records grants under a mutex.  It
+does **not** open `/dev/ummu/tid`, pin pages, program permission tables, perform
+invalidation, or enforce UMMU/SVA isolation.  TIDs are unique between threads
+in one process, not between independent processes.  This library is therefore
+only a bootstrap for a simulation backend and must not be used as a security
+or hardware-fidelity implementation.
+
+The normal ARM64 container build is:
+
+```sh
+BUILD_STOCK_UDMA=enable /workspace/openurma-gem5-lab/build_umdk.sh
+```
+
+If the pinned UMDK checkout contains unrelated local experiments, opt in with
+`ALLOW_DIRTY_UMDK=enable`.  The build script still refuses any tracked or
+untracked change below `src/urma/hw/udma`, so the resulting provider remains
+the stock implementation.
+
+That command obtains the ABI headers from
+`/workspace/openurma-gem5-lab/deps/ummu`, builds and tests this shim, then
+builds the unmodified stock UDMA provider.  To test only the shim:
+
+```sh
+cmake -S /workspace/OpenURMA/integration/umdk/ummu_shim \
+  -B /tmp/openurma-ummu-shim-build \
+  -DUMMU_API_INCLUDE_DIR=/workspace/openurma-gem5-lab/deps/ummu/include \
+  -DUMMU_UAPI_INCLUDE_DIR=/workspace/openurma-gem5-lab/deps/ummu/kernel_headers
+cmake --build /tmp/openurma-ummu-shim-build --parallel 2
+ctest --test-dir /tmp/openurma-ummu-shim-build --output-on-failure
+```
diff --git a/integration/umdk/ummu_shim/selftest.c b/integration/umdk/ummu_shim/selftest.c
new file mode 100644
index 0000000..f832e59
--- /dev/null
+++ b/integration/umdk/ummu_shim/selftest.c
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: MIT
+
+#define _POSIX_C_SOURCE 200112L
+
+#include <ummu_api.h>
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define THREAD_COUNT 8U
+#define TIDS_PER_THREAD 64U
+#define TEST_PAGE_SIZE 4096U
+
+struct thread_result {
+    uint32_t tids[TIDS_PER_THREAD];
+    int error;
+};
+
+static void *allocate_tids(void *opaque)
+{
+    struct thread_result *result = opaque;
+    struct ummu_tid_attr attr = {.mode = MAPT_MODE_TABLE};
+    unsigned int index;
+
+    for (index = 0U; index < TIDS_PER_THREAD; ++index) {
+        result->error = ummu_allocate_tid(&attr, &result->tids[index]);
+        if (result->error != 0)
+            break;
+    }
+    return NULL;
+}
+
+static int expect_error(int actual, int expected, const char *operation)
+{
+    if (actual == expected)
+        return 0;
+    fprintf(stderr, "%s returned %d, expected %d\n", operation, actual, expected);
+    return 1;
+}
+
+int main(void)
+{
+    struct thread_result results[THREAD_COUNT] = {0};
+    pthread_t threads[THREAD_COUNT];
+    struct ummu_tid_attr table_attr = {.mode = MAPT_MODE_TABLE};
+    struct ummu_token_info token = {.input = 0U, .tokenVal = 0x12345678U};
+    struct ummu_seg_attr seg_attr = {.token = &token, .e_bit = UMMU_EBIT_OFF};
+    void *page = NULL;
+    uint32_t tid;
+    unsigned int thread_index;
+    unsigned int tid_index;
+    int ret;
+
+    ret = posix_memalign(&page, TEST_PAGE_SIZE, TEST_PAGE_SIZE * 2U);
+    if (ret != 0) {
+        fprintf(stderr, "posix_memalign failed: %d\n", ret);
+        return 1;
+    }
+
+    if (expect_error(ummu_allocate_tid(&table_attr, &tid), 0, "allocate") ||
+        expect_error(ummu_grant(tid, page, TEST_PAGE_SIZE, MAPT_PERM_RW, &seg_attr),
+                     0, "grant") ||
+        expect_error(ummu_grant(tid, (char *)page + 64, TEST_PAGE_SIZE,
+                                MAPT_PERM_RW, &seg_attr),
+                     -EINVAL, "overlapping grant") ||
+        expect_error(ummu_ungrant(tid, page, TEST_PAGE_SIZE / 2U),
+                     -EINVAL, "mismatched ungrant") ||
+        expect_error(ummu_ungrant(tid, page, TEST_PAGE_SIZE), 0, "ungrant") ||
+        expect_error(ummu_ungrant(tid, page, TEST_PAGE_SIZE),
+                     -EINVAL, "duplicate ungrant") ||
+        expect_error(ummu_free_tid(tid), 0, "free") ||
+        expect_error(ummu_free_tid(tid), -EINVAL, "duplicate free")) {
+        free(page);
+        return 1;
+    }
+
+    token.tokenVal = 0x11111111U;
+    if (expect_error(ummu_allocate_tid(&table_attr, &tid), 0, "token allocate") ||
+        expect_error(ummu_grant(tid, page, TEST_PAGE_SIZE, MAPT_PERM_RW, &seg_attr),
+                     0, "first token grant")) {
+        free(page);
+        return 1;
+    }
+    token.tokenVal = 0x22222222U;
+    if (expect_error(ummu_grant(tid, page, TEST_PAGE_SIZE, MAPT_PERM_RW, &seg_attr),
+                     0, "second token grant") ||
+        expect_error(ummu_ungrant_by_token(tid, page, TEST_PAGE_SIZE, 0x11111111U),
+                     0, "first token ungrant") ||
+        expect_error(ummu_ungrant(tid, page, TEST_PAGE_SIZE),
+                     0, "remaining token ungrant") ||
+        expect_error(ummu_free_tid(tid), 0, "token free")) {
+        free(page);
+        return 1;
+    }
+
+    if (expect_error(ummu_allocate_tid(&table_attr, &tid), 0, "cleanup allocate") ||
+        expect_error(ummu_grant(tid, page, TEST_PAGE_SIZE, MAPT_PERM_R, &seg_attr),
+                     0, "cleanup grant") ||
+        expect_error(ummu_free_tid(tid), 0, "free with active grant") ||
+        expect_error(ummu_ungrant(tid, page, TEST_PAGE_SIZE),
+                     -EINVAL, "ungrant after free")) {
+        free(page);
+        return 1;
+    }
+
+    for (thread_index = 0U; thread_index < THREAD_COUNT; ++thread_index) {
+        ret = pthread_create(&threads[thread_index], NULL, allocate_tids,
+                             &results[thread_index]);
+        if (ret != 0) {
+            fprintf(stderr, "pthread_create failed: %d\n", ret);
+            free(page);
+            return 1;
+        }
+    }
+    for (thread_index = 0U; thread_index < THREAD_COUNT; ++thread_index)
+        (void)pthread_join(threads[thread_index], NULL);
+
+    for (thread_index = 0U; thread_index < THREAD_COUNT; ++thread_index) {
+        if (results[thread_index].error != 0) {
+            fprintf(stderr, "thread allocation failed: %d\n", results[thread_index].error);
+            free(page);
+            return 1;
+        }
+        for (tid_index = 0U; tid_index < TIDS_PER_THREAD; ++tid_index) {
+            unsigned int other_thread;
+            unsigned int other_tid;
+
+            for (other_thread = 0U; other_thread <= thread_index; ++other_thread) {
+                unsigned int limit = other_thread == thread_index ? tid_index : TIDS_PER_THREAD;
+
+                for (other_tid = 0U; other_tid < limit; ++other_tid) {
+                    if (results[thread_index].tids[tid_index] ==
+                        results[other_thread].tids[other_tid]) {
+                        fprintf(stderr, "duplicate TID %u\n",
+                                results[thread_index].tids[tid_index]);
+                        free(page);
+                        return 1;
+                    }
+                }
+            }
+        }
+    }
+
+    for (thread_index = 0U; thread_index < THREAD_COUNT; ++thread_index) {
+        for (tid_index = 0U; tid_index < TIDS_PER_THREAD; ++tid_index) {
+            ret = ummu_free_tid(results[thread_index].tids[tid_index]);
+            if (ret != 0) {
+                fprintf(stderr, "thread TID free failed: %d\n", ret);
+                free(page);
+                return 1;
+            }
+        }
+    }
+
+    free(page);
+    puts("ummu simulation shim self-test passed");
+    return 0;
+}
