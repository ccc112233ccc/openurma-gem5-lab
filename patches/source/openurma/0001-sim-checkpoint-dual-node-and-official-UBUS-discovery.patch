+bool
+ouReadFirmwareTable(uint64_t base, uint64_t off, uint8_t *data, size_t len)
+{
+    std::vector<uint8_t> table;
+    uint64_t table_offset = 0;
+    if (off >= OuUbiosRootOffset && off < OuUbiosRootOffset + 48) {
+        table = ouBuildUbiosRoot(base);
+        table_offset = OuUbiosRootOffset;
+    } else if (off >= OuUbiosUbcOffset && off < OuUbiosUbcOffset + 440) {
+        table = ouBuildUbiosUbc(base);
+        table_offset = OuUbiosUbcOffset;
+    } else {
