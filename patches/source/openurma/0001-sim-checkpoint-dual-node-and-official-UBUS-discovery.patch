+std::vector<uint8_t>
+ouBuildUbiosUbc(uint64_t base)
+{
+    // Linux's struct ubrt_ubc_table header is 56 bytes and ubc_node is
+    // 384 bytes. Keep this byte-level ABI separate from compiler packing.
+    std::vector<uint8_t> table(56 + 384, 0);
+    const char name[] = "ubc";
+    std::memcpy(table.data(), name, sizeof(name) - 1);
+    ouStoreLe<uint32_t>(table, 16, table.size());
+    table[20] = 1;
+    ouStoreLe<uint32_t>(table, 32, 1);       // CNA range
+    ouStoreLe<uint32_t>(table, 36, 0xffff);
+    ouStoreLe<uint32_t>(table, 40, 1);       // EID range
+    ouStoreLe<uint32_t>(table, 44, 0xffff);
+    ouStoreLe<uint16_t>(table, 52, 0);       // standalone enumeration
+    ouStoreLe<uint16_t>(table, 54, 1);       // one controller
+
+    const size_t node = 56;
+    ouStoreLe<uint32_t>(table, node + 0, 160);
+    ouStoreLe<uint32_t>(table, node + 4, 255);
+    ouStoreLe<uint64_t>(table, node + 8, base + OuUbiosHpaOffset);
+    ouStoreLe<uint64_t>(table, node + 16, OuUbiosHpaSize);
+    table[node + 24] = 48;                   // addressable width
+    table[node + 25] = 1;                    // coherent DMA
+    ouStoreLe<uint16_t>(table, node + 26, 0xffff); // no UMMU table yet
+    ouStoreLe<uint16_t>(table, node + 28, 0);
+    ouStoreLe<uint64_t>(table, node + 32, base + OuUbiosMsgqOffset);
+    ouStoreLe<uint64_t>(table, node + 40, 0x1000);
+    ouStoreLe<uint16_t>(table, node + 48, 64);
+    ouStoreLe<uint16_t>(table, node + 50, 101);
+    ouStoreLe<uint64_t>(table, node + 112, 1);
