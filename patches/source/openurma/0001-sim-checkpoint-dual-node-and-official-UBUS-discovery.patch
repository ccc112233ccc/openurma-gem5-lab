+/* Reserve a stable protocol-visible ID.  Requested non-zero JFR/Jetty IDs are
+ * honored exactly; automatic IDs are monotonic and collision checked. */
+static int ou_reserve_id(struct xarray *xa, atomic_t *seq, u32 requested,
+			 u32 max_id, void *entry, u32 *id)
+{
+	u32 candidate;
+	int ret;
+	unsigned int tries;
+
+	if (requested) {
+		if (requested > max_id)
+			return -EINVAL;
+		ret = xa_insert(xa, requested, entry, GFP_KERNEL);
+		if (!ret)
+			*id = requested;
+		return ret;
+	}
+
+	for (tries = 0; tries < max_id; tries++) {
+		candidate = (u32)atomic_inc_return(seq) & max_id;
+		if (!candidate)
+			continue;
+		ret = xa_insert(xa, candidate, entry, GFP_KERNEL);
+		if (!ret) {
+			*id = candidate;
+			return 0;
+		}
+		if (ret != -EBUSY)
+			return ret;
+	}
+	return -ENOSPC;
+}
+
+static int ou_alloc_aper_page(struct openurma_dev *od,
+			      struct openurma_ucontext *ctx,
+			      u32 *page_offset)
+{
+	unsigned long irq_flags;
+	u32 page;
+
+	spin_lock_irqsave(&od->aper_page_lock, irq_flags);
+	for (page = OPENURMA_FIRST_DYNAMIC_PAGE; page < OPENURMA_CTRL_PAGE; page++) {
+		if (!test_bit(page, &od->aper_page_map)) {
+			__set_bit(page, &od->aper_page_map);
+			__set_bit(page, &ctx->aper_pages);
+			spin_unlock_irqrestore(&od->aper_page_lock, irq_flags);
+			*page_offset = page * OPENURMA_HW_PAGE_SZ;
+			return 0;
+		}
+	}
+	spin_unlock_irqrestore(&od->aper_page_lock, irq_flags);
+	return -ENOSPC;
+}
