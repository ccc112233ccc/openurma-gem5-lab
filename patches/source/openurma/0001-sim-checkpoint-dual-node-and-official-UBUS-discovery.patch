@@ -0,0 +1,334 @@
+// SPDX-License-Identifier: MIT
+/*
+ * Process-local UMMU ABI shim for OpenURMA full-system simulation.
+ *
+ * This implements the public libummu entry points needed by the stock UDMA
+ * provider.  It deliberately models only allocation and grant bookkeeping;
+ * it does not pin pages or provide UMMU protection/isolation.
+ */
+
+#include <ummu_api.h>
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+#define UMMU_SIM_MIN_TID 1U
+#define UMMU_SIM_MAX_TID 0xfffffU
+
+struct ummu_sim_grant {
+    uintptr_t base;
+    size_t size;
+    enum ummu_mapt_perm perm;
+    enum ummu_ebit_state e_bit;
+    uint32_t tokens[2];
+    unsigned int token_count;
+    struct ummu_sim_grant *next;
+};
+
+struct ummu_sim_tid {
+    uint32_t id;
+    enum ummu_mapt_mode mode;
+    struct ummu_sim_grant *grants;
+    struct ummu_sim_tid *next;
+};
+
+static pthread_mutex_t g_state_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct ummu_sim_tid *g_tids;
+static uint32_t g_next_tid = UMMU_SIM_MIN_TID;
+static uint32_t g_next_token = 1U;
+
+static int lock_state(void)
+{
+    int ret = pthread_mutex_lock(&g_state_lock);
+
+    return ret == 0 ? 0 : -ret;
+}
+
+static struct ummu_sim_tid *find_tid(uint32_t tid)
+{
+    struct ummu_sim_tid *entry;
+
+    for (entry = g_tids; entry != NULL; entry = entry->next) {
+        if (entry->id == tid)
+            return entry;
+    }
+    return NULL;
+}
+
+static bool valid_mode(enum ummu_mapt_mode mode)
+{
+    return mode == MAPT_MODE_TABLE || mode == MAPT_MODE_ENTRY;
+}
+
+static bool valid_perm(enum ummu_mapt_perm perm)
+{
+    switch (perm) {
+    case MAPT_PERM_W:
+    case MAPT_PERM_R:
+    case MAPT_PERM_RW:
+    case MAPT_PERM_ATOMIC_W:
+    case MAPT_PERM_ATOMIC_R:
+    case MAPT_PERM_ATOMIC_RW:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool valid_range(void *data, size_t size)
+{
+    uintptr_t base = (uintptr_t)data;
+
+    return data != NULL && size != 0U && base <= UINTPTR_MAX - (size - 1U);
+}
+
+static bool ranges_overlap(uintptr_t lhs_base, size_t lhs_size,
+                           uintptr_t rhs_base, size_t rhs_size)
+{
+    uintptr_t lhs_last = lhs_base + lhs_size - 1U;
+    uintptr_t rhs_last = rhs_base + rhs_size - 1U;
+
+    return lhs_base <= rhs_last && rhs_base <= lhs_last;
+}
+
+static uint32_t allocate_token(void)
+{
+    uint32_t token = g_next_token++;
+
+    if (g_next_token == 0U)
+        g_next_token = 1U;
+    return token;
+}
+
+static void free_grants(struct ummu_sim_grant *grant)
+{
+    while (grant != NULL) {
+        struct ummu_sim_grant *next = grant->next;
+
+        free(grant);
+        grant = next;
+    }
+}
+
+int ummu_allocate_tid(struct ummu_tid_attr *tid_attr, uint32_t *tid)
+{
+    struct ummu_sim_tid *entry;
+    uint32_t candidate;
+    uint32_t attempts;
+    int ret;
+
+    if (tid_attr == NULL || tid == NULL || !valid_mode(tid_attr->mode))
+        return -EINVAL;
+
+    entry = calloc(1U, sizeof(*entry));
+    if (entry == NULL)
+        return -ENOMEM;
+
+    ret = lock_state();
+    if (ret != 0) {
+        free(entry);
+        return ret;
+    }
+
+    candidate = g_next_tid;
+    for (attempts = 0U; attempts < UMMU_SIM_MAX_TID; ++attempts) {
+        if (find_tid(candidate) == NULL)
+            break;
+        candidate = candidate == UMMU_SIM_MAX_TID ? UMMU_SIM_MIN_TID : candidate + 1U;
+    }
+    if (attempts == UMMU_SIM_MAX_TID) {
+        (void)pthread_mutex_unlock(&g_state_lock);
+        free(entry);
+        return -ENOSPC;
+    }
+
+    entry->id = candidate;
+    entry->mode = tid_attr->mode;
+    entry->next = g_tids;
+    g_tids = entry;
+    g_next_tid = candidate == UMMU_SIM_MAX_TID ? UMMU_SIM_MIN_TID : candidate + 1U;
+    *tid = candidate;
+    (void)pthread_mutex_unlock(&g_state_lock);
+    return 0;
+}
+
+int ummu_grant(uint32_t tid, void *data, size_t data_size,
+               enum ummu_mapt_perm perm, struct ummu_seg_attr *seg_attr)
+{
+    struct ummu_sim_grant *new_grant;
+    struct ummu_sim_grant *grant;
+    struct ummu_sim_tid *tid_entry;
+    uintptr_t base = (uintptr_t)data;
+    bool has_token;
+    uint32_t token = 0U;
+    int ret;
+
+    if (!valid_range(data, data_size) || !valid_perm(perm) || seg_attr == NULL ||
+        (seg_attr->e_bit != UMMU_EBIT_OFF && seg_attr->e_bit != UMMU_EBIT_ON))
+        return -EINVAL;
+    has_token = seg_attr->token != NULL;
+    if (has_token && seg_attr->token->input > 1U)
+        return -EINVAL;
+
+    new_grant = calloc(1U, sizeof(*new_grant));
+    if (new_grant == NULL)
+        return -ENOMEM;
+
+    ret = lock_state();
+    if (ret != 0) {
+        free(new_grant);
+        return ret;
+    }
+    tid_entry = find_tid(tid);
+    if (tid_entry == NULL) {
+        ret = -EINVAL;
+        goto out;
+    }
+
+    if (has_token) {
+        token = seg_attr->token->input == 0U ? seg_attr->token->tokenVal : allocate_token();
+    }
+
+    for (grant = tid_entry->grants; grant != NULL; grant = grant->next) {
+        bool exact = grant->base == base && grant->size == data_size;
+
+        if (!ranges_overlap(grant->base, grant->size, base, data_size))
+            continue;
+        if (exact && has_token && grant->token_count == 1U &&
+            grant->perm == perm && grant->e_bit == seg_attr->e_bit) {
+            grant->tokens[1] = token;
+            grant->token_count = 2U;
+            if (seg_attr->token->input == 1U)
+                seg_attr->token->tokenVal = token;
+            ret = 0;
+            goto out;
+        }
+        ret = -EINVAL;
+        goto out;
+    }
+
+    if (tid_entry->mode == MAPT_MODE_ENTRY && tid_entry->grants != NULL) {
+        ret = -EINVAL;
+        goto out;
+    }
+
+    new_grant->base = base;
+    new_grant->size = data_size;
+    new_grant->perm = perm;
+    new_grant->e_bit = seg_attr->e_bit;
+    if (has_token) {
+        new_grant->tokens[0] = token;
+        new_grant->token_count = 1U;
+        if (seg_attr->token->input == 1U)
+            seg_attr->token->tokenVal = token;
+    }
+    new_grant->next = tid_entry->grants;
+    tid_entry->grants = new_grant;
+    new_grant = NULL;
+    ret = 0;
+
+out:
+    (void)pthread_mutex_unlock(&g_state_lock);
+    free(new_grant);
+    return ret;
+}
+
+static int ungrant_common(uint32_t tid, void *data, size_t size,
+                          bool by_token, uint32_t token)
+{
+    struct ummu_sim_grant **grant_link;
+    struct ummu_sim_grant *grant;
+    struct ummu_sim_tid *tid_entry;
+    uintptr_t base = (uintptr_t)data;
+    int ret;
+
+    if (!valid_range(data, size))
+        return -EINVAL;
+
+    ret = lock_state();
+    if (ret != 0)
+        return ret;
+    tid_entry = find_tid(tid);
+    if (tid_entry == NULL) {
+        ret = -EINVAL;
+        goto out;
+    }
+
+    grant_link = &tid_entry->grants;
+    while (*grant_link != NULL) {
+        grant = *grant_link;
+        if (grant->base != base || grant->size != size) {
+            grant_link = &grant->next;
+            continue;
+        }
+
+        if (by_token) {
+            unsigned int index;
+
+            for (index = 0U; index < grant->token_count; ++index) {
+                if (grant->tokens[index] == token)
+                    break;
+            }
+            if (index == grant->token_count) {
+                ret = -EINVAL;
+                goto out;
+            }
+            if (grant->token_count == 2U) {
+                grant->tokens[index] = grant->tokens[1U - index];
+                grant->tokens[1] = 0U;
+                grant->token_count = 1U;
+                ret = 0;
+                goto out;
+            }
+        }
+
+        *grant_link = grant->next;
+        free(grant);
+        ret = 0;
+        goto out;
+    }
+    ret = -EINVAL;
+
+out:
+    (void)pthread_mutex_unlock(&g_state_lock);
+    return ret;
+}
+
+int ummu_ungrant(uint32_t tid, void *data, size_t size)
+{
+    return ungrant_common(tid, data, size, false, 0U);
+}
+
+int ummu_ungrant_by_token(uint32_t tid, void *data, size_t size, uint32_t token_val)
+{
+    return ungrant_common(tid, data, size, true, token_val);
+}
+
+int ummu_free_tid(uint32_t tid)
+{
+    struct ummu_sim_tid **entry_link;
+    struct ummu_sim_tid *entry;
+    int ret;
+
+    ret = lock_state();
+    if (ret != 0)
+        return ret;
+
+    entry_link = &g_tids;
+    while (*entry_link != NULL && (*entry_link)->id != tid)
+        entry_link = &(*entry_link)->next;
+    if (*entry_link == NULL) {
+        (void)pthread_mutex_unlock(&g_state_lock);
+        return -EINVAL;
+    }
+
+    entry = *entry_link;
+    *entry_link = entry->next;
+    (void)pthread_mutex_unlock(&g_state_lock);
+    free_grants(entry->grants);
+    free(entry);
+    return 0;
+}
