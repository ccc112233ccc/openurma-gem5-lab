+NICTopologySC::NICTopologySC(sc_core::sc_module_name nm)
+  : sc_core::sc_module(nm),
+    mmio_socket("mmio_socket"),
+    dma_out("dma_out"),
+    wire_rx_in("wire_rx_in"),
+    wire_tx_out("wire_tx_out"),
+    peer_rx_in("peer_rx_in"),
+    peer_tx_out("peer_tx_out"),
+    mmio_wrapper   (mmio_socket,   std::string(name()) + ".mmio_socket",
+                    gem5::InvalidPortID),
+    dma_wrapper    (dma_out,       std::string(name()) + ".dma_out",
+                    gem5::InvalidPortID),
+    wire_rx_wrapper(wire_rx_in,    std::string(name()) + ".wire_rx_socket",
+                    gem5::InvalidPortID),
+    wire_tx_wrapper(wire_tx_out,   std::string(name()) + ".wire_tx_socket",
+                    gem5::InvalidPortID),
+    peer_rx_wrapper(peer_rx_in,    std::string(name()) + ".peer_rx_in",
+                    gem5::InvalidPortID),
+    peer_tx_wrapper(peer_tx_out,   std::string(name()) + ".peer_tx_out",
+                    gem5::InvalidPortID),
+    dma_port(std::string(name()) + ".dma", *this),
+    _doorbell_drv("_doorbell_drv"),
+    _wire_rx_drv ("_wire_rx_drv"),
+    _cqe_tap     ("_cqe_tap"),
+    _wire_tx_tap ("_wire_tx_tap"),
+    _dma_unbound_target("_dma_unbound_target"),
+    impl_(new Impl(name()))
+{
+    mmio_socket.register_b_transport(this, &NICTopologySC::mmio_b);
+    wire_rx_in. register_b_transport(this, &NICTopologySC::wire_rx_b);
+    peer_rx_in. register_b_transport(this, &NICTopologySC::peer_rx_b);
+    _cqe_tap.    register_b_transport(this, &NICTopologySC::cqe_tap_b);
+    _wire_tx_tap.register_b_transport(this, &NICTopologySC::wire_tx_tap_b);
+    _dma_unbound_target.register_b_transport(
+        this, &NICTopologySC::dma_unbound_b);
+
+    SC_THREAD(timing_dma_worker);
+
+    if (impl_->cqe_stream) impl_->cqe_stream->out_1.bind(_cqe_tap);
+    if (impl_->ethenc)     impl_->ethenc->out_1.bind(_wire_tx_tap);
+    if (impl_->doorbell)   _doorbell_drv.bind(impl_->doorbell->in_1);
+    if (impl_->ethdec)     _wire_rx_drv.bind(impl_->ethdec->in_1);
+
+    std::cerr << "[NICTopologySC " << name()
+              << "] constructed; 38-module TLM topology online\n";
+}
+
+void
+NICTopologySC::before_end_of_elaboration()
+{
+    dma_native_bound_ = dma_port.isConnected();
+    dma_external_bound_ = dma_out.size() != 0;
+    if (!dma_external_bound_) {
+        // Keep legacy configs that do not know about dma_out elaboratable. Any
+        // attempted timing transaction fails explicitly in dma_unbound_b().
+        dma_out.bind(_dma_unbound_target);
+    }
+    if (timing_dma_enabled_ && !dma_native_bound_ && !dma_external_bound_) {
+        std::cerr << "[NICTopologySC " << name()
+                  << "] timing DMA has neither a native gem5 port nor an "
+                     "external TLM bridge\n";
+    } else if (timing_dma_enabled_) {
+        std::cerr << "[NICTopologySC " << name() << "] DMA transport="
+                  << (dma_native_bound_ ? "native-dynamic" : "tlm-fallback")
+                  << " max_outstanding=" << dma_max_outstanding_ << "\n";
+    }
+    sc_core::sc_module::before_end_of_elaboration();
+}
+
+void
+NICTopologySC::dma_unbound_b(tlm::tlm_generic_payload &trans,
+                             sc_core::sc_time &delay)
+{
+    (void)delay;
+    trans.set_response_status(tlm::TLM_ADDRESS_ERROR_RESPONSE);
+}
+
+bool
+NICTopologySC::enqueue_timing_dma(TimingDmaRequest &&request)
+{
+    if (!timing_dma_enabled_ || timing_dma_queue_.size() >=
+                                   OU_MAX_MODELED_QUEUE_ENTRIES) {
+        return false;
+    }
+
+    ++timing_dma_submitted_;
+    timing_dma_queue_.push_back(std::move(request));
+    timing_dma_kick_.notify(sc_core::SC_ZERO_TIME);
+    return true;
+}
+
+uint64_t
+NICTopologySC::dmaPendingRequests() const
+{
+    uint64_t pending = timing_dma_queue_.size() + udma_sq_work_.size() +
+                       udma_rx_pending_.size();
+    if (dma_active_request_)
+        ++pending;
+    // These states must imply an active request.  Count them independently
+    // if that invariant is ever broken so a CPU/memory-mode switch fails
+    // closed instead of hiding the inconsistent state.
+    if (!dma_active_request_)
+        pending += dma_outstanding_ + (dma_retry_packet_ ? 1U : 0U);
+    return pending;
+}
+
+bool
+NICTopologySC::dmaBeginRoi()
+{
+    if (dmaPendingRequests() != 0)
+        return false;
+
+    dma_roi_baseline_ = DmaRoiBaseline{
+        timing_dma_submitted_, timing_dma_completed_, timing_dma_failed_,
+        timing_dma_atomic_chunks_, timing_dma_timing_chunks_,
+        udma_page_walks_, udma_page_walk_pte_reads_,
+        udma_page_walk_failures_, udma_iotlb_hits_, udma_iotlb_misses_,
+        udma_iotlb_evictions_, udma_iotlb_invalidations_,
+        udma_queue_errors_};
+    dma_roi_peak_outstanding_ = 0;
+    dma_roi_active_ = true;
+    return true;
+}
+
+bool
+NICTopologySC::dmaIdle()
+{
+    const uint64_t pending = dmaPendingRequests();
+    const bool idle = pending == 0;
+    const auto roi_delta = [this](uint64_t current, uint64_t baseline) {
+        return dma_roi_active_ ? current - baseline : 0;
+    };
+    std::cerr << "[NIC_DMA_ROI " << name() << "]"
+              << " scope=roi"
+              << " roi_active=" << (dma_roi_active_ ? 1 : 0)
+              << " idle=" << (idle ? 1 : 0)
+              << " pending=" << pending
+              << " submitted=" << timing_dma_submitted_
+              << " completed=" << timing_dma_completed_
+              << " failed=" << timing_dma_failed_
+              << " atomic_chunks=" << timing_dma_atomic_chunks_
+              << " timing_chunks=" << timing_dma_timing_chunks_
+              << " peak_outstanding=" << timing_dma_peak_outstanding_
+              << " page_walks=" << udma_page_walks_
+              << " pte_reads=" << udma_page_walk_pte_reads_
+              << " pte_failures=" << udma_page_walk_failures_
+              << " iotlb_hits=" << udma_iotlb_hits_
+              << " iotlb_misses=" << udma_iotlb_misses_
+              << " iotlb_evictions=" << udma_iotlb_evictions_
+              << " iotlb_invalidations=" << udma_iotlb_invalidations_
+              << " queue_errors=" << udma_queue_errors_
+              << " roi_submitted=" << roi_delta(
+                     timing_dma_submitted_, dma_roi_baseline_.submitted)
+              << " roi_completed=" << roi_delta(
+                     timing_dma_completed_, dma_roi_baseline_.completed)
+              << " roi_failed=" << roi_delta(
+                     timing_dma_failed_, dma_roi_baseline_.failed)
+              << " roi_atomic_chunks=" << roi_delta(
+                     timing_dma_atomic_chunks_,
+                     dma_roi_baseline_.atomic_chunks)
+              << " roi_timing_chunks=" << roi_delta(
+                     timing_dma_timing_chunks_,
+                     dma_roi_baseline_.timing_chunks)
+              << " roi_peak_outstanding=" << dma_roi_peak_outstanding_
+              << " roi_page_walks=" << roi_delta(
+                     udma_page_walks_, dma_roi_baseline_.page_walks)
+              << " roi_pte_reads=" << roi_delta(
+                     udma_page_walk_pte_reads_, dma_roi_baseline_.pte_reads)
+              << " roi_pte_failures=" << roi_delta(
+                     udma_page_walk_failures_,
+                     dma_roi_baseline_.pte_failures)
+              << " roi_iotlb_hits=" << roi_delta(
+                     udma_iotlb_hits_, dma_roi_baseline_.iotlb_hits)
+              << " roi_iotlb_misses=" << roi_delta(
+                     udma_iotlb_misses_, dma_roi_baseline_.iotlb_misses)
+              << " roi_iotlb_evictions=" << roi_delta(
+                     udma_iotlb_evictions_,
+                     dma_roi_baseline_.iotlb_evictions)
+              << " roi_iotlb_invalidations=" << roi_delta(
+                     udma_iotlb_invalidations_,
+                     dma_roi_baseline_.iotlb_invalidations)
+              << " roi_queue_errors=" << roi_delta(
+                     udma_queue_errors_, dma_roi_baseline_.queue_errors)
+              << "\n";
+    dma_roi_active_ = false;
+    return idle;
+}
+
+bool
+NICTopologySC::submit_timing_dma_read(uint64_t pa, uint32_t len,
+                                      TimingDmaCompletion completion)
+{
+    if (len != 0 && pa > std::numeric_limits<uint64_t>::max() - (len - 1))
+        return false;
+
+    TimingDmaRequest request{
+        TimingDmaCommand::Read, pa, std::vector<uint8_t>(len),
+        std::move(completion), next_timing_dma_id_++};
+    return enqueue_timing_dma(std::move(request));
+}
+
+bool
+NICTopologySC::submit_timing_dma_write(uint64_t pa, const void *data,
+                                       uint32_t len,
+                                       TimingDmaCompletion completion)
+{
+    if ((len != 0 && data == nullptr) ||
+        (len != 0 &&
+         pa > std::numeric_limits<uint64_t>::max() - (len - 1))) {
+        return false;
+    }
+
+    std::vector<uint8_t> owned(len);
+    if (len != 0)
+        std::memcpy(owned.data(), data, len);
+    TimingDmaRequest request{
+        TimingDmaCommand::Write, pa, std::move(owned),
+        std::move(completion), next_timing_dma_id_++};
+    return enqueue_timing_dma(std::move(request));
+}
+
+bool
+NICTopologySC::submit_timing_dma_selftest(
+    uint64_t pa, uint32_t len, std::function<void(bool)> completion)
+{
+    if (!timing_dma_enabled_ || len == 0)
+        return false;
+
+    auto expected = std::make_shared<std::vector<uint8_t>>(len);
+    for (uint32_t i = 0; i < len; ++i)
+        (*expected)[i] = static_cast<uint8_t>((i * 131U + 0x5aU) & 0xffU);
+
+    return submit_timing_dma_write(
+        pa, expected->data(), len,
+        [this, pa, expected, completion = std::move(completion)](
+            bool write_ok, std::vector<uint8_t>) mutable {
+            if (!write_ok) {
+                if (completion)
+                    completion(false);
+                return;
+            }
+            const bool queued = submit_timing_dma_read(
+                pa, static_cast<uint32_t>(expected->size()),
+                [expected, completion](
+                    bool read_ok, std::vector<uint8_t> actual) mutable {
+                    if (completion)
+                        completion(read_ok && actual == *expected);
+                });
+            if (!queued && completion)
+                completion(false);
+        });
+}
+
+gem5::PacketPtr
+NICTopologySC::timing_dma_make_packet(uint64_t offset)
+{
+    panic_if(!dma_active_request_, "DMA packet requested without a transfer");
+    TimingDmaRequest &request = *dma_active_request_;
+    panic_if(offset >= request.data.size(),
+             "DMA packet offset is outside the transfer");
+
+    // A request never crosses a cache-line or page boundary.  The coherent
+    // crossbar and memory controller account for arbitration, cache snoops,
+    // row-buffer state, and channel queueing for each resulting packet.
+    constexpr uint64_t page_bytes = 4096;
+    const uint64_t line_bytes = system_ ? system_->cacheLineSize() : 64;
+    panic_if(line_bytes == 0, "timing DMA has a zero-byte cache line");
+    const uint64_t addr = request.pa + offset;
+    const uint64_t line_remaining = line_bytes - (addr % line_bytes);
+    const uint64_t page_remaining = page_bytes - (addr % page_bytes);
+    const uint64_t data_remaining = request.data.size() - offset;
+    const auto chunk = static_cast<unsigned int>(
+        std::min({line_remaining, page_remaining, data_remaining}));
+
+    gem5::Request::Flags flags;
+    auto req = std::make_shared<gem5::Request>(
+        addr, chunk, flags, dma_requestor_id_);
+    auto *pkt = new gem5::Packet(
+        req, request.command == TimingDmaCommand::Write ?
+                 gem5::MemCmd::WriteReq : gem5::MemCmd::ReadReq);
+    pkt->dataStatic(request.data.data() + offset);
+    return pkt;
+}
+
+void
+NICTopologySC::timing_dma_send_more()
+{
+    panic_if(!dma_active_request_, "DMA send without an active transfer");
+    panic_if(!system_ || !system_->isTimingMode(),
+             "timing DMA packet sent outside gem5 timing mode");
+
+    while (!dma_retry_packet_ &&
+           dma_outstanding_ < dma_max_outstanding_ &&
+           dma_next_offset_ < dma_active_request_->data.size()) {
+        gem5::PacketPtr pkt = timing_dma_make_packet(dma_next_offset_);
+        if (!dma_port.sendTimingReq(pkt)) {
+            dma_retry_packet_ = pkt;
+            ++timing_dma_retries_;
+            return;
+        }
+        dma_next_offset_ += pkt->getSize();
+        ++dma_outstanding_;
+        ++timing_dma_chunks_;
+        ++timing_dma_timing_chunks_;
+        timing_dma_peak_outstanding_ = std::max(
+            timing_dma_peak_outstanding_, dma_outstanding_);
+        if (dma_roi_active_) {
+            dma_roi_peak_outstanding_ = std::max(
+                dma_roi_peak_outstanding_, dma_outstanding_);
+        }
+    }
+
+    if (dma_next_offset_ == dma_active_request_->data.size() &&
+        dma_outstanding_ == 0 && !dma_retry_packet_) {
+        dma_completion_event_.notify(sc_core::SC_ZERO_TIME);
+    }
+}
+
+bool
+NICTopologySC::timing_dma_recv_resp(gem5::PacketPtr pkt)
+{
+    panic_if(!dma_active_request_ || dma_outstanding_ == 0,
+             "unexpected timing DMA response");
+    if (!pkt->isResponse() || pkt->isError())
+        dma_active_failed_ = true;
+    delete pkt;
+    --dma_outstanding_;
+    timing_dma_send_more();
+    return true;
+}
+
+void
+NICTopologySC::timing_dma_recv_retry()
+{
+    panic_if(!dma_active_request_ || !dma_retry_packet_,
+             "unexpected timing DMA request retry");
+    gem5::PacketPtr pkt = dma_retry_packet_;
+    if (!dma_port.sendTimingReq(pkt)) {
+        ++timing_dma_retries_;
+        return;
+    }
+    dma_retry_packet_ = nullptr;
+    dma_next_offset_ += pkt->getSize();
+    ++dma_outstanding_;
+    ++timing_dma_chunks_;
+    ++timing_dma_timing_chunks_;
+    timing_dma_peak_outstanding_ = std::max(
+        timing_dma_peak_outstanding_, dma_outstanding_);
+    if (dma_roi_active_) {
+        dma_roi_peak_outstanding_ = std::max(
+            dma_roi_peak_outstanding_, dma_outstanding_);
+    }
+    timing_dma_send_more();
+}
+
+bool
+NICTopologySC::timing_dma_native_transport(TimingDmaRequest &request)
+{
+    if (request.data.empty())
+        return true;
+    panic_if(!system_, "native DMA requires a System");
+    panic_if(dma_active_request_ || dma_retry_packet_ || dma_outstanding_,
+             "overlapping synchronous DMA transfers are not supported");
+
+    dma_active_request_ = &request;
+    dma_next_offset_ = 0;
+    dma_active_failed_ = false;
+
+    if (system_->isAtomicMode()) {
+        while (dma_next_offset_ < request.data.size()) {
+            gem5::PacketPtr pkt = timing_dma_make_packet(dma_next_offset_);
+            dma_next_offset_ += pkt->getSize();
+            ++timing_dma_chunks_;
+            ++timing_dma_atomic_chunks_;
+            const gem5::Tick delay = dma_port.sendAtomic(pkt);
+            if (!pkt->isResponse() || pkt->isError())
+                dma_active_failed_ = true;
+            delete pkt;
+            if (delay)
+                sc_core::wait(sc_core::sc_time::from_value(delay));
+        }
+    } else if (system_->isTimingMode()) {
+        timing_dma_send_more();
+        sc_core::wait(dma_completion_event_);
+    } else {
+        panic("native DMA requires gem5 atomic or timing memory mode");
+    }
+
+    const bool ok = !dma_active_failed_;
+    dma_active_request_ = nullptr;
+    dma_next_offset_ = 0;
+    dma_active_failed_ = false;
+    return ok;
+}
+
+bool
+NICTopologySC::timing_dma_b_transport(TimingDmaRequest &request)
+{
+    if (request.data.empty())
+        return true;
+    if (dma_native_bound_)
+        return timing_dma_native_transport(request);
+    if (!dma_external_bound_)
+        return false;
+
+    // The socket is 512 bits wide. Split again at the configured cache-line
+    // boundary and at 4 KiB so no transaction crosses a cache line or page.
+    constexpr uint64_t socket_bytes = 512 / 8;
+    constexpr uint64_t page_bytes = 4096;
+    const uint64_t cache_line_bytes = system_ ? system_->cacheLineSize() : 64;
+    const uint64_t beat_bytes = std::min(socket_bytes, cache_line_bytes);
+    panic_if(beat_bytes == 0, "timing DMA has a zero-byte transfer granule");
+
+    uint64_t done = 0;
+    while (done < request.data.size()) {
+        const uint64_t addr = request.pa + done;
+        const uint64_t line_remaining = beat_bytes - (addr % beat_bytes);
+        const uint64_t page_remaining = page_bytes - (addr % page_bytes);
+        const uint64_t data_remaining = request.data.size() - done;
+        const auto chunk = static_cast<unsigned int>(
+            std::min({line_remaining, page_remaining, data_remaining}));
+
+        tlm::tlm_generic_payload trans;
+        trans.set_command(request.command == TimingDmaCommand::Write ?
+                              tlm::TLM_WRITE_COMMAND :
+                              tlm::TLM_READ_COMMAND);
+        trans.set_address(addr);
+        trans.set_data_ptr(request.data.data() + done);
+        trans.set_data_length(chunk);
+        trans.set_streaming_width(chunk);
+        trans.set_byte_enable_ptr(nullptr);
+        trans.set_byte_enable_length(0);
+        trans.set_dmi_allowed(false);
+        trans.set_response_status(tlm::TLM_INCOMPLETE_RESPONSE);
+
+        sc_core::sc_time delay = sc_core::SC_ZERO_TIME;
+        dma_out->b_transport(trans, delay);
+        // Timing mode's simple-socket b->nb adapter waits internally and
+        // returns zero delay. Atomic mode returns an annotated delay instead.
+        if (delay > sc_core::SC_ZERO_TIME)
+            sc_core::wait(delay);
+
+        ++timing_dma_chunks_;
+        if (trans.get_response_status() != tlm::TLM_OK_RESPONSE) {
+            std::cerr << "[NICTopologySC " << name() << "] timing DMA request "
+                      << request.id << " failed at PA 0x" << std::hex << addr
+                      << std::dec << " len=" << chunk << " status="
+                      << trans.get_response_string() << "\n";
+            return false;
+        }
+        done += chunk;
+    }
+    return true;
+}
+
+bool
+NICTopologySC::udma_dma_pa(uint64_t pa, void *buf, uint32_t len, bool write)
+{
+    if (len == 0)
+        return true;
+    if (!buf || pa > std::numeric_limits<uint64_t>::max() - (len - 1U))
+        return false;
+
+    TimingDmaRequest request{
+        write ? TimingDmaCommand::Write : TimingDmaCommand::Read,
+        pa, std::vector<uint8_t>(len), {}, next_timing_dma_id_++};
+    if (write)
+        std::memcpy(request.data.data(), buf, len);
+
+    ++timing_dma_submitted_;
+    const bool ok = timing_dma_b_transport(request);
+    if (ok) {
+        ++timing_dma_completed_;
+        if (write)
+            timing_dma_write_bytes_ += len;
+        else {
+            timing_dma_read_bytes_ += len;
+            std::memcpy(buf, request.data.data(), len);
+        }
+    } else {
+        ++timing_dma_failed_;
+    }
+    return ok;
+}
+
+uint64_t
+NICTopologySC::udma_translate_va(uint32_t context_id, uint64_t ttbr0,
+                                  uint64_t va)
+{
+    constexpr uint64_t page_mask = openurma_udma::HardwarePageBytes - 1U;
+    const UdmaIotlbKey key{context_id, va & ~page_mask};
+    auto cached = udma_iotlb_.find(key);
+    if (cached != udma_iotlb_.end()) {
+        ++udma_iotlb_hits_;
+        udma_iotlb_lru_.splice(udma_iotlb_lru_.begin(), udma_iotlb_lru_,
+                               cached->second.lru_position);
+        return cached->second.pa_page | (va & page_mask);
+    }
+
+    ++udma_iotlb_misses_;
+    const uint64_t pa = udma_walk(ttbr0, va);
+    if (pa)
+        udma_iotlb_insert(context_id, va, pa);
+    return pa;
+}
+
+void
+NICTopologySC::udma_iotlb_insert(uint32_t context_id, uint64_t va,
+                                  uint64_t pa)
+{
+    if (udma_iotlb_entries_ == 0)
+        return;
+    constexpr uint64_t page_mask = openurma_udma::HardwarePageBytes - 1U;
+    const UdmaIotlbKey key{context_id, va & ~page_mask};
+    auto existing = udma_iotlb_.find(key);
+    if (existing != udma_iotlb_.end()) {
+        existing->second.pa_page = pa & ~page_mask;
+        udma_iotlb_lru_.splice(udma_iotlb_lru_.begin(), udma_iotlb_lru_,
+                               existing->second.lru_position);
+        return;
+    }
+
+    while (udma_iotlb_.size() >= udma_iotlb_entries_) {
+        const UdmaIotlbKey victim = udma_iotlb_lru_.back();
+        udma_iotlb_.erase(victim);
+        udma_iotlb_lru_.pop_back();
+        ++udma_iotlb_evictions_;
+    }
+    udma_iotlb_lru_.push_front(key);
+    udma_iotlb_.emplace(
+        key, UdmaIotlbEntry{pa & ~page_mask, udma_iotlb_lru_.begin()});
+}
+
+void
+NICTopologySC::udma_iotlb_invalidate_context(uint32_t context_id)
+{
+    for (auto it = udma_iotlb_.begin(); it != udma_iotlb_.end();) {
+        if (it->first.context_id != context_id) {
+            ++it;
+            continue;
+        }
+        udma_iotlb_lru_.erase(it->second.lru_position);
+        it = udma_iotlb_.erase(it);
+        ++udma_iotlb_invalidations_;
+    }
+}
+
+void
+NICTopologySC::udma_iotlb_invalidate_range(uint32_t context_id, uint64_t va,
+                                            uint64_t len)
+{
+    if (len == 0)
+        return;
+    constexpr uint64_t page_mask = openurma_udma::HardwarePageBytes - 1U;
+    const uint64_t first_page = va & ~page_mask;
+    const uint64_t last_byte = len - 1U >
+            std::numeric_limits<uint64_t>::max() - va ?
+        std::numeric_limits<uint64_t>::max() : va + len - 1U;
+    const uint64_t last_page = last_byte & ~page_mask;
+    for (auto it = udma_iotlb_.begin(); it != udma_iotlb_.end();) {
+        if (it->first.context_id != context_id ||
+            it->first.va_page < first_page ||
+            it->first.va_page > last_page) {
+            ++it;
+            continue;
+        }
+        udma_iotlb_lru_.erase(it->second.lru_position);
+        it = udma_iotlb_.erase(it);
+        ++udma_iotlb_invalidations_;
+    }
+}
+
+void
+NICTopologySC::udma_iotlb_clear()
+{
+    udma_iotlb_invalidations_ += udma_iotlb_.size();
+    udma_iotlb_.clear();
+    udma_iotlb_lru_.clear();
+}
+
+bool
+NICTopologySC::udma_dma_va(uint32_t context_id, uint64_t va, void *buf,
+                            uint32_t len, bool write)
+{
+    auto context = udma_contexts_.find(context_id);
+    if (context == udma_contexts_.end() || !context->second.ttbr0 ||
+        (len != 0 && (!buf || va >
+         std::numeric_limits<uint64_t>::max() - (len - 1U)))) {
+        return false;
+    }
+
+    auto *bytes = static_cast<uint8_t *>(buf);
+    uint32_t done = 0;
+    while (done < len) {
+        const uint64_t current_va = va + done;
+        const uint32_t chunk = std::min<uint32_t>(
+            len - done, 4096U - static_cast<uint32_t>(current_va & 0xfffU));
+        const uint64_t pa = udma_translate_va(
+            context_id, context->second.ttbr0, current_va);
+        if (!pa || !udma_dma_pa(pa, bytes + done, chunk, write))
+            return false;
+        done += chunk;
+    }
+    return true;
+}
+
+bool
+NICTopologySC::udma_dma_payload(uint32_t context_id, uint64_t va, void *buf,
+                                 uint32_t len, bool write)
+{
+    if (len == 0)
+        return true;
+    if (!buf || va > std::numeric_limits<uint64_t>::max() - (len - 1U))
+        return false;
+
+    // Queue storage has its own JFC/JFR/Jetty lifetime, but WQE payload SGEs
+    // are legal only while a registered MR owned by this process covers the
+    // complete transfer.  Checking the live table prevents a late WQE from
+    // recreating an IOTLB entry after MR DELETE.  UDMA local SGEs do not carry
+    // an access key (their token_id word is unused), so authorization is by
+    // owning context and registered VA interval.
+    for (const auto &entry : udma_mrs_) {
+        const UdmaMr &mr = entry.second;
+        if (mr.context_id != context_id || va < mr.va)
+            continue;
+        const uint64_t offset = va - mr.va;
+        if (offset <= mr.length && len <= mr.length - offset)
+            return udma_dma_va(context_id, va, buf, len, write);
+    }
+    if (ou_packet_trace_enabled()) {
+        std::cerr << "[NIC udma] reject unregistered payload ctx="
+                  << context_id << " va=0x" << std::hex << va << std::dec
+                  << " len=" << len << " write=" << write << "\n";
+    }
+    return false;
+}
+
+bool
+NICTopologySC::udma_dma_ring(uint32_t context_id, uint64_t base,
+                              uint32_t ring_bytes, uint64_t offset, void *buf,
+                              uint32_t len, bool write)
+{
+    if (!ring_bytes || (len && !buf))
+        return false;
+    auto *bytes = static_cast<uint8_t *>(buf);
+    uint32_t done = 0;
+    while (done < len) {
+        const uint64_t ring_offset = (offset + done) % ring_bytes;
+        const uint32_t chunk = std::min<uint32_t>(
+            len - done, ring_bytes - static_cast<uint32_t>(ring_offset));
+        if (!udma_dma_va(context_id, base + ring_offset,
+                         bytes + done, chunk, write)) {
+            return false;
+        }
+        done += chunk;
+    }
+    return true;
+}
+
+void
+NICTopologySC::udma_reset_resources()
+{
+    udma_iotlb_clear();
+    udma_contexts_.clear();
+    udma_mrs_.clear();
+    udma_jfcs_.clear();
+    udma_jfrs_.clear();
+    udma_jettys_.clear();
+    udma_sq_work_.clear();
+    udma_rx_pending_.clear();
+}
+
+void
+NICTopologySC::udma_accept_control(const uint8_t *data, uint64_t offset,
+                                    uint32_t len)
+{
+    if (!data || offset >= openurma_udma::CqeBytes ||
+        len > openurma_udma::CqeBytes - offset) {
+        ++udma_queue_errors_;
+        return;
+    }
+    std::memcpy(udma_ctrl_assembly_.data() + offset, data, len);
+    for (uint32_t i = 0; i < len; ++i)
+        udma_ctrl_valid_mask_ |= uint64_t{1} << (offset + i);
+    if (udma_ctrl_valid_mask_ == std::numeric_limits<uint64_t>::max()) {
+        udma_apply_control();
+        udma_ctrl_assembly_.fill(0);
+        udma_ctrl_valid_mask_ = 0;
+        // The worker sleeps without periodic polling until a receive queue
+        // exists.  A completed control message may create or destroy that
+        // queue, so re-evaluate the polling condition immediately.
+        timing_dma_kick_.notify(sc_core::SC_ZERO_TIME);
+    }
+}
+
+void
+NICTopologySC::udma_apply_control()
+{
+    using namespace openurma_udma;
+    const uint8_t *raw = udma_ctrl_assembly_.data();
+    const uint32_t magic = loadLe32(raw);
+    const uint16_t version = static_cast<uint16_t>(raw[4]) |
+        static_cast<uint16_t>(raw[5] << 8);
+    const auto opcode = static_cast<ControlOpcode>(raw[6]);
+    const auto resource = static_cast<ControlResource>(raw[7]);
+    const uint32_t sequence = loadLe32(raw + 8);
+    const uint32_t flags = loadLe32(raw + 12);
+    const uint32_t resource_id = loadLe32(raw + 16);
+    const uint32_t context_id = loadLe32(raw + 20);
+    const uint64_t data0 = loadLe64(raw + 24);
+    const uint64_t data1 = loadLe64(raw + 32);
+    const uint64_t data2 = loadLe64(raw + 40);
+    const uint64_t data3 = loadLe64(raw + 48);
+    const uint32_t data4 = loadLe32(raw + 56);
+    const uint32_t data5 = loadLe32(raw + 60);
+
+    // Resource deletion messages deliberately do not carry trusted VA
+    // ranges.  Invalidate translations from the state recorded when the
+    // resource was added, and do the same before replacing an ID so VA reuse
+    // cannot retain a stale physical-page translation.
+    const auto invalidate_jfc = [this](const UdmaJfc &jfc) {
+        udma_iotlb_invalidate_range(
+            jfc.context_id, jfc.cq_va, jfc.cq_bytes);
+        udma_iotlb_invalidate_range(
+            jfc.context_id, jfc.ci_va, sizeof(uint32_t));
+    };
+    const auto invalidate_jfr = [this](const UdmaJfr &jfr) {
+        udma_iotlb_invalidate_range(
+            jfr.context_id, jfr.rq_va, jfr.rq_bytes);
+        udma_iotlb_invalidate_range(
+            jfr.context_id, jfr.idx_va,
+            static_cast<uint64_t>(jfr.depth) * sizeof(uint32_t));
+        udma_iotlb_invalidate_range(
+            jfr.context_id, jfr.pi_va, sizeof(uint32_t));
+    };
+    const auto invalidate_jetty = [this](const UdmaJetty &jetty) {
+        udma_iotlb_invalidate_range(
+            jetty.context_id, jetty.sq_va, jetty.sq_bytes);
+    };
+
+    if (magic != ControlMagic || version != ControlVersion) {
+        ++udma_queue_errors_;
+        std::cerr << "[NIC udma] reject control magic/version: magic=0x"
+                  << std::hex << magic << std::dec
+                  << " version=" << version << "\n";
+        return;
+    }
+    if (sequence <= udma_last_ctrl_sequence_ &&
+        opcode != ControlOpcode::Reset) {
+        ++udma_queue_errors_;
+        std::cerr << "[NIC udma] reject replayed control sequence="
+                  << sequence << " last=" << udma_last_ctrl_sequence_ << "\n";
+        return;
+    }
+    udma_last_ctrl_sequence_ = sequence;
+
+    if (opcode == ControlOpcode::Reset) {
+        udma_reset_resources();
+        std::cerr << "[NIC udma] resource state reset sequence="
+                  << sequence << "\n";
+        return;
+    }
+
+    if (opcode == ControlOpcode::Delete) {
+        switch (resource) {
+          case ControlResource::Context:
+            udma_iotlb_invalidate_context(resource_id);
+            udma_contexts_.erase(resource_id);
+            break;
+          case ControlResource::Mr: {
+            auto mr = udma_mrs_.find(resource_id);
+            if (mr != udma_mrs_.end()) {
+                udma_iotlb_invalidate_range(
+                    mr->second.context_id, mr->second.va,
+                    mr->second.length);
+                udma_mrs_.erase(mr);
+            } else {
+                // DELETE payload addresses are not authoritative.  Reject an
+                // unknown ID instead of flushing an arbitrary context/range.
+                ++udma_queue_errors_;
+                std::cerr << "[NIC udma] delete unknown MR id="
+                          << resource_id << "\n";
+            }
+            break;
+          }
+          case ControlResource::Jfc: {
+            auto jfc = udma_jfcs_.find(resource_id);
+            if (jfc != udma_jfcs_.end()) {
+                invalidate_jfc(jfc->second);
+                udma_jfcs_.erase(jfc);
+            }
+            break;
+          }
+          case ControlResource::Jfr: {
+            auto jfr = udma_jfrs_.find(resource_id);
+            if (jfr != udma_jfrs_.end()) {
+                invalidate_jfr(jfr->second);
+                udma_jfrs_.erase(jfr);
+            }
+            break;
+          }
+          case ControlResource::Jetty: {
+            auto jetty = udma_jettys_.find(resource_id);
+            if (jetty != udma_jettys_.end()) {
+                invalidate_jetty(jetty->second);
+                udma_jettys_.erase(jetty);
+            }
+            break;
+          }
+          default: break;
+        }
+        return;
+    }
+
+    if (opcode == ControlOpcode::Bind || opcode == ControlOpcode::Unbind) {
+        auto jetty = udma_jettys_.find(resource_id);
+        if (resource != ControlResource::Jetty ||
+            jetty == udma_jettys_.end()) {
+            ++udma_queue_errors_;
+            return;
+        }
+        jetty->second.bound_remote_id =
+            opcode == ControlOpcode::Bind ? static_cast<uint32_t>(data0) : 0;
+        return;
+    }
+
+    if (opcode != ControlOpcode::Add)
+        return;
+
+    switch (resource) {
+      case ControlResource::Context: {
+        // ABI v2 carries the creating process's address space explicitly. An
+        // MMIO callback has no reliable originating ThreadContext, so using a
+        // fixed CPU index is incorrect on a multicore guest.
+        const uint32_t allowed_flags = ControlContextPgdPfnValid |
+            ControlContextPgdPfnHighMask;
+        const uint64_t pgd_pfn =
+            (static_cast<uint64_t>(flags &
+                                   ControlContextPgdPfnHighMask)
+             << ControlContextPgdPfnLowBits) |
+            data5;
+        const uint64_t ttbr0 = pgd_pfn << 12;
+        const bool pgd_in_memory = system_ && system_->isMemAddr(ttbr0) &&
+            ttbr0 <= std::numeric_limits<uint64_t>::max() -
+                         (HardwarePageBytes - 1U) &&
+            system_->isMemAddr(ttbr0 + HardwarePageBytes - 1U);
+        if ((flags & ControlContextPgdPfnValid) == 0 ||
+            (flags & ~allowed_flags) != 0 ||
+            data3 != HardwarePageBytes || !ttbr0 || !pgd_in_memory ||
+            data2 < HardwarePageBytes || data2 >= ControlOffset) {
+            ++udma_queue_errors_;
+            std::cerr << "[NIC udma] invalid context id=" << resource_id
+                      << " abi=" << ControlVersion
+                      << " flags=0x" << std::hex << flags
+                      << " pgd_pa=0x" << ttbr0 << std::dec
+                      << " page_bytes=" << data3 << "\n";
+            break;
+        }
+        udma_iotlb_invalidate_context(resource_id);
+        udma_contexts_[resource_id] =
+            UdmaContext{resource_id, ttbr0, data2};
+        std::cerr << "[NIC udma] context id=" << resource_id
+                  << " abi=" << ControlVersion
+                  << " pgd_source=control pgd_pa=0x" << std::hex << ttbr0
+                  << " jfc_page=0x" << data2 << std::dec << "\n";
+        break;
+      }
+      case ControlResource::Mr: {
+        if (!data0 || !data1 ||
+            data0 > std::numeric_limits<uint64_t>::max() - (data1 - 1U) ||
+            !udma_contexts_.count(context_id)) {
+            ++udma_queue_errors_;
+            std::cerr << "[NIC udma] invalid MR id=" << resource_id
+                      << " ctx=" << context_id << " va=0x" << std::hex
+                      << data0 << std::dec << " len=" << data1 << "\n";
+            break;
+        }
+        auto old_mr = udma_mrs_.find(resource_id);
+        if (old_mr != udma_mrs_.end()) {
+            udma_iotlb_invalidate_range(
+                old_mr->second.context_id, old_mr->second.va,
+                old_mr->second.length);
+        }
+        udma_iotlb_invalidate_range(context_id, data0, data1);
+        udma_mrs_[resource_id] = UdmaMr{
+            resource_id, context_id, data0, data1, data2,
+            static_cast<uint32_t>(data3)};
+        break;
+      }
+      case ControlResource::Jfc: {
+        const uint32_t cq_bytes = static_cast<uint32_t>(data3);
+        const uint32_t depth = cq_bytes / CqeBytes;
+        if (!data0 || !data1 || cq_bytes < CqeBytes ||
+            cq_bytes % CqeBytes || !is_power_of_two(depth) ||
+            !udma_contexts_.count(context_id)) {
+            ++udma_queue_errors_;
+            std::cerr << "[NIC udma] invalid JFC id=" << resource_id << "\n";
+            break;
+        }
+        const UdmaJfc replacement{
+            resource_id, context_id, data0, data1, cq_bytes, depth, 0};
+        auto old_jfc = udma_jfcs_.find(resource_id);
