+	spin_lock_irqsave(&od->aper_page_lock, irq_flags);
+	od->aper_page_map &= ~ctx->aper_pages;
+	ctx->aper_pages = 0;
+	spin_unlock_irqrestore(&od->aper_page_lock, irq_flags);
