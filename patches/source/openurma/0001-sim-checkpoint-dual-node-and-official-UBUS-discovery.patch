+            }
+            openurma_udma::storeLe32(response.data() + response_common,
+                                     0x01000000 | (uint32_t(opcode) << 16));
+            uint32_t common_dw1 = openurma_udma::loadLe32(
+                request.data() + request_common + 4);
+            common_dw1 = (common_dw1 & 0xff00ffffU) |
+                ((CommonBytes + extra_bytes) / 4 << 16);
+            openurma_udma::storeLe32(response.data() + response_common + 4,
+                                     common_dw1);
+            std::memcpy(response.data() + response_common + 8,
+                        request.data() + request_common + 8, 16);
+
+            uint8_t *extra = response.data() + response_common + CommonBytes;
+            if (opcode == 0) {
+                openurma_udma::storeLe32(extra, 0x00040100); // slice 0/1
+                openurma_udma::storeLe32(extra + 4, 0x01080001); // 1 port
+                openurma_udma::storeLe32(extra + 8, 0x00010000); // 1 TLV
+                openurma_udma::storeLe32(extra + 12, 0x021c0100); // link up
+                // port indices and rates remain zero. Remote GUID is the root
+                // controller for the endpoint and the UDMA endpoint for root.
+                openurma_udma::storeLe32(extra + 24, device ? 1 : 2);
+                openurma_udma::storeLe32(extra + 28, 0);
+                openurma_udma::storeLe32(extra + 32,
+                                         device ? 0x12000000 : 0x11000000);
+                openurma_udma::storeLe32(extra + 36,
+                                         device ? 0xcc080000 : 0xcc08a001);
+                openurma_udma::storeLe32(extra + 40, 0x04080000);
+                openurma_udma::storeLe32(extra + 44,
+                                         device ? 0x0002 : 0x0000);
+            } else if (opcode == 2) {
+                // NA query response; use stable non-zero CNAs per hop.
+                openurma_udma::storeLe32(extra, device ? 2 : 1);
+            }
+        }
+
+        const uint32_t rq_pi = ubios_msgq_regs_[RqPi] % depth;
+        const uint32_t cq_pi = ubios_msgq_regs_[CqPi] % depth;
+        std::array<uint8_t, 16> cqe{};
+        openurma_udma::storeLe32(cqe.data(),
+            uint32_t(task_type) | (uint32_t(response_opcode) << 8) |
+            (uint32_t(response.size()) << 16));
+        openurma_udma::storeLe32(cqe.data() + 4, msn);
+        openurma_udma::storeLe32(cqe.data() + 8, rq_pi);
+        if (!ou_dma(rq_base + uint64_t(rq_pi) * 0x800,
+                    response.data(), response.size(), true) ||
+            !ou_dma(cq_base + uint64_t(cq_pi) * cqe.size(),
+                    cqe.data(), cqe.size(), true))
+            break;
+        ubios_msgq_regs_[RqPi] = (rq_pi + 1) % depth;
+        ubios_msgq_regs_[CqPi] = (cq_pi + 1) % depth;
+        ci = (ci + 1) % depth;
+        ubios_msgq_regs_[SqCi] = ci;
+        if (config_request)
+            std::cerr << "[NIC ubios] completed config message msn=" << msn
+                      << " addr=0x" << std::hex << req_addr * 4 << std::dec
+                      << "\n";
+        else if (token_request)
+            std::cerr << "[NIC ubios] completed token query msn=" << msn
+                      << "\n";
+        else
+            std::cerr << "[NIC ubios] completed enum command="
+                      << unsigned(opcode) << " msn=" << msn
+                      << " request-bytes=" << payload_len
+                      << " response-bytes=" << response.size() << "\n";
+    }
+}
+
+bool
+NICTopologySC::ubios_msgq_access(tlm::tlm_command cmd, uint64_t off,
+                                 uint8_t *data, size_t len)
+{
+    if (off < OuUbiosMsgqOffset || off + len > OuUbiosMsgqOffset + 0x120 ||
+        !data || len != sizeof(uint32_t) || (off & 3))
+        return false;
+    const size_t index = (off - OuUbiosMsgqOffset) / 4;
+    if (cmd == tlm::TLM_READ_COMMAND) {
+        openurma_udma::storeLe32(data, ubios_msgq_regs_[index]);
+    } else if (cmd == tlm::TLM_WRITE_COMMAND) {
+        const uint32_t value = openurma_udma::loadLe32(data);
+        ubios_msgq_regs_[index] = value;
+        // Programming a new SQ base starts a fresh hardware queue.  This is
+        // also what lets the official driver tear down a failed controller
+        // probe and retry without inheriting indices from the old DMA area.
+        if (index == 0x00 / 4) {
+            ubios_msgq_regs_[0x0c / 4] = 0;
+            ubios_msgq_regs_[0x48 / 4] = 0;
+            ubios_msgq_regs_[0x78 / 4] = 0;
+        }
+        if (index == 0x08 / 4)
+            ubios_msgq_kick(value);
+    } else {
+        return false;
+    }
+    return true;
+}
+
+namespace {
+
+gem5::Tick
+ceil_ticks(uint64_t bytes, double ticks_per_byte)
+{
+    if (bytes == 0 || ticks_per_byte <= 0.0)
+        return 0;
+    const long double value = static_cast<long double>(bytes) *
+                              static_cast<long double>(ticks_per_byte);
+    panic_if(value > static_cast<long double>(
+                 std::numeric_limits<gem5::Tick>::max()),
+             "configured byte-time overflows Tick");
+    return static_cast<gem5::Tick>(std::ceil(value));
+}
+
+gem5::Tick
+checked_tick_sum(gem5::Tick a, gem5::Tick b)
+{
+    panic_if(b > std::numeric_limits<gem5::Tick>::max() - a,
+             "configured NIC latency overflows Tick");
+    return a + b;
+}
+
+gem5::Tick
+checked_tick_product(gem5::Tick value, uint32_t count)
+{
+    if (value == 0 || count == 0)
+        return 0;
+    panic_if(value > std::numeric_limits<gem5::Tick>::max() / count,
+             "configured NIC stage latency overflows Tick");
+    return value * count;
+}
