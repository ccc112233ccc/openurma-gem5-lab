+    desc.inline_data = (ext[36] & OU_FE_INLINE) != 0;
+    desc.provider_wqebbs = std::max<uint32_t>(1, ext[37]);
+    desc.provider_control_bytes = ext[38];
+    desc.sge_count = std::max<uint32_t>(1, ext[39]);
