+
+std::vector<uint8_t>
+ouBuildUbiosRoot(uint64_t base)
+{
+    std::vector<uint8_t> table(48, 0);
+    const char name[] = "ubios";
+    std::memcpy(table.data(), name, sizeof(name) - 1);
+    ouStoreLe<uint32_t>(table, 16, table.size());
+    table[20] = 1;
+    ouStoreLe<uint16_t>(table, 32, 1);
+    ouStoreLe<uint64_t>(table, 40, base + OuUbiosUbcOffset);
+    return table;
