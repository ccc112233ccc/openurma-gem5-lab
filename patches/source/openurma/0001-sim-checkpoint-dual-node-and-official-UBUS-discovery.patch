+    uint64_t encoded_bytes = sq_control_bytes_;
+    uint64_t blocks = 0;
+    if (desc.inline_data) {
+        encoded_bytes += payload_bytes;
+        blocks = (encoded_bytes + wqebb_bytes_ - 1) / wqebb_bytes_;
+    } else {
+        // Match UDMA's sq_cal_wqebb_num(): the first SGE occupies the tail of
+        // the control block, hence floor((ctl + (n - 1) * sge) / bb) + 1.
+        encoded_bytes += static_cast<uint64_t>(desc.sge_count - 1) *
+                         sq_sge_bytes_;
+        blocks = encoded_bytes / wqebb_bytes_ + 1;
+    }
+    panic_if(blocks > std::numeric_limits<uint32_t>::max(),
+             "configured WQE geometry exceeds uint32_t");
