--- /dev/null
+++ b/integration/umdk/kmod/openurma_udma_ctrl.h
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef OPENURMA_UDMA_CTRL_H
+#define OPENURMA_UDMA_CTRL_H
+
+#include <linux/types.h>
+
+/*
+ * Kernel-provider -> simulated-NIC control mailbox.
+ *
+ * Every transaction is exactly one little-endian 64-byte record written to
+ * OPENURMA_CTRL_OFFSET.  The monotonically increasing sequence number lets the
+ * NIC reject a partially observed or replayed resource update.  The payload is
+ * deliberately generic; its resource-specific interpretation is documented in
+ * kmod/README.md and is part of the versioned simulation ABI.
+ */
+#define OPENURMA_CTRL_MAGIC       0x4d43554fU /* bytes "OUCM" */
+#define OPENURMA_CTRL_VERSION     2U
+#define OPENURMA_CTRL_MSG_SIZE    64U
+#define OPENURMA_CTRL_OFFSET      0xf000U
+
+enum openurma_ctrl_opcode {
+	OPENURMA_CTRL_RESET = 0,
+	OPENURMA_CTRL_ADD = 1,
+	OPENURMA_CTRL_DELETE = 2,
+	OPENURMA_CTRL_BIND = 3,
+	OPENURMA_CTRL_UNBIND = 4,
+};
+
+enum openurma_ctrl_resource {
+	OPENURMA_CTRL_DEVICE = 0,
+	OPENURMA_CTRL_CONTEXT = 1,
+	OPENURMA_CTRL_TOKEN = 2,
+	OPENURMA_CTRL_MR = 3,
+	OPENURMA_CTRL_JFC = 4,
+	OPENURMA_CTRL_JFR = 5,
+	OPENURMA_CTRL_JETTY = 6,
+};
+
+/* Resource-specific flags use these common high bits where applicable. */
+#define OPENURMA_CTRL_F_PI_TYPE       (1U << 27)
+#define OPENURMA_CTRL_F_NON_PIN       (1U << 28)
+#define OPENURMA_CTRL_F_HUGEPAGE      (1U << 29)
+#define OPENURMA_CTRL_ASSOC_ID_MASK   0x000fffffU
+#define OPENURMA_CTRL_JFR_SGE_SHIFT   20U
+#define OPENURMA_CTRL_JFR_SGE_MASK    (0xfU << OPENURMA_CTRL_JFR_SGE_SHIFT)
+#define OPENURMA_CTRL_JFR_TM_SHIFT    24U
+#define OPENURMA_CTRL_JFR_TM_MASK     (0x7U << OPENURMA_CTRL_JFR_TM_SHIFT)
+#define OPENURMA_CTRL_JETTY_TYPE_SHIFT 16U
+#define OPENURMA_CTRL_JETTY_TYPE_MASK  (0xfU << OPENURMA_CTRL_JETTY_TYPE_SHIFT)
+#define OPENURMA_CTRL_JETTY_TM_SHIFT   20U
+#define OPENURMA_CTRL_JETTY_TM_MASK    (0xfU << OPENURMA_CTRL_JETTY_TM_SHIFT)
+
+/* CONTEXT ADD v2 carries a 40-bit PGD PFN without changing the established
+ * data0..data4 meanings.  flags[7:0] contains PFN[39:32], data5 contains
+ * PFN[31:0], and bit 31 makes the extension mandatory and self-describing. */
+#define OPENURMA_CTRL_CONTEXT_F_PGD_PFN_VALID (1U << 31)
+#define OPENURMA_CTRL_CONTEXT_PGD_PFN_HI_MASK 0xffU
+#define OPENURMA_CTRL_CONTEXT_PGD_PFN_HI_BITS 8U
+#define OPENURMA_CTRL_CONTEXT_PGD_PFN_LO_BITS 32U
+
+/* JFR ADD payload invariant: data4 is the page-aligned RQ allocation size;
+ * data5 is the logical max(64, roundup_pow2(requested_depth)) WQE count.  The
+ * latter must not be inferred from the padded RQ or index-buffer byte size. */
+
+/* JETTY ADD data2 packs recv_jfc_id in bits 63:32 and the dynamically assigned
+ * DSQE aperture page offset in bits 31:0.  data3 packs jfr_id in bits 63:32 and
+ * send_jfc_id in bits 31:0. */
+
+struct openurma_ctrl_msg {
+	__le32 magic;          /* 0x00 */
+	__le16 version;        /* 0x04 */
+	__u8 opcode;           /* 0x06: enum openurma_ctrl_opcode */
+	__u8 resource;         /* 0x07: enum openurma_ctrl_resource */
+	__le32 sequence;       /* 0x08 */
+	__le32 flags;          /* 0x0c: resource-specific */
+	__le32 resource_id;    /* 0x10 */
+	__le32 context_id;     /* 0x14 */
+	__le64 data0;          /* 0x18 */
+	__le64 data1;          /* 0x20 */
+	__le64 data2;          /* 0x28 */
+	__le64 data3;          /* 0x30 */
+	__le32 data4;          /* 0x38 */
+	__le32 data5;          /* 0x3c */
+};
+
+#endif /* OPENURMA_UDMA_CTRL_H */
