diff --git a/eval/twonode/gem5_scaffold/src/UdmaSimAbi.hh b/eval/twonode/gem5_scaffold/src/UdmaSimAbi.hh
new file mode 100644
index 0000000..c7e0230
--- /dev/null
+++ b/eval/twonode/gem5_scaffold/src/UdmaSimAbi.hh
@@ -0,0 +1,193 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// Binary contracts consumed by the simulation-only UDMA queue front end.
+// The kernel producer's authoritative definition is
+// integration/umdk/kmod/openurma_udma_ctrl.h.  Keep the static layout checks
+// here so a change cannot silently turn into a different simulated device.
+
+#ifndef __DEV_OPENURMA_UDMA_SIM_ABI_HH__
+#define __DEV_OPENURMA_UDMA_SIM_ABI_HH__
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace gem5::openurma_udma
+{
+
+constexpr uint32_t ControlMagic = 0x4d43554fU; // bytes "OUCM"
+constexpr uint16_t ControlVersion = 2;
+constexpr uint32_t ControlMessageBytes = 64;
+constexpr uint64_t ControlOffset = 0xf000;
+constexpr uint32_t HardwarePageBytes = 4096;
+constexpr uint32_t WqebbBytes = 64;
+constexpr uint32_t CqeBytes = 64;
+constexpr uint32_t SgeBytes = 16;
+constexpr uint32_t DoorbellOffset = 0x80;
+
+enum class ControlOpcode : uint8_t
+{
+    Reset = 0,
+    Add = 1,
+    Delete = 2,
+    Bind = 3,
+    Unbind = 4,
+};
+
+enum class ControlResource : uint8_t
+{
+    Device = 0,
+    Context = 1,
+    Token = 2,
+    Mr = 3,
+    Jfc = 4,
+    Jfr = 5,
+    Jetty = 6,
+};
+
+constexpr uint32_t ControlPiType = 1U << 27;
+constexpr uint32_t ControlNonPin = 1U << 28;
+constexpr uint32_t ControlHugePage = 1U << 29;
+constexpr uint32_t ControlAssocIdMask = 0x000fffffU;
+constexpr uint32_t JfrMaxSgeLogShift = 20;
+constexpr uint32_t JfrMaxSgeLogMask = 0x00f00000U;
+constexpr uint32_t JfrTransModeShift = 24;
+constexpr uint32_t JfrTransModeMask = 0x07000000U;
+constexpr uint32_t ControlContextPgdPfnValid = 1U << 31;
+constexpr uint32_t ControlContextPgdPfnHighMask = 0xffU;
+constexpr uint32_t ControlContextPgdPfnHighBits = 8;
+constexpr uint32_t ControlContextPgdPfnLowBits = 32;
+
+struct ControlMessage
+{
+    uint32_t magic;
+    uint16_t version;
+    uint8_t opcode;
+    uint8_t resource;
+    uint32_t sequence;
+    uint32_t flags;
+    uint32_t resourceId;
+    uint32_t contextId;
+    uint64_t data[4];
+    uint32_t data4;
+    uint32_t data5;
+};
+
+static_assert(sizeof(ControlMessage) == ControlMessageBytes);
+static_assert(offsetof(ControlMessage, magic) == 0x00);
+static_assert(offsetof(ControlMessage, version) == 0x04);
+static_assert(offsetof(ControlMessage, opcode) == 0x06);
+static_assert(offsetof(ControlMessage, resource) == 0x07);
+static_assert(offsetof(ControlMessage, sequence) == 0x08);
+static_assert(offsetof(ControlMessage, flags) == 0x0c);
+static_assert(offsetof(ControlMessage, resourceId) == 0x10);
+static_assert(offsetof(ControlMessage, contextId) == 0x14);
+static_assert(offsetof(ControlMessage, data) == 0x18);
+static_assert(offsetof(ControlMessage, data4) == 0x38);
+static_assert(offsetof(ControlMessage, data5) == 0x3c);
+
+inline uint32_t
+loadLe32(const uint8_t *p)
+{
+    return static_cast<uint32_t>(p[0]) |
+        (static_cast<uint32_t>(p[1]) << 8) |
+        (static_cast<uint32_t>(p[2]) << 16) |
+        (static_cast<uint32_t>(p[3]) << 24);
+}
+
+inline uint64_t
+loadLe64(const uint8_t *p)
+{
+    return static_cast<uint64_t>(loadLe32(p)) |
+        (static_cast<uint64_t>(loadLe32(p + 4)) << 32);
+}
+
+inline void
+storeLe32(uint8_t *p, uint32_t value)
+{
+    p[0] = static_cast<uint8_t>(value);
+    p[1] = static_cast<uint8_t>(value >> 8);
+    p[2] = static_cast<uint8_t>(value >> 16);
+    p[3] = static_cast<uint8_t>(value >> 24);
+}
+
+inline void
+storeLe64(uint8_t *p, uint64_t value)
+{
+    storeLe32(p, static_cast<uint32_t>(value));
+    storeLe32(p + 4, static_cast<uint32_t>(value >> 32));
+}
+
+struct Sge
+{
+    uint32_t length = 0;
+    uint32_t tokenId = 0;
+    uint64_t va = 0;
+};
+
+class SqWqe
+{
+  public:
+    explicit SqWqe(const std::array<uint8_t, WqebbBytes> &raw) : bytes(raw) {}
+
+    uint16_t bbIndex() const { return loadLe32(bytes.data()) & 0xffffU; }
+    uint8_t flags() const { return (loadLe32(bytes.data()) >> 16) & 0x7fU; }
+    bool completionEnabled() const { return (flags() & (1U << 5)) != 0; }
+    bool isInline() const { return (flags() & (1U << 6)) != 0; }
+    bool owner() const { return (loadLe32(bytes.data()) >> 31) != 0; }
+    uint8_t opcode() const { return (loadLe32(bytes.data() + 4) >> 8) & 0xffU; }
+    uint16_t inlineLength() const { return loadLe32(bytes.data() + 4) >> 22; }
+    uint8_t sgeCount() const { return loadLe32(bytes.data() + 8) >> 24; }
+    uint32_t remoteJetty() const { return loadLe32(bytes.data() + 12) & 0xfffffU; }
+    const uint8_t *remoteEid() const { return bytes.data() + 16; }
+    uint64_t immediate() const { return loadLe64(bytes.data() + 40); }
+
+    Sge firstSge() const
+    {
+        return Sge{loadLe32(bytes.data() + 48),
+                   loadLe32(bytes.data() + 52),
+                   loadLe64(bytes.data() + 56)};
+    }
+
+    uint32_t wqebbCount() const
+    {
+        if (isInline())
+            return (48U + inlineLength() + WqebbBytes - 1U) / WqebbBytes;
+        const uint32_t count = sgeCount();
+        return (48U + (count ? count - 1U : 0U) * SgeBytes) /
+            WqebbBytes + 1U;
+    }
+
+    const std::array<uint8_t, WqebbBytes> &raw() const { return bytes; }
+
+  private:
+    std::array<uint8_t, WqebbBytes> bytes;
+};
+
+// Official hardware CQE opcodes used by the first SEND/SEND_IMM slice.
+constexpr uint8_t CqeSend = 0x00;
+constexpr uint8_t CqeSendWithImm = 0x01;
+
+inline std::array<uint8_t, CqeBytes>
+makeCqe(bool receive, bool jetty, bool owner, uint8_t opcode,
+        uint16_t entryIndex, uint32_t localId, uint32_t byteCount,
+        uint64_t userData, uint64_t immediate)
+{
+    std::array<uint8_t, CqeBytes> cqe{};
+    uint32_t dw0 = (receive ? 1U : 0U) |
+        (jetty ? 1U << 1 : 0U) |
+        (owner ? 1U << 2 : 0U) |
+        (static_cast<uint32_t>(opcode & 0x7U) << 4);
+    storeLe32(cqe.data(), dw0); // status/substatus stay SUCCESS/0
+    storeLe32(cqe.data() + 4,
+              static_cast<uint32_t>(entryIndex) | ((localId & 0xffffU) << 16));
+    storeLe32(cqe.data() + 8, (localId >> 16) & 0xfU);
+    storeLe32(cqe.data() + 16, byteCount);
+    storeLe64(cqe.data() + 20, userData);
+    storeLe64(cqe.data() + 44, immediate);
+    return cqe;
+}
+
+} // namespace gem5::openurma_udma
+
+#endif // __DEV_OPENURMA_UDMA_SIM_ABI_HH__
