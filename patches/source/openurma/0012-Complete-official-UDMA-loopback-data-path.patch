+                    return;
+                }
+                const auto direct_wqe = jetty.direct_wqe;
+                jetty.direct_wqe_valid = 0;
+                const uint32_t low =
+                    openurma_udma::loadLe32(direct_wqe.data()) & 0xffffU;
                 uint32_t producer =
                     (static_cast<uint32_t>(jetty.consumer) & ~0xffffU) | low;
                 if (producer < static_cast<uint32_t>(jetty.consumer))
@@ -3714,11 +3842,20 @@ NICTopologySC::mmio_b(tlm::tlm_generic_payload &trans,
                               << " off=0x" << std::hex << off << std::dec
