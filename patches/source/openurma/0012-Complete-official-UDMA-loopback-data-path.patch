+uint64_t
+NICTopologySC::ummu_translate_iova_tid(uint32_t token_id, uint64_t iova)
+{
+    // Queue contexts carry the TID selected when userspace registered the
+    // backing pages.  Different processes commonly map their rings at the
+    // same IOVA, so walking the first TCT entry that happens to translate the
+    // address is ambiguous.  Hardware indexes the TCT with this TID.
+    constexpr uint64_t AddressMask = 0x0000fffffffff000ULL;
+    constexpr uint32_t TectTag = 0;
+    constexpr size_t TectEntryBytes = 64;
+    constexpr size_t TctEntryBytes = 64;
+    constexpr size_t TctEntries = 1024;
+
+    if (token_id >= TctEntries)
+        return 0;
+    const uint64_t tect_base = openurma_udma::loadLe64(
+        ummu_regs_.data() + 0x70) & AddressMask;
+    if (!tect_base)
+        return 0;
+
+    std::array<uint8_t, TectEntryBytes> tect{};
+    if (!ou_dma(tect_base + TectTag * TectEntryBytes,
+                tect.data(), tect.size(), false) ||
+        !(openurma_udma::loadLe64(tect.data()) & 1U)) {
+        return 0;
+    }
+    const uint64_t tct_base = openurma_udma::loadLe64(tect.data() + 8) &
+                              AddressMask;
+    if (!tct_base)
+        return 0;
+
+    std::array<uint8_t, TctEntryBytes> entry{};
+    if (!ou_dma(tct_base + uint64_t(token_id) * TctEntryBytes,
+                entry.data(), entry.size(), false) ||
+        !(openurma_udma::loadLe64(entry.data()) & 1U)) {
+        return 0;
+    }
+    const uint64_t ttbr = openurma_udma::loadLe64(entry.data() + 16) &
+                          AddressMask;
+    return ttbr ? ou_walk(ttbr, iova) : 0;
+}
+
 bool
