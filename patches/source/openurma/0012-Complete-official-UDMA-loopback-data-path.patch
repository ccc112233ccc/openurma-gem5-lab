 }
 
+bool
+NICTopologySC::ummu_dma_tid(uint32_t token_id, uint64_t iova, void *buf,
+                            uint32_t len, bool write)
+{
+    auto *bytes = static_cast<uint8_t *>(buf);
+    while (len) {
+        const uint32_t chunk = std::min<uint32_t>(
+            len, 4096U - static_cast<uint32_t>(iova & 0xfff));
+        const uint64_t pa = ummu_translate_iova_tid(token_id, iova);
+        if (!pa || !ou_dma(pa, bytes, chunk, write))
+            return false;
+        iova += chunk;
+        bytes += chunk;
+        len -= chunk;
+    }
+    return true;
+}
