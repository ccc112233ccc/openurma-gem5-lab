 // Walk the ARM64 guest page table (4 KB granule, 48-bit VA, 4 levels L0..L3) at
 // `ttbr0` to translate a guest VA -> guest PA, reading table entries straight from
 // guest physical memory. Handles 1 GB (L1) / 2 MB (L2) block descriptors. 0 = unmapped.
@@ -3696,15 +3808,31 @@ NICTopologySC::mmio_b(tlm::tlm_generic_payload &trans,
     }
 
     if (udma_mode_ && cmd == tlm::TLM_WRITE_COMMAND && data && len >= 4) {
-        for (const auto &entry : udma_jettys_) {
-            const UdmaJetty &jetty = entry.second;
-            if (off == jetty.dsqe_page_offset) {
-                // A one-WQEBB direct SQE is copied to the device page in one
-                // 64-byte transaction or as ordered 8-byte stores. The SQE
-                // is already present in the normal SQ ring before the MMIO
-                // barrier, so its 16-bit final producer index is sufficient
-                // to drive the same queue engine without duplicating decode.
-                const uint32_t low = openurma_udma::loadLe32(data) & 0xffffU;
+        for (auto &entry : udma_jettys_) {
+            UdmaJetty &jetty = entry.second;
+            if (off >= jetty.dsqe_page_offset &&
+                off + len <= jetty.dsqe_page_offset +
+                             openurma_udma::WqebbBytes) {
+                // The official userspace provider copies a complete one-WQEBB
+                // SQE directly into this device page.  gem5 may present the
+                // architectural 64-byte store as one transaction or several
+                // smaller writes, so retain every byte and submit only after
+                // the whole WQE has arrived.  Consuming this MMIO image is
+                // essential: the cached shadow SQ is not required to be
+                // coherent with a functional device-side DMA read.
+                const uint32_t begin = static_cast<uint32_t>(
+                    off - jetty.dsqe_page_offset);
+                std::memcpy(jetty.direct_wqe.data() + begin, data, len);
+                for (uint32_t index = 0; index < len; ++index)
+                    jetty.direct_wqe_valid |= uint64_t{1} << (begin + index);
+                if (jetty.direct_wqe_valid != ~uint64_t{0}) {
