+uint64_t
+NICTopologySC::adapterSyncStep()
+{
+    panic_if(peer_transport_ != "switch-adapter" || peer_node_id_ < 0,
+             "adapterSyncStep requires a cross-process switch adapter");
+    panic_if(peer_link_latency_ == 0,
+             "adapter local synchronization requires positive lookahead");
+    peer_ring_map();
+    sc_core::sc_time delay = sc_core::SC_ZERO_TIME;
+    peer_ring_drain(delay);
+
+    const gem5::Tick now = gem5::curTick();
+    const uint64_t remote_phase = __atomic_load_n(
+        &ring_->peer_sync_phase, __ATOMIC_ACQUIRE);
+    if (remote_phase > peer_sync_phase_ && (remote_phase & 1) == 0) {
+        // The peer is frozen at its collective OFF toggle and promises no
+        // more DATA. This endpoint may run without a finite bound until it
+        // reaches the same toggle; adapterSyncToggle(false) then completes
+        // the generation handshake on both sides.
+        std::cerr << "[NIC adapter-sync] peer quiesced local_phase="
+                  << peer_sync_phase_ << " remote_phase=" << remote_phase
+                  << " tick=" << now << "\n";
+        return gem5::MaxTick;
+    }
+    if (peer_last_sync_sent_ != now) {
+        // Avoid publishing a partial multi-port promise: either every output
+        // FIFO has room for this virtual-time horizon or none is modified.
+        for (uint32_t port = 0; port < ub_port_count_; ++port) {
+            auto &direction = ring_->direction[tx_dir_][port];
+            const uint64_t head = __atomic_load_n(
+                &direction.head.value, __ATOMIC_RELAXED);
+            const uint64_t tail = __atomic_load_n(
+                &direction.tail.value, __ATOMIC_ACQUIRE);
+            if (head - tail >= OU_RING_SLOTS)
+                return 0;
+        }
+        for (uint32_t port = 0; port < ub_port_count_; ++port) {
+            auto &direction = ring_->direction[tx_dir_][port];
+            const uint64_t head = __atomic_load_n(
+                &direction.head.value, __ATOMIC_RELAXED);
+            uint8_t *slot = peer_ring_slot(tx_dir_, port, head);
+            auto *header = reinterpret_cast<OuRingSlotHeader *>(slot);
+            std::memset(header, 0, sizeof(*header));
+            header->type = static_cast<uint32_t>(
+                openurma_adapter::MessageType::Sync);
+            header->send_tick = now;
+            header->receive_tick = checked_tick_sum(
+                now, peer_link_latency_);
+            header->sequence = peer_tx_seq_++;
+            header->source_port = port;
+            header->destination_port = port;
+            header->protocol_version = openurma_adapter::Version;
+            __atomic_store_n(&direction.head.value, head + 1,
+                             __ATOMIC_RELEASE);
+        }
+        peer_last_sync_sent_ = now;
+    }
+
+    gem5::Tick next = gem5::MaxTick;
+    for (uint32_t port = 0; port < ub_port_count_; ++port) {
+        auto &direction = ring_->direction[rx_dir_][port];
+        const uint64_t tail = __atomic_load_n(
+            &direction.tail.value, __ATOMIC_RELAXED);
+        const uint64_t head = __atomic_load_n(
+            &direction.head.value, __ATOMIC_ACQUIRE);
+        if (tail == head)
+            return 0;
+        const auto *header = reinterpret_cast<const OuRingSlotHeader *>(
+            peer_ring_slot(rx_dir_, port, tail));
+        panic_if(header->protocol_version != openurma_adapter::Version,
+                 "adapter protocol version %u is unsupported",
+                 header->protocol_version);
+        panic_if(header->receive_tick < now,
+                 "adapter delivered stale timestamp %llu below current %llu",
+                 (unsigned long long)header->receive_tick,
+                 (unsigned long long)now);
+        next = std::min<gem5::Tick>(next, header->receive_tick);
+    }
+    return next == gem5::MaxTick ? 0 : next;
+}
+
+bool
+NICTopologySC::adapterSyncToggle(bool active)
+{
+    panic_if(peer_transport_ != "switch-adapter" || peer_node_id_ < 0,
+             "adapterSyncToggle requires a cross-process switch adapter");
+    peer_ring_map();
+    if (active != peer_sync_local_active_) {
+        ++peer_sync_phase_;
+        panic_if(bool(peer_sync_phase_ & 1) != active,
+                 "adapter synchronization phase parity is inconsistent");
+        peer_sync_local_active_ = active;
+        peer_last_sync_sent_ = gem5::MaxTick;
+        __atomic_store_n(&ring_->local_sync_phase, peer_sync_phase_,
+                         __ATOMIC_RELEASE);
+    }
+    const uint64_t remote_phase = __atomic_load_n(
+        &ring_->peer_sync_phase, __ATOMIC_ACQUIRE);
+    if (remote_phase >= peer_sync_phase_) {
+        std::cerr << "[NIC adapter-sync] toggle active=" << active
+                  << " local_phase=" << peer_sync_phase_
+                  << " remote_phase=" << remote_phase
+                  << " tick=" << gem5::curTick() << "\n";
+        return true;
+    }
+    return false;
+}
+
