+    // Collective ROI synchronization is control-plane state, not a timed UB
+    // packet. The endpoint monotonically increments local_sync_phase on every
+    // ON/OFF transition. The switch mirrors the remote endpoint's phase into
+    // peer_sync_phase. Odd phases mean active; even phases mean quiesced.
+    uint64_t local_sync_phase;
+    uint64_t peer_sync_phase;
+    uint8_t control_reserved[4080];
 };
 
 static_assert(sizeof(RingIndex) == 64);
 static_assert(sizeof(MessageHeader) == 64);
-static_assert(sizeof(Ring) == 4096);
+static_assert(sizeof(Ring) == 8192);
 
