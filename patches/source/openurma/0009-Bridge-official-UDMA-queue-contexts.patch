+            const auto dw = [&context](size_t index) {
+                return openurma_udma::loadLe32(
+                    context.data() + index * sizeof(uint32_t));
+            };
+            if (command == CreateJfcContext) {
+                const uint32_t shift = ((dw(0) >> 4) & 0xfU) + 6U;
+                const uint64_t cq_iova =
+                    ((uint64_t(dw(1)) << 20) | (dw(0) >> 12)) << 12;
+                const uint64_t ci_iova =
+                    ((uint64_t(dw(7) & 0x03ffffffU) << 32) | dw(6)) << 6;
+                if (shift < 31 && cq_iova && ci_iova) {
+                    const uint32_t depth = 1U << shift;
+                    UdmaJfc jfc{};
+                    jfc.id = tag;
+                    jfc.cq_va = cq_iova;
+                    jfc.ci_va = ci_iova;
+                    jfc.cq_bytes = depth * openurma_udma::CqeBytes;
+                    jfc.depth = depth;
+                    jfc.official = true;
+                    udma_jfcs_[tag] = jfc;
+                    std::cerr << "[NIC udma official] JFC id=" << tag
+                              << " cq_iova=0x" << std::hex << cq_iova
+                              << " ci_iova=0x" << ci_iova << std::dec
+                              << " depth=" << depth << "\n";
+                }
+            } else if (command == CreateJfrContext) {
+                const uint32_t rqe_shift = (dw(0) >> 8) & 0xfU;
+                const uint32_t sge_shift = (dw(0) >> 4) & 0x7U;
+                const uint64_t rq_iova =
+                    ((uint64_t(dw(2)) << 20) | (dw(1) >> 12)) << 12;
+                const uint64_t idx_iova =
+                    ((uint64_t(dw(9) & 0x000fffffU) << 32) | dw(8)) << 12;
+                const uint32_t jfc_id =
+                    ((dw(10) & 0xffU) << 12) | (dw(9) >> 20);
+                const uint64_t pi_iova =
+                    ((uint64_t(dw(12) & 0x3U) << 56) |
+                     (uint64_t(dw(11)) << 24) | (dw(10) >> 8)) << 6;
+                if (rqe_shift < 31 && sge_shift < 16 && rq_iova &&
+                    idx_iova && pi_iova) {
+                    UdmaJfr jfr{};
+                    jfr.id = tag;
+                    jfr.recv_jfc_id = jfc_id;
+                    jfr.rq_va = rq_iova;
+                    jfr.idx_va = idx_iova;
+                    jfr.pi_va = pi_iova;
+                    jfr.user_queue = uint64_t(dw(5)) |
+                        (uint64_t(dw(6)) << 32);
+                    jfr.depth = 1U << rqe_shift;
+                    jfr.max_sge = 1U << sge_shift;
+                    jfr.rqe_stride = jfr.max_sge * openurma_udma::SgeBytes;
+                    jfr.rq_bytes = jfr.depth * jfr.rqe_stride;
+                    jfr.official = true;
+                    udma_jfrs_[tag] = jfr;
+                    std::cerr << "[NIC udma official] JFR id=" << tag
+                              << " rq_iova=0x" << std::hex << rq_iova
+                              << " idx_iova=0x" << idx_iova
+                              << " pi_iova=0x" << pi_iova << std::dec
+                              << " jfc=" << jfc_id
+                              << " depth=" << jfr.depth << "\n";
+                }
+            } else {
+                const uint32_t sq_shift = (dw(0) >> 8) & 0xfU;
+                const uint64_t sq_iova =
+                    ((uint64_t(dw(2)) << 20) | (dw(1) >> 12)) << 12;
+                if (sq_shift < 31 && sq_iova) {
+                    UdmaJetty jetty{};
+                    jetty.id = tag;
+                    jetty.sq_va = sq_iova;
+                    jetty.max_wqebbs = 1U << sq_shift;
+                    jetty.sq_bytes = jetty.max_wqebbs *
+                        openurma_udma::WqebbBytes;
+                    jetty.send_jfc_id = dw(4) & 0x000fffffU;
+                    jetty.jfr_id = ((dw(5) & 0xffU) << 12) | (dw(4) >> 20);
+                    jetty.recv_jfc_id = dw(5) >> 12;
+                    jetty.user_queue = uint64_t(dw(7)) |
+                        (uint64_t(dw(8)) << 32);
+                    jetty.dsqe_page_offset = OuUdmaMemOffset + 0x1000 +
+                        uint64_t(tag) * openurma_udma::HardwarePageBytes;
+                    jetty.official = true;
+                    udma_jettys_[tag] = jetty;
+                    std::cerr << "[NIC udma official] Jetty id=" << tag
+                              << " sq_iova=0x" << std::hex << sq_iova
+                              << " db_off=0x" << jetty.dsqe_page_offset +
+                                     openurma_udma::DoorbellOffset
+                              << std::dec << " send_jfc="
+                              << jetty.send_jfc_id << " jfr="
+                              << jetty.jfr_id << " recv_jfc="
+                              << jetty.recv_jfc_id << " depth="
+                              << jetty.max_wqebbs << "\n";
+                }
+            }
+            timing_dma_kick_.notify(sc_core::SC_ZERO_TIME);
+        }
+    } else if (command == DestroyJfsContext) {
+        udma_jettys_.erase(tag);
+    } else if (command == DestroyJfcContext) {
+        udma_jfcs_.erase(tag);
+    } else if (command == DestroyJfrContext) {
+        udma_jfrs_.erase(tag);
+    }
+
     if (event_enabled)
