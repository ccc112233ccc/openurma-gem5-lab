+bool
+NICTopologySC::udma_dma_resource(bool official, uint32_t context_id,
+                                  uint64_t address, void *buf, uint32_t len,
+                                  bool write)
+{
+    return official ? ummu_dma(address, buf, len, write) :
+                      udma_dma_va(context_id, address, buf, len, write);
+}
+
+bool
+NICTopologySC::udma_dma_resource_ring(bool official, uint32_t context_id,
+                                       uint64_t base, uint32_t ring_bytes,
+                                       uint64_t offset, void *buf,
+                                       uint32_t len, bool write)
+{
+    if (!official)
+        return udma_dma_ring(context_id, base, ring_bytes, offset, buf,
+                             len, write);
+    if (!ring_bytes || (len && !buf))
+        return false;
+    auto *bytes = static_cast<uint8_t *>(buf);
+    uint32_t done = 0;
+    while (done < len) {
+        const uint64_t ring_offset = (offset + done) % ring_bytes;
+        const uint32_t chunk = std::min<uint32_t>(
+            len - done, ring_bytes - static_cast<uint32_t>(ring_offset));
+        if (!ummu_dma(base + ring_offset, bytes + done, chunk, write))
+            return false;
+        done += chunk;
+    }
+    return true;
+}
+
+bool
+NICTopologySC::udma_dma_resource_payload(bool official, uint32_t context_id,
+                                          uint64_t address, void *buf,
+                                          uint32_t len, bool write)
+{
+    return official ? ummu_dma(address, buf, len, write) :
+                      udma_dma_payload(context_id, address, buf, len, write);
+}
