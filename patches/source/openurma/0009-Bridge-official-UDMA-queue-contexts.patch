+    // The official UDMA driver programs queue state through this architected
+    // mailbox. Capture the exact context hardware receives; no provider or
+    // kernel instrumentation is needed.
+    if ((command == CreateJfsContext || command == CreateJfcContext ||
+         command == CreateJfrContext) && context_iova) {
+        std::array<uint8_t, 128> context{};
