From e703da71b7d8f5058311678ceda0cf942fbe2bf5 Mon Sep 17 00:00:00 2001
From: Burger <cczjum@outlook.com>
Date: Thu, 17 Sep 2026 14:00:51 +0800
Subject: [PATCH 06/27] Model official UDMA probe control path

---
 .../gem5_scaffold/src/NICTopologySC.cc        | 109 +++++++++++++++++-
 1 file changed, 107 insertions(+), 2 deletions(-)

diff --git a/eval/twonode/gem5_scaffold/src/NICTopologySC.cc b/eval/twonode/gem5_scaffold/src/NICTopologySC.cc
index fc775c4..1ddb6e3 100644
--- a/eval/twonode/gem5_scaffold/src/NICTopologySC.cc
+++ b/eval/twonode/gem5_scaffold/src/NICTopologySC.cc
@@ -176,6 +176,7 @@ constexpr uint32_t OuUmmuCap0 = 0x10;
 constexpr uint32_t OuUmmuCap1 = 0x14;
 constexpr uint32_t OuUmmuCap2 = 0x18;
 constexpr uint32_t OuUmmuCap3 = 0x1c;
+constexpr uint32_t OuUmmuCap5 = 0x24;
 constexpr uint32_t OuUmmuCr0 = 0x30;
 constexpr uint32_t OuUmmuCr0Ack = 0x34;
 constexpr uint32_t OuUmmuGbpa = 0x50;
@@ -720,6 +721,7 @@ NICTopologySC::ubase_emit_ue2ue_ctrlq_response(
     constexpr uint8_t QueryVl = 1;
     constexpr uint8_t QuerySl = 2;
     constexpr uint8_t DeviceRegisterService = 2;
+    constexpr uint8_t QuerySeid = 0x01;
     constexpr uint8_t NotifyControlPlaneInit = 0x15;
 
     if (request.size() < Ue2ueHeaderBytes + CtrlqHeaderBytes ||
@@ -734,7 +736,9 @@ NICTopologySC::ubase_emit_ue2ue_ctrlq_response(
         (opcode == QuerySl || opcode == QueryVl);
     const bool control_plane_init = service == DeviceRegisterService &&
         opcode == NotifyControlPlaneInit;
-    if (!qos_query && !control_plane_init)
+    const bool seid_query = service == DeviceRegisterService &&
+        opcode == QuerySeid;
+    if (!qos_query && !control_plane_init && !seid_query)
         return false;
 
     const uint16_t requested_output = uint16_t(request[12]) |
@@ -767,6 +771,22 @@ NICTopologySC::ubase_emit_ue2ue_ctrlq_response(
         response[6] = 0x01; // udma_ctp_sl_bitmap = BIT(0)
     } else if (service == QosService) {
         response[0] = 0x01; // vl_bitmap = BIT(0)
+    } else if (seid_query && response_bytes >= 28) {
+        // UDMA_CTRLQ_GET_SEID_INFO returns the control-plane view of the
+        // endpoint enumerated by UBIOS.  Keep this identity tied to the
+        // modeled firmware/configuration image instead of inventing a second
+        // device identity in the UDMA path.
+        constexpr uint32_t EndpointEidRegister = 0x40050;
+        constexpr uint32_t EndpointUpi = 0x7fff;
+        const uint32_t endpoint_eid =
+            (ubios_config_read(EndpointEidRegister, true) >> 20) & 0xfffff;
+        response[0] = 1; // seid_num
+        openurma_udma::storeLe32(response + 4, 0); // eid_idx
+        // union ubcore_eid::raw is an IPv6/network-order byte string.
+        response[8 + 13] = static_cast<uint8_t>(endpoint_eid >> 16);
+        response[8 + 14] = static_cast<uint8_t>(endpoint_eid >> 8);
+        response[8 + 15] = static_cast<uint8_t>(endpoint_eid);
+        openurma_udma::storeLe32(response + 24, EndpointUpi);
     }
 
     constexpr size_t CrqAddrL = 0x18 / 4;
@@ -951,6 +971,86 @@ NICTopologySC::ubase_cmdq_kick(uint32_t new_pi)
                                     continuation.end());
             }
         }
+        std::vector<uint8_t> response;
+        if (opcode == 0x0030) {
+            // QUERY_COMM_RSRC_PARAM.  These are finite functional-model
+            // capacities, not timing calibration knobs.  Offsets follow the
+            // stock 312-byte ubase_res_cmd_resp ABI.
+            response.resize(312, 0);
+            // Leave the direct-register CtrlQ capability clear.  This
+            // generation uses the architected 2048-entry fallback queue;
+            // advertising bit 5 would require non-zero reset values in the
+            // optional depth registers before the driver programs them.
+            ouStoreLe<uint16_t>(response, 26, 1);      // CEQ vectors
+            ouStoreLe<uint16_t>(response, 28, 1);      // AEQ vectors
+            ouStoreLe<uint16_t>(response, 30, 1);      // misc vectors
+            ouStoreLe<uint16_t>(response, 32, 64);     // AEQE bytes
+            ouStoreLe<uint16_t>(response, 34, 64);     // CEQE bytes
+            ouStoreLe<uint16_t>(response, 36, 64);     // UDMA CQE bytes
+            ouStoreLe<uint32_t>(response, 40, 512);    // AEQ depth
+            ouStoreLe<uint32_t>(response, 44, 4096);   // CEQ depth
+            ouStoreLe<uint32_t>(response, 48, 1024);   // UDMA JFS count
+            ouStoreLe<uint32_t>(response, 56, 4096);   // JFS WQEBBs
+            ouStoreLe<uint32_t>(response, 60, 1024);   // UDMA JFR count
+            ouStoreLe<uint32_t>(response, 68, 1024);   // JFR depth
+            ouStoreLe<uint32_t>(response, 84, 1024);   // UDMA JFC count
+            ouStoreLe<uint32_t>(response, 92, 4096);   // JFC depth
+            ouStoreLe<uint32_t>(response, 192, 1);     // one UE
+            ouStoreLe<uint32_t>(response, 224, 1024);  // public jettys
+            response[239] = 1;                         // UE count
+            ouStoreLe<uint32_t>(response, 256, 128);   // RC depth
+            ouStoreLe<uint32_t>(response, 264, 64);    // jetty groups
+            ouStoreLe<uint32_t>(response, 268, 128);   // RC queues/VL
+        } else if (opcode == 0x0002) {
+            // UDMA_CMD_QUERY_UE_RES.  Keep offsets in lock-step with the
+            // stock, naturally aligned struct udma_cmd_ue_resource ABI.
+            response.resize(112, 0);
+            ouStoreLe<uint16_t>(response, 0, 0xaaaa);  // 2^10 resources
+            ouStoreLe<uint16_t>(response, 2, 64);      // jetty groups
+            ouStoreLe<uint16_t>(response, 4, 0x6cac);  // queue/CQE shifts
+            ouStoreLe<uint16_t>(response, 6, 0x1084);  // 4 SGEs each
+            ouStoreLe<uint16_t>(response, 8, 256);     // inline bytes
+            ouStoreLe<uint16_t>(response, 10, 256);
+            ouStoreLe<uint16_t>(response, 16, 0x27);   // RM/RC/UM, one UE
+            ouStoreLe<uint16_t>(response, 18, 1);      // UE count
+            ouStoreLe<uint16_t>(response, 24, 64);     // source table size
+            ouStoreLe<uint16_t>(response, 26, 1);
+            ouStoreLe<uint16_t>(response, 28, 64);     // destination table
+            ouStoreLe<uint16_t>(response, 30, 1);
+            ouStoreLe<uint16_t>(response, 32, 64);     // SEID/UPI table
+            ouStoreLe<uint16_t>(response, 34, 1);
+            response[44] = 1;                          // one port
+            ouStoreLe<uint16_t>(response, 48, 128);    // RC queues
+            ouStoreLe<uint16_t>(response, 50, 128);    // RC depth
+            response[52] = 64;                         // RC entry bytes
+            ouStoreLe<uint16_t>(response, 56, 0);      // public start
+            ouStoreLe<uint16_t>(response, 58, 128);    // public count
+            ouStoreLe<uint16_t>(response, 76, 128);    // standard start
+            ouStoreLe<uint16_t>(response, 78, 896);    // standard count
+            ouStoreLe<uint32_t>(response, 80, 65536);  // max write
+            ouStoreLe<uint32_t>(response, 84, 65536);  // max read
+            ouStoreLe<uint32_t>(response, 88, 8);      // max CAS
+            ouStoreLe<uint32_t>(response, 92, 8);      // max FAA
+        }
+        if (!response.empty()) {
+            const size_t first = std::min<size_t>(response.size(), 24);
+            std::memcpy(desc.data() + 8, response.data(), first);
+            size_t offset = first;
+            for (uint32_t index = 1;
+                 index < descriptor_count && offset < response.size();
+                 ++index) {
+                std::array<uint8_t, DescriptorBytes> continuation{};
+                const size_t chunk = std::min<size_t>(
+                    continuation.size(), response.size() - offset);
+                std::memcpy(continuation.data(), response.data() + offset,
+                            chunk);
+                const uint32_t pos = (head + index) % depth;
+                if (!ummu_dma(base + uint64_t(pos) * DescriptorBytes,
+                              continuation.data(), continuation.size(), true))
+                    break;
+                offset += chunk;
+            }
+        }
         // Hardware owns the descriptor after Tail advances.  Successful
         // completion sets OUT, clears the return code and writes response
         // data in place before publishing the new Head.
@@ -1164,11 +1264,16 @@ NICTopologySC::NICTopologySC(sc_core::sc_module_name nm)
     // Minimal architecture-generic capabilities backed by the behavior in
     // ummu_access(): 2048 TIDs, an 8-bit endpoint tag, one 256-entry MCMDQ,
     // one 256-entry event queue, AArch64 stage-1 translation, 4 KiB pages,
-    // 40-bit output addresses, range/broadcast invalidation and coherency.
+    // 40-bit output addresses, range/broadcast invalidation, coherency and a
+    // 4 KiB-granular MAPT permission-table path.  The official KSVA flow
+    // builds MAPT blocks in guest memory and publishes their addresses through
+    // the same TCT/MCMDQ control path already modeled here.  Enforcing those
+    // permissions on official UDMA data requests is a later data-path gate.
     openurma_udma::storeLe32(ummu_regs_.data() + OuUmmuCap0, 0x00000b08);
     openurma_udma::storeLe32(ummu_regs_.data() + OuUmmuCap1, 0x00042208);
     openurma_udma::storeLe32(ummu_regs_.data() + OuUmmuCap2, 0x00009056);
     openurma_udma::storeLe32(ummu_regs_.data() + OuUmmuCap3, 0x00000010);
+    openurma_udma::storeLe32(ummu_regs_.data() + OuUmmuCap5, 0x00000011);
 
     SC_THREAD(timing_dma_worker);
 
