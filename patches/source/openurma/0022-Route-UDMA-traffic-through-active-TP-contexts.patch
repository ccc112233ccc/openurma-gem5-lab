+uint32_t
+NICTopologySC::peer_port_for_transport(uint32_t tpn, uint8_t op,
+                                       uint32_t dcna,
+                                       uint32_t rtoken) const
+{
+    if (ub_port_count_ <= 1)
+        return 0;
+
+    if (peer_port_selection_ == "legacy-hash") {
+        uint64_t flow_hash = uint64_t(dcna) * 0x9e3779b185ebca87ULL;
+        flow_hash ^= uint64_t(rtoken) * 0xc2b2ae3d27d4eb4fULL;
+        flow_hash ^= uint64_t(op) * 0x165667b19e3779f9ULL;
+        return static_cast<uint32_t>(flow_hash % ub_port_count_);
+    }
+
+    for (const auto &[id, route] : udma_tp_routes_) {
+        (void)id;
+        if (!route.active || tpn < route.tpn_start ||
+            tpn - route.tpn_start >= route.tpn_count)
+            continue;
+        return (route.base_port + tpn - route.tpn_start) % ub_port_count_;
+    }
+
+    // A physical UDMA device never invents a path from application object
+    // fields. Refuse a multi-port transfer until the official control plane
+    // has activated a matching TP instead of silently routing it on port 0.
+    std::cerr << "[NIC peer-route] no active TP route for tpn=" << tpn
+              << "\n";
+    return UINT32_MAX;
+}
