     // walk the ARM64 (4 KB granule, 48-bit) guest page table at ttbr0: VA -> PA.
     uint64_t ou_walk(uint64_t ttbr0, uint64_t va);
     // UDMA's equivalent walker issues every PTE fetch at its already-physical
