+uint64_t
+NICTopologySC::ummu_translate_iova(uint64_t iova)
+{
+    // The advertised generic capability uses linear configuration tables.
+    // Static-server EIDs use the pre-created local OS metadata at TECT tag 0;
+    // that entry points at the TCT containing each DMA domain's ARM64
+    // page-table root.
+    constexpr uint64_t AddressMask = 0x0000fffffffff000ULL;
+    constexpr uint32_t TectTag = 0;
+    constexpr size_t TectEntryBytes = 64;
+    constexpr size_t TctEntryBytes = 64;
+    constexpr size_t TctEntries = 1024;
+
+    const uint64_t tect_base = openurma_udma::loadLe64(
+        ummu_regs_.data() + 0x70) & AddressMask;
+    if (!tect_base)
+        return 0;
+
+    std::array<uint8_t, TectEntryBytes> tect{};
+    if (!ou_dma(tect_base + TectTag * TectEntryBytes,
+                tect.data(), tect.size(), false) ||
+        !(openurma_udma::loadLe64(tect.data()) & 1U))
+        return 0;
+    const uint64_t tct_base = openurma_udma::loadLe64(tect.data() + 8) &
+                              AddressMask;
+    if (!tct_base)
+        return 0;
+
+    std::vector<uint8_t> tct(TctEntries * TctEntryBytes);
+    if (!ou_dma(tct_base, tct.data(), tct.size(), false))
+        return 0;
+    for (size_t tid = 0; tid < TctEntries; ++tid) {
+        const uint8_t *entry = tct.data() + tid * TctEntryBytes;
+        if (!(openurma_udma::loadLe64(entry) & 1U))
+            continue;
+        const uint64_t ttbr = openurma_udma::loadLe64(entry + 16) &
+                              AddressMask;
+        if (!ttbr)
+            continue;
+        const uint64_t pa = ou_walk(ttbr, iova);
+        if (pa)
+            return pa;
+    }
+    return 0;
+}
+
+bool
+NICTopologySC::ummu_dma(uint64_t iova, void *buf, uint32_t len, bool write)
+{
+    auto *bytes = static_cast<uint8_t *>(buf);
+    while (len) {
+        const uint32_t chunk = std::min<uint32_t>(
+            len, 4096U - static_cast<uint32_t>(iova & 0xfff));
+        const uint64_t pa = ummu_translate_iova(iova);
+        if (!pa || !ou_dma(pa, bytes, chunk, write))
+            return false;
+        iova += chunk;
+        bytes += chunk;
+        len -= chunk;
+    }
+    return true;
+}
