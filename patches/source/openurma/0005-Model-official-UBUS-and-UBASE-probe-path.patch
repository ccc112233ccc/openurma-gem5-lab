+bool
+NICTopologySC::ubase_emit_mailbox_event(uint16_t sequence)
+{
+    constexpr uint32_t EntryBytes = 64;
+    constexpr uint8_t MailboxEvent = 0x13;
+    if (!ubase_aeq_iova_ || !ubase_aeq_depth_)
+        return false;
+
+    std::array<uint8_t, EntryBytes> event{};
+    uint32_t header = MailboxEvent;
+    // The official consumer accepts an entry when owner differs from the
+    // wrap bit of its monotonically increasing consumer index.
+    if (!(ubase_aeq_producer_ & ubase_aeq_depth_))
+        header |= 1U << 31;
+    openurma_udma::storeLe32(event.data(), header);
+    event[12] = static_cast<uint8_t>(sequence);
+    event[13] = static_cast<uint8_t>(sequence >> 8);
+    event[14] = 0; // successful mailbox status
+
+    const uint32_t slot = ubase_aeq_producer_ & (ubase_aeq_depth_ - 1);
+    if (!ummu_dma(ubase_aeq_iova_ + uint64_t(slot) * EntryBytes,
+                  event.data(), event.size(), true))
+        return false;
+    ++ubase_aeq_producer_;
+    std::cerr << "[NIC ubase] emitted mailbox AEQ event seq=" << sequence
+              << " slot=" << slot << "\n";
+    return ubase_raise_type1_msi(1);
+}
+
+void
+NICTopologySC::ubase_handle_mailbox(const std::array<uint8_t, 32> &desc)
+{
+    constexpr uint8_t CreateAeqContext = 0x34;
+    const uint64_t context_iova = openurma_udma::loadLe32(desc.data() + 8) |
+        (uint64_t(openurma_udma::loadLe32(desc.data() + 12)) << 32);
+    const uint8_t command = desc[16];
+    const uint32_t control = openurma_udma::loadLe32(desc.data() + 20);
+    const uint16_t sequence = static_cast<uint16_t>(control);
+    const bool event_enabled = control & (1U << 16);
+
+    if (command == CreateAeqContext && context_iova) {
+        std::array<uint8_t, 64> context{};
+        if (ummu_dma(context_iova, context.data(), context.size(), false)) {
+            const uint32_t word1 = openurma_udma::loadLe32(context.data() + 4);
+            const uint32_t word2 = openurma_udma::loadLe32(context.data() + 8);
+            const uint32_t word3 = openurma_udma::loadLe32(context.data() + 12);
+            const uint32_t shift = word1 & 0x1f;
+            if (shift < 26) {
+                ubase_aeq_iova_ =
+                    ((uint64_t(word3) << 20) | (word2 >> 12)) << 12;
+                ubase_aeq_depth_ = 1U << (shift + 6);
+                ubase_aeq_producer_ = 0;
+                std::cerr << "[NIC ubase] captured AEQ iova=0x" << std::hex
+                          << ubase_aeq_iova_ << std::dec
+                          << " depth=" << ubase_aeq_depth_ << "\n";
+            }
+        }
+    }
+
+    if (event_enabled)
+        ubase_emit_mailbox_event(sequence);
+}
