+++ b/eval/twonode/gem5_scaffold/src/NICTopologySC.hh
@@ -500,6 +500,7 @@ class NICTopologySC : public sc_core::sc_module
         uint32_t offset = 0;
         uint64_t request_id = 0;
         uint32_t return_port = UINT32_MAX;
+        uint32_t return_eid = 0;
     };
     struct UdmaWriteRequest {
         uint32_t remote_token_id = 0;
@@ -513,12 +514,15 @@ class NICTopologySC : public sc_core::sc_module
     struct UdmaWriteAck {
         uint64_t request_id = 0;
         uint32_t return_port = UINT32_MAX;
+        uint32_t return_eid = 0;
     };
     struct UdmaTpRoute {
         uint32_t tpid = 0;
         uint32_t tpn_start = 0;
         uint32_t tpn_count = 0;
         uint32_t base_port = 0;
+        uint32_t local_eid = 0;
+        uint32_t remote_eid = 0;
         bool active = false;
     };
     struct UdmaIotlbKey {
@@ -634,9 +638,12 @@ class NICTopologySC : public sc_core::sc_module
                    uint32_t tpn = UINT32_MAX,
                    uint32_t forced_port = UINT32_MAX,
                    uint32_t source_jetty = 0,
-                   uint32_t source_eid = 0);
+                   uint32_t source_eid = 0,
+                   uint32_t destination_eid = 0);
     uint32_t peer_port_for_transport(uint32_t tpn, uint8_t op,
                                      uint32_t dcna, uint32_t rtoken) const;
+    uint32_t peer_eid_for_transport(uint32_t tpn) const;
+    uint32_t adapter_sync_destination_eid() const;
     // pop the oldest posted receive on dest jetty `dj` (used by both the local
     // doorbell path and the cross-node peer path).
     using RecvT = std::tuple<uint32_t, uint32_t, uint64_t, uint64_t, int, uint32_t>;
diff --git a/eval/twonode/gem5_scaffold/src/UbAdapterProtocol.hh b/eval/twonode/gem5_scaffold/src/UbAdapterProtocol.hh
index d9d3454..739a587 100644
--- a/eval/twonode/gem5_scaffold/src/UbAdapterProtocol.hh
+++ b/eval/twonode/gem5_scaffold/src/UbAdapterProtocol.hh
@@ -7,7 +7,7 @@
 namespace openurma_adapter {
 
 constexpr uint64_t Magic = 0x4f55554241445054ULL; // "OUUBADPT"
-constexpr uint32_t Version = 2;
+constexpr uint32_t Version = 3;
 constexpr uint32_t RingSlots = 64;
 constexpr uint32_t SlotBytes = 8192;
 constexpr uint32_t MaxPorts = 16;
@@ -37,7 +37,12 @@ struct alignas(64) MessageHeader {
     uint16_t destination_port;
     uint16_t protocol_version;
     uint16_t flags;
-    uint8_t reserved[24];
+    // Endpoint identities are the low 20-bit UDMA EIDs carried by the
+    // official GET_TP_LIST control path. The switch, rather than either
+    // application, resolves destination_eid to an output adapter.
+    uint32_t source_eid;
+    uint32_t destination_eid;
+    uint8_t reserved[16];
 };
 
 struct alignas(4096) Ring {
@@ -51,7 +56,9 @@ struct alignas(4096) Ring {
     // peer_sync_phase. Odd phases mean active; even phases mean quiesced.
     uint64_t local_sync_phase;
     uint64_t peer_sync_phase;
-    uint8_t control_reserved[4080];
+    uint32_t local_eid;
+    uint32_t sync_destination_eid;
+    uint8_t control_reserved[4072];
 };
 
 static_assert(sizeof(RingIndex) == 64);
