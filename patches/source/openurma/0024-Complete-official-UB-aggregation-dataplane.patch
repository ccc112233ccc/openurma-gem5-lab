+bool
+NICTopologySC::ubase_emit_completion_event(uint32_t jfc_id)
+{
+    constexpr uint32_t EntryBytes = 64;
+    if (!ubase_ceq_iova_ || !ubase_ceq_depth_)
+        return false;
+
+    std::array<uint8_t, EntryBytes> event{};
+    uint32_t completion = jfc_id & 0x000fffffU;
+    // ubase_next_ceqe() accepts an entry when its owner bit differs from the
+    // wrap bit of the monotonically increasing consumer index.
+    if (!(ubase_ceq_producer_ & ubase_ceq_depth_))
+        completion |= 1U << 31;
+    openurma_udma::storeLe32(event.data(), completion);
+
+    const uint32_t slot = ubase_ceq_producer_ & (ubase_ceq_depth_ - 1);
+    if (!ubase_cmdq_dma(ubase_ceq_iova_ + uint64_t(slot) * EntryBytes,
+                        event.data(), event.size(), true))
+        return false;
+    ++ubase_ceq_producer_;
+    if (ou_packet_trace_enabled()) {
+        std::cerr << "[NIC ubase] emitted CEQ event jfc=" << jfc_id
+                  << " slot=" << slot << "\n";
+    }
+    // The stock UBASE vector layout is misc=0, AEQ=1, CEQ0=2.
+    return ubase_raise_type1_msi(2);
 }
 
