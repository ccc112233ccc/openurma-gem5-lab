+bool
+NICTopologySC::ubase_cmdq_dma(uint64_t iova, void *buf, uint32_t len,
+                              bool write)
+{
+    auto *bytes = static_cast<uint8_t *>(buf);
+    while (len) {
+        const uint64_t page = iova & ~uint64_t{0xfff};
+        const uint32_t offset = static_cast<uint32_t>(iova & 0xfff);
+        const uint32_t chunk = std::min<uint32_t>(len, 4096U - offset);
+        auto cached = ubase_cmdq_dma_pages_.find(page);
+        uint64_t physical_page = 0;
+        if (cached != ubase_cmdq_dma_pages_.end()) {
+            physical_page = cached->second;
+        } else {
+            const uint64_t physical = ummu_translate_iova(iova);
+            if (!physical)
+                return false;
+            physical_page = physical - offset;
+            ubase_cmdq_dma_pages_.emplace(page, physical_page);
+        }
+        if (!ou_dma(physical_page + offset, bytes, chunk, write))
+            return false;
+        iova += chunk;
+        bytes += chunk;
+        len -= chunk;
+    }
+    return true;
+}
