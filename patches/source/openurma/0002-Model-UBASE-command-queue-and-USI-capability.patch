+void
+NICTopologySC::ubase_cmdq_kick(uint32_t new_pi)
+{
+    constexpr size_t CsqAddrL = 0x00 / 4;
+    constexpr size_t CsqAddrH = 0x04 / 4;
+    constexpr size_t CsqDepth = 0x08 / 4;
+    constexpr size_t CsqTail = 0x10 / 4;
+    constexpr size_t CsqHead = 0x14 / 4;
+    constexpr uint32_t DescriptorBytes = 32;
+    constexpr uint8_t FlagOut = 1U << 1;
+
+    const uint64_t base = ubase_cmdq_regs_[CsqAddrL] |
+        (uint64_t(ubase_cmdq_regs_[CsqAddrH]) << 32);
+    // The depth register uses units of eight descriptors in this ABI.
+    const uint32_t depth = ubase_cmdq_regs_[CsqDepth] << 3;
+    if (!base || !depth)
+        return;
+
+    uint32_t head = ubase_cmdq_regs_[CsqHead] % depth;
+    const uint32_t tail = new_pi % depth;
+    while (head != tail) {
+        std::array<uint8_t, DescriptorBytes> desc{};
+        const uint64_t pa = base + uint64_t(head) * DescriptorBytes;
+        if (!ou_dma(pa, desc.data(), desc.size(), false)) {
+            std::cerr << "[NIC ubase] failed to read CSQ descriptor pa=0x"
+                      << std::hex << pa << std::dec << "\n";
+            break;
+        }
+
+        const uint16_t opcode = uint16_t(desc[0]) |
+            (uint16_t(desc[1]) << 8);
+        // Hardware owns the descriptor after Tail advances.  Successful
+        // completion sets OUT, clears the return code and writes response
+        // data in place before publishing the new Head.
+        desc[2] |= FlagOut;
+        desc[4] = 0;
+        desc[5] = 0;
+        if (opcode == 0x0001) {
+            // QUERY_FW_VER: four one-byte components, reported as 1.0.0.0.
+            openurma_udma::storeLe32(desc.data() + 8, 0x01000000);
+        }
+        if (!ou_dma(pa, desc.data(), desc.size(), true)) {
+            std::cerr << "[NIC ubase] failed to write CSQ descriptor pa=0x"
+                      << std::hex << pa << std::dec << "\n";
+            break;
+        }
+
+        head = (head + 1) % depth;
+        ubase_cmdq_regs_[CsqHead] = head;
+        std::cerr << "[NIC ubase] completed CSQ opcode=0x" << std::hex
+                  << opcode << std::dec << " head=" << head << "\n";
+    }
+    ubase_cmdq_regs_[CsqTail] = tail;
+}
+
+bool
+NICTopologySC::ubase_cmdq_access(tlm::tlm_command cmd, uint64_t off,
+                                 uint8_t *data, size_t len)
+{
+    if (off < OuUbaseCmdqOffset ||
+        off + len > OuUbaseCmdqOffset + OuUbaseCmdqBytes ||
+        !data || len != sizeof(uint32_t) || (off & 3))
+        return false;
+
+    const size_t index = (off - OuUbaseCmdqOffset) / 4;
+    if (cmd == tlm::TLM_READ_COMMAND) {
+        openurma_udma::storeLe32(data, ubase_cmdq_regs_[index]);
+    } else if (cmd == tlm::TLM_WRITE_COMMAND) {
+        const uint32_t value = openurma_udma::loadLe32(data);
+        ubase_cmdq_regs_[index] = value;
+        // A new CSQ base denotes a fresh ring, including after probe retry.
+        if (index == 0x00 / 4)
+            ubase_cmdq_regs_[0x14 / 4] = 0;
+        if (index == 0x10 / 4)
+            ubase_cmdq_kick(value);
+    } else {
+        return false;
+    }
+    return true;
+}
