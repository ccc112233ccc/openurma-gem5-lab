+bool
+NICTopologySC::ubase_raise_type1_msi(uint32_t vector)
+{
+    // These registers are populated by the stock UBUS MSI code through
+    // configuration messages.  The model consumes the programmed MSI tuple;
+    // it does not assume a particular interrupt controller or SPI number.
+    constexpr uint32_t Enable = 0x40c04;
+    constexpr uint32_t EnabledVectors = 0x40c0c;
+    constexpr uint32_t Data = 0x40c10;
+    constexpr uint32_t AddressLow = 0x40c14;
+    constexpr uint32_t AddressHigh = 0x40c18;
+    constexpr uint32_t Mask = 0x40c20;
+
+    const auto reg = [this](uint32_t address) {
+        const auto it = ubios_endpoint_config_.find(address);
+        return it == ubios_endpoint_config_.end() ? 0U : it->second;
+    };
+    const uint32_t enabled_log2 = reg(EnabledVectors);
+    const uint32_t count = enabled_log2 < 31 ? (1U << enabled_log2) : 0;
+    if (!(reg(Enable) & 1U) || vector >= count ||
+        (reg(Mask) & (1U << vector)))
+        return false;
+
+    const uint64_t address = reg(AddressLow) |
+        (uint64_t(reg(AddressHigh)) << 32);
+    uint32_t data = reg(Data) + vector;
+    if (!system_ || !address || !msi_native_bound_ ||
+        !system_->isAtomicMode())
+        return false;
+
+    // The GICv2m SETSPI register has a write side effect, so this must be a
+    // real atomic MMIO transaction rather than a functional debugger access.
+    gem5::Request::Flags flags;
+    auto request = std::make_shared<gem5::Request>(
+        address, sizeof(data), flags, dma_requestor_id_);
+    gem5::Packet packet(request, gem5::MemCmd::WriteReq);
+    packet.dataStatic(reinterpret_cast<uint8_t *>(&data));
+    msi_port.sendAtomic(&packet);
+    std::cerr << "[NIC ubase] raised Type-1 MSI vector=" << vector
+              << " address=0x" << std::hex << address << " data=0x" << data
+              << std::dec << "\n";
+    return true;
+}
