 }
 
+bool
+NICTopologySC::ubase_misc_access(tlm::tlm_command cmd, uint64_t off,
+                                 uint8_t *data, size_t len)
+{
+    if (off != OuUbaseCmdqSrcOffset || !data || len != sizeof(uint32_t))
+        return false;
+    if (cmd == tlm::TLM_READ_COMMAND) {
+        openurma_udma::storeLe32(data, ubase_cmdq_src_);
+    } else if (cmd == tlm::TLM_WRITE_COMMAND) {
+        // Interrupt source is write-one-to-clear.
+        ubase_cmdq_src_ &= ~openurma_udma::loadLe32(data);
+    } else {
+        return false;
+    }
+    return true;
+}
