+void
+NICTopologySC::ubios_config_write(uint32_t byte_addr, uint32_t byte_enable,
+                                  uint32_t value, bool endpoint)
+{
+    if (!endpoint)
+        return;
+    const uint32_t aligned = byte_addr & ~3U;
+    uint32_t merged = ubios_config_read(aligned, true);
+    for (uint32_t byte = 0; byte < 4; ++byte) {
+        if (byte_enable & (1U << byte)) {
+            const uint32_t mask = 0xffU << (byte * 8);
+            merged = (merged & ~mask) | (value & mask);
+        }
+    }
+    ubios_endpoint_config_[aligned] = merged;
+}
