+bool
+NICTopologySC::ubase_emit_ue2ue_ctrlq_response(
+    const std::vector<uint8_t> &request)
+{
+    constexpr size_t Ue2ueHeaderBytes = 16;
+    constexpr size_t CtrlqHeaderBytes = 12;
+    constexpr size_t CtrlqDataBytes = 20;
+    constexpr size_t DescriptorBytes = 32;
+    constexpr uint8_t FlagOut = 1U << 1;
+    constexpr uint16_t Ue2ueCtrlqSubcommand = 3;
+    constexpr uint8_t QosService = 4;
+    constexpr uint8_t QueryVl = 1;
+    constexpr uint8_t QuerySl = 2;
+    constexpr uint8_t DeviceRegisterService = 2;
+    constexpr uint8_t NotifyControlPlaneInit = 0x15;
+
+    if (request.size() < Ue2ueHeaderBytes + CtrlqHeaderBytes ||
+        (uint16_t(request[4]) | (uint16_t(request[5]) << 8)) !=
+            Ue2ueCtrlqSubcommand)
+        return false;
+
+    const uint8_t *ctrlq = request.data() + Ue2ueHeaderBytes;
+    const uint8_t service = ctrlq[1];
+    const uint8_t opcode = ctrlq[3];
+    const bool qos_query = service == QosService &&
+        (opcode == QuerySl || opcode == QueryVl);
+    const bool control_plane_init = service == DeviceRegisterService &&
+        opcode == NotifyControlPlaneInit;
+    if (!qos_query && !control_plane_init)
+        return false;
+
+    const uint16_t requested_output = uint16_t(request[12]) |
+        (uint16_t(request[13]) << 8);
+    const size_t response_bytes = qos_query ? CtrlqDataBytes :
+        requested_output;
+    std::vector<uint8_t> event(Ue2ueHeaderBytes + CtrlqHeaderBytes +
+                               response_bytes, 0);
+    std::memcpy(event.data(), request.data(), Ue2ueHeaderBytes);
+    // A response carries its payload as input data to the receiver.  Preserve
+    // the UE identities and sequence, but convert the transport direction and
+    // sizes exactly as the official peer-side UBASE code would do.
+    event[10] = static_cast<uint8_t>(response_bytes);
+    event[11] = static_cast<uint8_t>(response_bytes >> 8);
+    event[12] = 0;
+    event[13] = 0;
+    event[14] = 1U << 1; // is_resp
+    // The CRQ callback keys the response by the outer UE2UE sequence.  The
+    // base block mirrors the request identity and reports successful status.
+    std::memcpy(event.data() + Ue2ueHeaderBytes, ctrlq, CtrlqHeaderBytes);
+    uint8_t *response = event.data() + Ue2ueHeaderBytes + CtrlqHeaderBytes;
+    if (service == QosService && opcode == QuerySl) {
+        // Expose SL0 for the NIC itself and for both UDMA transport modes,
+        // plus a finite RC resource count.  These are capability values,
+        // independent of timing.
+        response[0] = 0x01; // unic_sl_bitmap = BIT(0)
+        response[2] = 0x00;
+        response[3] = 0x04; // rc_max_cnt = 1024
+        response[4] = 0x01; // udma_tp_sl_bitmap = BIT(0)
+        response[6] = 0x01; // udma_ctp_sl_bitmap = BIT(0)
+    } else if (service == QosService) {
+        response[0] = 0x01; // vl_bitmap = BIT(0)
+    }
+
+    constexpr size_t CrqAddrL = 0x18 / 4;
+    constexpr size_t CrqAddrH = 0x1c / 4;
+    constexpr size_t CrqDepth = 0x20 / 4;
+    constexpr size_t CrqTail = 0x24 / 4;
+    const uint64_t base = ubase_cmdq_regs_[CrqAddrL] |
+        (uint64_t(ubase_cmdq_regs_[CrqAddrH]) << 32);
+    const uint32_t depth = ubase_cmdq_regs_[CrqDepth] << 3;
+    if (!base || !depth)
+        return false;
+
+    const uint32_t num = static_cast<uint32_t>(
+        (event.size() + 8 + DescriptorBytes - 1) / DescriptorBytes);
+    uint32_t tail = ubase_cmdq_regs_[CrqTail] % depth;
+    size_t event_offset = 0;
+    for (uint32_t index = 0; index < num; ++index) {
+        std::array<uint8_t, DescriptorBytes> desc{};
+        if (index == 0) {
+            desc[0] = 0x0e;
+            desc[1] = 0xf0;
+            desc[2] = FlagOut;
+            desc[3] = static_cast<uint8_t>(num);
+            const size_t chunk = std::min(event.size(), DescriptorBytes - 8);
+            std::memcpy(desc.data() + 8, event.data(), chunk);
+            event_offset = chunk;
+        } else {
+            const size_t chunk = std::min(event.size() - event_offset,
+                                          DescriptorBytes);
+            std::memcpy(desc.data(), event.data() + event_offset, chunk);
+            event_offset += chunk;
+        }
+        if (!ou_dma(base + uint64_t(tail) * DescriptorBytes,
+                    desc.data(), desc.size(), true))
+            return false;
+        tail = (tail + 1) % depth;
+    }
+    ubase_cmdq_regs_[CrqTail] = tail;
+    ubase_cmdq_src_ |= 1U << 1;
+    std::cerr << "[NIC ubase] emitted UE2UE CtrlQ response service="
+              << unsigned(service) << " opcode=0x" << std::hex
+              << unsigned(opcode) << std::dec << " crq_tail=" << tail
+              << "\n";
+    return ubase_raise_type1_msi(0);
+}
