+++ b/eval/twonode/gem5_scaffold/src/NICTopologySC.cc
@@ -632,7 +632,7 @@ NICTopologySC::ubios_msgq_kick(uint32_t new_pi)
                 4 + forward_bytes * ((scan & (1U << 20)) ? 2 : 1);
             const uint32_t response_header_bytes = 16 + 4 + forward_bytes;
             constexpr uint32_t CommonBytes = 24;
-            constexpr uint32_t TlvBytes = 4 + 8 + 28 + 8;
+            const uint32_t TlvBytes = 4 + 8 + 28 * ub_port_count_ + 8;
             const uint32_t extra_bytes = opcode == 0 ? TlvBytes :
                 (opcode == 2 ? 4 : 0);
             response.assign(response_header_bytes + CommonBytes + extra_bytes,
@@ -671,19 +671,32 @@ NICTopologySC::ubios_msgq_kick(uint32_t new_pi)
             uint8_t *extra = response.data() + response_common + CommonBytes;
             if (opcode == 0) {
                 openurma_udma::storeLe32(extra, 0x00040100); // slice 0/1
-                openurma_udma::storeLe32(extra + 4, 0x01080001); // 1 port
-                openurma_udma::storeLe32(extra + 8, 0x00010000); // 1 TLV
-                openurma_udma::storeLe32(extra + 12, 0x021c0100); // link up
-                // port indices and rates remain zero. Remote GUID is the root
-                // controller for the endpoint and the UDMA endpoint for root.
-                openurma_udma::storeLe32(extra + 24, device ? 1 : 2);
-                openurma_udma::storeLe32(extra + 28, 0);
-                openurma_udma::storeLe32(extra + 32,
-                                         device ? 0x12000000 : 0x11000000);
-                openurma_udma::storeLe32(extra + 36,
-                                         device ? 0xcc080000 : 0xcc08a001);
-                openurma_udma::storeLe32(extra + 40, 0x04080000);
-                openurma_udma::storeLe32(extra + 44,
+                openurma_udma::storeLe32(
+                    extra + 4, 0x01080000 | ub_port_count_);
+                openurma_udma::storeLe32(
+                    extra + 8, ub_port_count_ << 16);
+                for (uint32_t port = 0; port < ub_port_count_; ++port) {
+                    uint8_t *port_tlv = extra + 12 + 28 * port;
+                    openurma_udma::storeLe32(port_tlv, 0x021c0100); // link up
+                    openurma_udma::storeLe32(
+                        port_tlv + 4, port | (port << 16));
+                    // The topology ABI uses compact rate codes, not Mb/s.
+                    // Leave those codes at zero; UDMA_CMD_QUERY_PORT_INFO is
+                    // the authoritative 400-Gbit/s capability query.
+                    // Remote GUID is the root controller for the endpoint and
+                    // the UDMA endpoint for root; only the port index differs.
+                    openurma_udma::storeLe32(port_tlv + 12, device ? 1 : 2);
+                    openurma_udma::storeLe32(port_tlv + 16, 0);
+                    openurma_udma::storeLe32(
+                        port_tlv + 20,
+                        device ? 0x12000000 : 0x11000000);
+                    openurma_udma::storeLe32(
+                        port_tlv + 24,
+                        device ? 0xcc080000 : 0xcc08a001);
+                }
+                uint8_t *cap_tlv = extra + 12 + 28 * ub_port_count_;
+                openurma_udma::storeLe32(cap_tlv, 0x04080000);
+                openurma_udma::storeLe32(cap_tlv + 4,
                                          device ? 0x0002 : 0x0000);
             } else if (opcode == 2) {
                 // NA query response; use stable non-zero CNAs per hop.
@@ -3712,7 +3725,14 @@ NICTopologySC::~NICTopologySC()
               << " udma_rx_packets=" << udma_rx_packets_
