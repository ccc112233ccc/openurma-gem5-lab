 }
@@ -3743,8 +3763,11 @@ NICTopologySC::peer_ring_map()
               << " tx_dir=" << tx_dir_ << " rx_dir=" << rx_dir_ << "\n";
 }
 
-// Drain packets in FIFO order.  A CQ poll returns empty while the head packet is
-// still in flight; DATA is never applied before arrival_tick.  The
+// Drain packets in publication order.  Different physical ports have independent
+// serialization timelines, so their arrival ticks need not be globally monotonic.
+// The shared-memory transport is deliberately conservative: a later-published
+// packet waits behind an earlier-published packet even if its own port would have
+// delivered it first.  DATA is still never applied before arrival_tick.  The
 // dist-gem5 barrier (quantum <= peer_link_latency_) guarantees the producer has
 // physically published the slot before the receiver can pass that safe horizon.
 void
@@ -3772,18 +3795,14 @@ NICTopologySC::peer_ring_drain(sc_core::sc_time &delay)
                      checked_tick_sum(hdr->tx_tick, minimum_path),
                  "peer ring slot %llu violates configured causal path",
                  (unsigned long long)tail);
-        panic_if(peer_last_rx_arrival_ != 0 &&
-                 hdr->arrival_tick < peer_last_rx_arrival_,
-                 "peer ring timestamps are not monotonic at slot %llu",
-                 (unsigned long long)tail);
-
         const gem5::Tick effective_now = checked_tick_sum(
             gem5::curTick(), delay.value());
         if (hdr->arrival_tick > effective_now)
             break;
 
         peer_apply(s + sizeof(*hdr), hdr->plen);
-        peer_last_rx_arrival_ = hdr->arrival_tick;
+        peer_last_rx_arrival_ = std::max(peer_last_rx_arrival_,
+                                         hdr->arrival_tick);
         if (ou_packet_trace_enabled()) {
             std::cerr << "[NIC peer-rx ring] seq=" << hdr->seq
                       << " tx=" << hdr->tx_tick
@@ -3853,19 +3872,32 @@ NICTopologySC::peer_send(uint8_t op, uint32_t dcna, uint32_t rtoken, uint64_t rv
     const uint64_t wire_bytes = static_cast<uint64_t>(payload_bytes) +
                                 peer_link_overhead_bytes_;
     const gem5::Tick serialization = serialization_ticks(wire_bytes);
-    if (peer_stage_free_ticks_.size() != peer_serialization_stages_) {
-        peer_stage_free_ticks_.assign(peer_serialization_stages_, 0);
-    }
+    // Keep every transport flow on one physical port so ordering is preserved,
+    // while independent jetty/token flows can occupy separate SerDes queues.
+    uint64_t flow_hash = uint64_t(dcna) * 0x9e3779b185ebca87ULL;
+    flow_hash ^= uint64_t(rtoken) * 0xc2b2ae3d27d4eb4fULL;
+    flow_hash ^= uint64_t(op) * 0x165667b19e3779f9ULL;
+    const uint32_t port = static_cast<uint32_t>(flow_hash % ub_port_count_);
+    if (peer_port_stage_free_ticks_.size() != ub_port_count_) {
+        peer_port_stage_free_ticks_.assign(
+            ub_port_count_,
+            std::vector<gem5::Tick>(peer_serialization_stages_, 0));
+        peer_port_packets_.assign(ub_port_count_, 0);
+        peer_port_bytes_.assign(ub_port_count_, 0);
+    }
+    auto &stage_free_ticks = peer_port_stage_free_ticks_[port];
     gem5::Tick arrival_tick = tx_tick;
     for (uint32_t stage = 0; stage < peer_serialization_stages_;
          ++stage) {
         const gem5::Tick start = std::max(
-            arrival_tick, peer_stage_free_ticks_[stage]);
+            arrival_tick, stage_free_ticks[stage]);
         arrival_tick = checked_tick_sum(start, serialization);
-        peer_stage_free_ticks_[stage] = arrival_tick;
+        stage_free_ticks[stage] = arrival_tick;
     }
-    peer_tx_free_tick_ = peer_stage_free_ticks_.empty() ?
-        tx_tick : peer_stage_free_ticks_.front();
+    peer_tx_free_tick_ = stage_free_ticks.empty() ?
+        tx_tick : stage_free_ticks.front();
+    ++peer_port_packets_[port];
+    peer_port_bytes_[port] += wire_bytes;
     arrival_tick = checked_tick_sum(arrival_tick, peer_switch_delay_);
     arrival_tick = checked_tick_sum(arrival_tick, peer_link_latency_);
     link_ticks_ = checked_tick_sum(link_ticks_, arrival_tick - tx_tick);
@@ -3896,6 +3928,7 @@ NICTopologySC::peer_send(uint8_t op, uint32_t dcna, uint32_t rtoken, uint64_t rv
         __atomic_store_n(&d.head.value, head + 1, __ATOMIC_RELEASE);
         if (ou_packet_trace_enabled()) {
             std::cerr << "[NIC peer-tx ring] seq=" << hdr->seq
+                      << " port=" << port
                       << " op=0x" << std::hex << (int)op << std::dec
                       << " len=" << len << " tx=" << tx_tick
                       << " arrival=" << arrival_tick << "\n";
@@ -4771,6 +4804,9 @@ gem5::NICTopologySCParams::create() const
     nic->peer_ring_path_ = peer_ring_path;
     nic->peer_link_latency_ = peer_link_latency;
     nic->peer_link_ticks_per_byte_ = peer_link_rate;
+    panic_if(ub_port_count == 0 || ub_port_count > 16,
+             "ub_port_count must be between 1 and 16");
+    nic->ub_port_count_ = ub_port_count;
     nic->peer_serialization_stages_ = peer_serialization_stages;
     nic->peer_switch_delay_ = peer_switch_delay;
     nic->peer_link_overhead_bytes_ = peer_link_overhead_bytes;
