+void
+NICTopologySC::udma_process_rma_peer_work()
+{
+    while (!udma_write_acks_.empty() && peer_ring_tx_available() != 0) {
+        const uint64_t request_id = udma_write_acks_.front();
+        udma_write_acks_.pop_front();
+        peer_send(OU_UDMA_PEER_WRITE_ACK, 0, 0, 0, 0, request_id, 0,
+                  nullptr, gem5::curTick());
+    }
+
+    while (!udma_read_requests_.empty() &&
+           peer_ring_tx_available() != 0) {
+        UdmaReadRequest &request = udma_read_requests_.front();
+        const uint32_t chunk = std::min<uint32_t>(
+            request.length - request.offset, OU_PEER_MAX_PAYLOAD);
+        std::vector<uint8_t> payload(chunk);
+        if (!ummu_dma_remote_segment(request.remote_token_id,
+                                     request.remote_va + request.offset,
+                                     payload.data(), chunk, false)) {
+            ++udma_queue_errors_;
+            udma_read_requests_.pop_front();
+            continue;
+        }
+        const bool last = request.offset + chunk == request.length;
+        peer_send(OU_UDMA_PEER_READ_RESP, 0, 0, request.offset, chunk,
+                  request.request_id, last ? 1 : 0, payload.data(),
+                  gem5::curTick());
+        request.offset += chunk;
+        if (last)
+            udma_read_requests_.pop_front();
+    }
+}
