+bool
+NICTopologySC::ummu_dma_remote_segment(uint32_t segment_id, uint64_t iova,
+                                       void *buf, uint32_t len, bool write)
+{
+    if (!buf || !len)
+        return false;
+
+    // The imported segment ID in an official RMA WQE is the remote access
+    // handle.  Address translation itself belongs to the receiving process's
+    // active local DMA context, and the two identifiers need not be equal.
+    // Prefer the direct TCT entry when they do match, then dynamically resolve
+    // the VA through the active local TCT instead of hard-coding a process TID.
+    auto *bytes = static_cast<uint8_t *>(buf);
+    bool used_context_lookup = false;
+    while (len) {
+        const uint32_t chunk = std::min<uint32_t>(
+            len, 4096U - static_cast<uint32_t>(iova & 0xfff));
+        uint64_t pa = ummu_translate_iova_tid(segment_id, iova);
+        if (!pa) {
+            pa = ummu_translate_iova(iova);
+            used_context_lookup = true;
+        }
+        if (!pa || !ou_dma(pa, bytes, chunk, write))
+            return false;
+        iova += chunk;
+        bytes += chunk;
+        len -= chunk;
+    }
+    if (used_context_lookup && ou_packet_trace_enabled()) {
+        std::cerr << "[NIC udma] remote segment " << segment_id
+                  << " resolved through active local DMA context\n";
+    }
+    return true;
+}
