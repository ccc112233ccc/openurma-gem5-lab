+constexpr uint64_t OuUbiosUmmuOffset = 0x11c00;
 constexpr uint64_t OuUbiosMsgqOffset = 0x12000;
 constexpr uint64_t OuUbiosHpaOffset = 0x20000;
 constexpr uint64_t OuUbiosHpaSize = 0x00e00000;
@@ -168,6 +169,21 @@ constexpr uint64_t OuUbaseIoOffset = 0x00300000;
 constexpr uint64_t OuUbaseCmdqSrcOffset = OuUbaseIoOffset + 0x18004;
 constexpr uint64_t OuUbaseCmdqOffset = OuUbaseIoOffset + 0x18400;
 constexpr uint64_t OuUbaseCmdqBytes = 0x2c;
+constexpr uint64_t OuUmmuIoOffset = 0x00f00000;
+constexpr uint64_t OuUmmuIoBytes = 0x5000;
+
+constexpr uint32_t OuUmmuCap0 = 0x10;
+constexpr uint32_t OuUmmuCap1 = 0x14;
+constexpr uint32_t OuUmmuCap2 = 0x18;
+constexpr uint32_t OuUmmuCap3 = 0x1c;
+constexpr uint32_t OuUmmuCr0 = 0x30;
+constexpr uint32_t OuUmmuCr0Ack = 0x34;
+constexpr uint32_t OuUmmuGbpa = 0x50;
+constexpr uint32_t OuUmmuMcmdqOffset = 0x100;
+constexpr uint32_t OuUmmuMcmdqStride = 0x10;
+constexpr uint32_t OuUmmuMcmdqProd = 0x8;
+constexpr uint32_t OuUmmuMcmdqCons = 0xc;
+constexpr uint32_t OuUmmuMcmdqEnable = 1U << 31;
 
 template <class T>
