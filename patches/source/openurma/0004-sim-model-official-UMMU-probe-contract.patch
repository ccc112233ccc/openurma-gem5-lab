+    // device before UBUS entities refer to ummu_map 0.
+    ouStoreLe<uint64_t>(table, 40, base + OuUbiosUmmuOffset);
+    ouStoreLe<uint64_t>(table, 48, base + OuUbiosUbcOffset);
     return table;
 }
 
@@ -214,7 +233,7 @@ ouBuildUbiosUbc(uint64_t base)
     ouStoreLe<uint64_t>(table, node + 16, OuUbiosHpaSize);
     table[node + 24] = 48;                   // addressable width
     table[node + 25] = 1;                    // coherent DMA
-    ouStoreLe<uint16_t>(table, node + 26, 0xffff); // no UMMU table yet
+    ouStoreLe<uint16_t>(table, node + 26, 0);      // UMMU table index 0
     ouStoreLe<uint16_t>(table, node + 28, 0);
