     // The first official-driver milestone exposes a real firmware-discovered
     // controller and a reserved message-queue aperture. Queue semantics are
     // added incrementally; reads are deterministic and writes are retained as
diff --git a/eval/twonode/gem5_scaffold/src/NICTopologySC.hh b/eval/twonode/gem5_scaffold/src/NICTopologySC.hh
index ba02fb2..10fc6ed 100644
--- a/eval/twonode/gem5_scaffold/src/NICTopologySC.hh
+++ b/eval/twonode/gem5_scaffold/src/NICTopologySC.hh
@@ -267,6 +267,12 @@ class NICTopologySC : public sc_core::sc_module
     uint32_t ubios_root_cna_ = 0;
     uint32_t ubios_endpoint_cna_ = 0;
     std::unordered_map<uint32_t, uint32_t> ubios_endpoint_config_;
+    // Architecture-generic UMMU register aperture.  Capability registers are
+    // synthesized by the model while writable state is retained byte-for-byte
+    // so the stock driver can use both 32-bit and 64-bit MMIO accesses.
+    std::array<uint8_t, 0x5000> ummu_regs_{};
+    bool ummu_access(tlm::tlm_command cmd, uint64_t off,
+                     uint8_t *data, size_t len);
     // UBASE command queue lives in endpoint resource 2 (the IO resource).
     // The stock driver programs a coherent CSQ/CRQ pair here and rings CSQ
     // tail after publishing one or more 32-byte descriptors.
