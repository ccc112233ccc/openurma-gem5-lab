 }
 
+std::vector<uint8_t>
+ouBuildUbiosUmmu(uint64_t base)
+{
+    // Linux ABI: 32-byte ub_table_header, 8-byte count/reserved area, then
+    // one naturally aligned 160-byte struct ummu_node.
+    std::vector<uint8_t> table(40 + 160, 0);
+    const char name[] = "ummu";
+    std::memcpy(table.data(), name, sizeof(name) - 1);
+    ouStoreLe<uint32_t>(table, 16, table.size());
+    table[20] = 1;
+    ouStoreLe<uint16_t>(table, 32, 1);
+
+    const size_t node = 40;
+    ouStoreLe<uint64_t>(table, node + 0, base + OuUmmuIoOffset);
+    ouStoreLe<uint64_t>(table, node + 8, OuUmmuIoBytes);
+    ouStoreLe<uint32_t>(table, node + 16, 0);
+    ouStoreLe<uint16_t>(table, node + 20, 0xffff); // no NUMA proximity
+    ouStoreLe<uint16_t>(table, node + 22, 0);
+    ouStoreLe<uint32_t>(table, node + 44, 1);      // minimum TID
+    ouStoreLe<uint32_t>(table, node + 48, 2048);   // maximum TID
+    // Keep vendor_id zero: select the architecture-generic UMMU behavior.
+    ouStoreLe<uint16_t>(table, node + 78, 0);
+    return table;
+}
