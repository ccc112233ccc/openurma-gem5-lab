     SC_THREAD(timing_dma_worker);
 
     if (impl_->cqe_stream) impl_->cqe_stream->out_1.bind(_cqe_tap);
@@ -3062,6 +3170,11 @@ NICTopologySC::mmio_b(tlm::tlm_generic_payload &trans,
         return;
     }
 
