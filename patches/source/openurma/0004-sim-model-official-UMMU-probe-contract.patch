 bool
 ouReadFirmwareTable(uint64_t base, uint64_t off, uint8_t *data, size_t len)
 {
     std::vector<uint8_t> table;
     uint64_t table_offset = 0;
-    if (off >= OuUbiosRootOffset && off < OuUbiosRootOffset + 48) {
+    if (off >= OuUbiosRootOffset && off < OuUbiosRootOffset + 56) {
         table = ouBuildUbiosRoot(base);
         table_offset = OuUbiosRootOffset;
     } else if (off >= OuUbiosUbcOffset && off < OuUbiosUbcOffset + 440) {
         table = ouBuildUbiosUbc(base);
         table_offset = OuUbiosUbcOffset;
+    } else if (off >= OuUbiosUmmuOffset &&
+               off < OuUbiosUmmuOffset + 200) {
+        table = ouBuildUbiosUmmu(base);
+        table_offset = OuUbiosUmmuOffset;
     } else {
         return false;
     }
@@ -248,6 +296,57 @@ ouReadFirmwareTable(uint64_t base, uint64_t off, uint8_t *data, size_t len)
 
 } // anonymous namespace
 
+bool
+NICTopologySC::ummu_access(tlm::tlm_command cmd, uint64_t off,
+                           uint8_t *data, size_t len)
+{
+    if (off < OuUmmuIoOffset || off + len > OuUmmuIoOffset + OuUmmuIoBytes ||
+        !data || !len)
+        return false;
+
+    const uint32_t reg = static_cast<uint32_t>(off - OuUmmuIoOffset);
+    if (cmd == tlm::TLM_READ_COMMAND) {
+        std::memcpy(data, ummu_regs_.data() + reg, len);
+        return true;
+    }
+    if (cmd != tlm::TLM_WRITE_COMMAND)
+        return false;
+
+    std::memcpy(ummu_regs_.data() + reg, data, len);
+
+    // Architectural register handshakes complete synchronously in this
+    // functional model.  The driver still executes its normal polling paths.
+    if (reg <= OuUmmuCr0 && reg + len >= OuUmmuCr0 + sizeof(uint32_t)) {
+        std::memcpy(ummu_regs_.data() + OuUmmuCr0Ack,
+                    ummu_regs_.data() + OuUmmuCr0, sizeof(uint32_t));
+    }
+    if (reg <= OuUmmuGbpa && reg + len >= OuUmmuGbpa + sizeof(uint32_t)) {
+        uint32_t gbpa = openurma_udma::loadLe32(
+            ummu_regs_.data() + OuUmmuGbpa);
+        gbpa &= ~(1U << 31); // hardware clears GBPA.UPDATE after applying it
+        openurma_udma::storeLe32(ummu_regs_.data() + OuUmmuGbpa, gbpa);
+    }
+
+    // Each modeled MCMDQ consumes all published commands immediately.  Bit 31
+    // in CONS is the queue-enable acknowledgement; the remaining index/wrap
+    // bits follow PROD.  This is sufficient for the official driver's queue
+    // ordering and CMD_SYNC polling contract without inventing translations.
+    if (reg >= OuUmmuMcmdqOffset &&
+        reg < OuUmmuMcmdqOffset + 0x1000) {
+        const uint32_t local = (reg - OuUmmuMcmdqOffset) %
+                               OuUmmuMcmdqStride;
+        if (local == OuUmmuMcmdqProd && len == sizeof(uint32_t)) {
+            const uint32_t prod = openurma_udma::loadLe32(data);
+            const uint32_t queue = reg - local;
+            const uint32_t cons = prod & ~OuUmmuMcmdqEnable;
+            openurma_udma::storeLe32(
+                ummu_regs_.data() + queue + OuUmmuMcmdqCons,
+                cons | (prod & OuUmmuMcmdqEnable));
+        }
+    }
+    return true;
+}
