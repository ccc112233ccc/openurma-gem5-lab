#!/bin/sh
if [ -z "${UBSIM_NODE:-}" ]; then
    echo "ubsim-enable-sync is only valid in a dual-node guest" >&2
    exit 1
fi

# This pseudo-op is a collective operation: the host must invoke this script
# on both guests concurrently.  Once both event queues enter conservative
# synchronization, it is safe to enable the OOB IPv4 control path.
/usr/bin/ubsim-dist-sync || exit $?
exec ip addr replace "10.0.0.$((UBSIM_NODE + 1))/24" dev eth0
