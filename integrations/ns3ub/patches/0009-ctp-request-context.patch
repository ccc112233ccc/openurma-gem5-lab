+/** Simulator-only immutable-by-value request context, independent of source WQE lifetime.
+ * This tag is not a UB header and must never override decoded address/token/length.
+ */
+class UbExternalRequestTag : public Tag {
+public:
+    UbExternalRequestTag() = default;
+    UbExternalRequestTag(const std::vector<uint8_t>& context, uint32_t offset)
+        : m_context(context), m_offset(offset)
+    {
+        NS_ABORT_MSG_IF(context.size() > 4096, "external request context exceeds 4096 bytes");
+    }
+    static TypeId GetTypeId()
+    {
+        static TypeId tid = TypeId("ns3::UbExternalRequestTag")
+                               .SetParent<Tag>().AddConstructor<UbExternalRequestTag>();
+        return tid;
+    }
+    TypeId GetInstanceTypeId() const override { return GetTypeId(); }
+    uint32_t GetSerializedSize() const override { return 8 + m_context.size(); }
+    void Serialize(TagBuffer buffer) const override
+    {
+        buffer.WriteU32(m_offset);
+        buffer.WriteU32(m_context.size());
+        for (uint8_t byte : m_context) buffer.WriteU8(byte);
+    }
+    void Deserialize(TagBuffer buffer) override
+    {
+        m_offset = buffer.ReadU32();
+        const uint32_t size = buffer.ReadU32();
+        NS_ABORT_MSG_IF(size > 4096, "external request context exceeds 4096 bytes");
+        m_context.resize(size);
+        for (auto& byte : m_context) byte = buffer.ReadU8();
+    }
+    void Print(std::ostream& os) const override
+    {
+        os << "ExternalRequestContextBytes:" << m_context.size()
+           << " SegmentOffset:" << m_offset;
+    }
+    const std::vector<uint8_t>& GetContext() const { return m_context; }
+    uint32_t GetOffset() const { return m_offset; }
+private:
+    std::vector<uint8_t> m_context;
+    uint32_t m_offset{0};
 };
 
