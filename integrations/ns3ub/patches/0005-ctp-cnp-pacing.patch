+void
+UbCtpTransportService::SetCongestionLineRate(uint64_t bitsPerSecond)
+{
+    NS_ABORT_MSG_IF(bitsPerSecond == 0, "CTP congestion line rate must be positive");
+    m_congestionLineRateBitsPerSecond = bitsPerSecond;
+}
+
+void
+UbCtpTransportService::SetCongestionMinimumRate(uint64_t bitsPerSecond)
+{
+    NS_ABORT_MSG_IF(bitsPerSecond == 0, "CTP congestion minimum rate must be positive");
+    m_congestionMinimumRateBitsPerSecond = bitsPerSecond;
+}
+
+uint64_t
+UbCtpTransportService::GetCongestionRate(const UbCtpEntityKey& key) const
+{
+    auto state = m_congestionStates.find(MakeCongestionKey(key));
+    return state == m_congestionStates.end() || state->second.rateBitsPerSecond == 0
+               ? m_congestionLineRateBitsPerSecond
+               : state->second.rateBitsPerSecond;
+}
