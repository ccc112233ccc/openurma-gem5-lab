+UbCtpCongestionKey
+UbCtpTransportService::MakeCongestionKey(const UbCtpEntityKey& key) const
+{
+    return {.dstNodeId = key.dstNodeId, .dstEntityId = key.dstEntityId, .vl = key.vl};
+}
+
+bool
+UbCtpTransportService::IsCongestionPacingBlocked(const UbCtpEntityKey& entityKey,
+                                                 const UbCtpEntityKey& packetKey)
+{
+    const UbCtpCongestionKey congestionKey = MakeCongestionKey(packetKey);
+    auto state = m_congestionStates.find(congestionKey);
+    if (state == m_congestionStates.end() || state->second.nextSend <= Simulator::Now())
+        return false;
+    if (!state->second.wakeEvent.IsPending())
+    {
+        state->second.wakeEvent = Simulator::Schedule(
+            state->second.nextSend - Simulator::Now(),
+            &UbCtpTransportService::HandleCongestionPacingWake,
+            this,
+            entityKey,
+            congestionKey);
+    }
+    return true;
+}
+
+void
+UbCtpTransportService::AdvanceCongestionPacing(const UbCtpEntityKey& packetKey,
+                                               uint32_t bytes)
+{
+    auto state = m_congestionStates.find(MakeCongestionKey(packetKey));
+    if (state == m_congestionStates.end() || state->second.rateBitsPerSecond == 0)
+        return;
+    const uint64_t numerator = static_cast<uint64_t>(bytes) * 8ULL * 1000000000000ULL;
+    const uint64_t intervalPs =
+        (numerator + state->second.rateBitsPerSecond - 1) /
+        state->second.rateBitsPerSecond;
+    state->second.nextSend = std::max(state->second.nextSend, Simulator::Now()) +
+                             PicoSeconds(intervalPs);
+}
+
+void
+UbCtpTransportService::HandleCongestionPacingWake(UbCtpEntityKey entityKey,
+                                                  UbCtpCongestionKey congestionKey)
+{
+    auto state = m_congestionStates.find(congestionKey);
+    if (state != m_congestionStates.end())
+        state->second.wakeEvent = EventId();
+    TryContinueJettyTransmission(entityKey);
+}
