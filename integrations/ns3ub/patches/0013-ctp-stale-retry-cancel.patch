+
+void UbCbfc::RememberReservation(Ptr<Packet> packet, EgressReservation reservation)
+{
+    NS_ABORT_MSG_IF(m_egressReservations.contains(PeekPointer(packet)),
+                    "duplicate CBFC egress reservation");
+    if (TryAttachPiggybackCredit(packet)) {
+        UbDatalinkPacketHeader header;
+        packet->PeekHeader(header);
+        reservation.piggyVl = header.GetCreditTargetVL();
+        reservation.piggyCells = m_cbfcCfg.m_retCellGrainDataPacket;
+    }
+    m_egressReservations.emplace(PeekPointer(packet), reservation);
+}
+
+void UbCbfc::OnEgressTransmitted(const UbFlowControlEventContext& context)
+{
+    m_egressReservations.erase(PeekPointer(context.packet));
+}
+
+void UbCbfc::OnEgressCancelled(const UbFlowControlEventContext& context)
+{
+    auto it = m_egressReservations.find(PeekPointer(context.packet));
+    // Control frames / detached transmissions do not reserve data credits.
+    if (it == m_egressReservations.end()) return;
+    const auto reservation = it->second;
+    m_egressReservations.erase(it);
+    m_crdTxfree.at(reservation.vl) += reservation.dedicated;
+    RestoreSharedReservation(reservation.shared);
+    m_crdToReturn.at(reservation.piggyVl) += reservation.piggyCells;
+    MaybeQueueControlReturn(m_portId);
 }
 
+void UbCbfc::RestoreSharedReservation(int32_t cells)
+{
+    NS_ABORT_MSG_IF(cells != 0, "shared credit reservation on dedicated CBFC");
+}
+
+void UbCbfcSharedCredit::RestoreSharedReservation(int32_t cells)
+{
+    m_shareCrd += cells;
+}
