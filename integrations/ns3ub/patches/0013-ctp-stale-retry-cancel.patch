+bool
+UbCtpTransportService::CancelStaleQueuedRequest(Ptr<Packet> packet)
+{
+    CtpRequestAttemptTag tag;
+    if (!packet->PeekPacketTag(tag) || m_node == nullptr || tag.node != m_node->GetId()) return false;
+    const auto record = m_retransmissionRecords.find({tag.key, tag.tassn});
+    auto* state = GetTransactionOwner()->FindCtpTransactionState(tag.key);
+    const bool stale = record == m_retransmissionRecords.end() || record->second.sent ||
+        record->second.generation != tag.generation || record->second.attempts != tag.attempt ||
+        state == nullptr || !state->outstandingSegments.contains(tag.tassn);
+    if (stale && tag.attempt != 0) ++m_cancelledRetryCount;
+    return stale;
+}
