+bool
+UbCtpTransportService::IsWireLimited(UbCtpEntityKey key, uint32_t port)
+{
+    auto it = m_congestionStates.find(MakeCongestionKey(key));
+    if (it == m_congestionStates.end() || it->second.nextWireSend <= Simulator::Now())
+        return false;
+    auto& state = it->second;
+    ++m_wirePacingWaits;
+    state.wirePorts.insert(port);
+    if (!state.wireWakeEvent.IsPending()) {
+        const auto ck = MakeCongestionKey(key);
+        state.wireWakeEvent = Simulator::Schedule(state.nextWireSend - Simulator::Now(),
+            [this, ck] {
+                auto it = m_congestionStates.find(ck);
+                if (it == m_congestionStates.end()) return;
+                it->second.wireWakeEvent = EventId();
+                auto ports = std::move(it->second.wirePorts);
+                it->second.wirePorts.clear();
+                for (auto p : ports) DynamicCast<UbPort>(m_node->GetDevice(p))->TriggerTransmit();
+            });
+    }
+    return true;
+}
+
+void
+UbCtpTransportService::AdvanceWirePacing(UbCtpEntityKey key, uint32_t bytes)
+{
+    const auto rate = GetCongestionRate(key);
+    auto it = m_congestionStates.find(MakeCongestionKey(key));
+    if (it == m_congestionStates.end()) return;
+    const uint64_t ps = (static_cast<uint64_t>(bytes) * 8000000000000ULL + rate - 1) / rate;
+    it->second.nextWireSend = Simulator::Now() + PicoSeconds(ps);
+}
+
+void
+UbCtpTransportService::SendCongestionFeedback(const UbCtpEntityKey& key, uint32_t ingressPort)
+{
+    auto last = m_lastCnp.find(key);
+    if (last != m_lastCnp.end() && Simulator::Now() - last->second < m_cnpFeedbackInterval)
+    {
+        ++m_cnpSuppressed;
+        return;
+    }
+    m_lastCnp[key] = Simulator::Now();
+    Ptr<Packet> packet = Create<Packet>();
+    UbCompactEidHeader eid;
+    eid.SetSourceEid(key.srcEntityId);
+    eid.SetDestinationEid(key.dstEntityId);
+    packet->AddHeader(eid);
+    UbCompactUpiHeader upi;
+    upi.SetUpi(0);
+    packet->AddHeader(upi);
+    UbCtpHeader ctp;
+    ctp.SetTPOpcode(CtpOpcode::CTP_CNP);
+    ctp.SetNlp(UB_CTPH_NLP_UPI16_EID40_TAH);
+    packet->AddHeader(ctp);
+    UbCna16NetworkHeader cna;
+    cna.SetScna(utils::NodeIdToCna16(m_node->GetId(), ingressPort));
+    cna.SetDcna(utils::NodeIdToCna16(key.dstNodeId));
+    cna.SetServiceLevel(key.vl);
+    cna.SetNlp(UB_CNA_NLP_CTPH);
+    packet->AddHeader(cna);
+    UbDataLink::AddPacketHeader(packet, false, false, key.vl, key.vl,
+        RoutingType::PER_FLOW_SHORTEST_PATHS, UbDatalinkHeaderConfig::PACKET_CNA16);
+    auto queue = GetOrCreateQueue(key, ingressPort, key.vl);
+    RegisterQueueIfNeeded(queue, ingressPort, key.vl);
+    queue->EnqueueCnp(packet);
+    ++m_cnpSent;
+    DynamicCast<UbPort>(m_node->GetDevice(ingressPort))->TriggerTransmit();
+}
