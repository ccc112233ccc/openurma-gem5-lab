+void
+UbCtpTransportService::ArmRetransmission(const UbCtpEntityKey& stateKey,
+                                         const UbCtpEntityKey& packetKey,
+                                         uint32_t taSsn,
+                                         uint32_t outPort,
+                                         uint32_t priority,
+                                         Ptr<Packet> packet)
+{
+    if (!m_retransmissionEnabled)
+    {
+        return;
+    }
+    const auto key = std::make_pair(stateKey, taSsn);
+    auto [record, inserted] = m_retransmissionRecords.try_emplace(key);
+    if (inserted)
+    {
+        record->second.packetKey = packetKey;
+        record->second.outPort = outPort;
+        record->second.priority = priority;
+        record->second.packet = packet->Copy();
+    }
+    const uint64_t token = m_retransmissionEvents.Track(m_lifecycleOwner);
+    EventId event = Simulator::Schedule(m_retransmissionTimeout,
+                                        &UbCtpTransportService::HandleRetransmissionTimeout,
+                                        this,
+                                        stateKey,
+                                        taSsn,
+                                        token);
+    m_retransmissionEvents.Attach(m_lifecycleOwner, token, event, {});
+}
+
+void
+UbCtpTransportService::HandleRetransmissionTimeout(UbCtpEntityKey stateKey,
+                                                   uint32_t taSsn,
+                                                   uint64_t token)
+{
+    if (!m_retransmissionEvents.Begin(m_lifecycleOwner, token))
+    {
+        return;
+    }
+    const auto key = std::make_pair(stateKey, taSsn);
+    auto record = m_retransmissionRecords.find(key);
+    if (record == m_retransmissionRecords.end())
+    {
+        m_retransmissionEvents.Resolve(m_lifecycleOwner, token);
+        return;
+    }
+    if (record->second.attempts >= m_maxRetransmissionAttempts)
+    {
+        ++m_retransmissionExhaustedCount;
+        m_retransmissionRecords.erase(record);
+        m_retransmissionEvents.Resolve(m_lifecycleOwner, token);
+        return;
+    }
+
+    Ptr<UbCtpTxQueue> queue = GetOrCreateQueue(record->second.packetKey,
+                                               record->second.outPort,
+                                               record->second.priority);
+    RegisterQueueIfNeeded(queue, record->second.outPort, record->second.priority);
+    queue->EnqueueData(record->second.packet->Copy());
+    ++record->second.attempts;
+    ++m_retransmissionCount;
+    Ptr<UbPort> port = DynamicCast<UbPort>(m_node->GetDevice(record->second.outPort));
+    NS_ABORT_MSG_IF(port == nullptr, "CTP retransmission selected a non-UB source port");
+    port->TriggerTransmit();
+    const UbCtpEntityKey packetKey = record->second.packetKey;
+    const uint32_t outPort = record->second.outPort;
+    const uint32_t priority = record->second.priority;
+    Ptr<Packet> packet = record->second.packet;
+    m_retransmissionEvents.Resolve(m_lifecycleOwner, token);
+    ArmRetransmission(stateKey,
+                      packetKey,
+                      taSsn,
+                      outPort,
+                      priority,
+                      packet);
+}
