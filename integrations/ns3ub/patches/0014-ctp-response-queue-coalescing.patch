+void UbPort::DiscardTransmitPacket(Ptr<Packet> packet)
+{
+    auto controller = GetNode()->GetObject<UbController>();
+    auto ctp = controller ? controller->PeekCtpTransportService() : nullptr;
+    if (ctp) ctp->ResponseDiscardedBeforeSend(packet);
+    m_flowControl->OnEgressCancelled(
+        {packet, nullptr, m_currentInPortId, m_portId, m_currentPriority});
