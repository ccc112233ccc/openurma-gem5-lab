 void
+UbCtpTransportService::ResponseDiscardedBeforeSend(Ptr<Packet> packet)
+{
+    const auto queued = m_queuedResponses.find(packet->GetUid());
+    if (queued == m_queuedResponses.end()) return;
+    const auto record = m_receivedRmaRequests.find(queued->second.key);
+    if (record != m_receivedRmaRequests.end() && record->second.response == queued->second.response) {
+        NS_ABORT_MSG_IF(record->second.queued == 0, "CTP response discard ownership underflow");
+        --record->second.queued;
+    }
+    m_queuedResponses.erase(queued);
+}
+
+void
+UbCtpTransportService::TrackQueuedResponse(Ptr<Packet> packet, Ptr<UbWqeSegment> response,
+                                         const UbCtpEntityKey& key)
+{
+    const auto identity = std::make_pair(key, response->GetRequestTassn());
+    auto record = m_receivedRmaRequests.find(identity);
+    if (record == m_receivedRmaRequests.end() || record->second.response != response) return;
+    const bool inserted = m_queuedResponses.emplace(packet->GetUid(),
+        QueuedResponse{identity, response, Simulator::Now()}).second;
+    NS_ABORT_MSG_IF(!inserted, "CTP response packet already queued");
+    ++record->second.queued;
+}
