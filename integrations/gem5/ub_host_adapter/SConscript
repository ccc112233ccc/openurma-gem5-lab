import os
import sys

Import('*')

lab = os.environ['UBSIM_LAB_ROOT']
env.Append(CPPPATH=[lab, os.path.join(lab, 'sources/simbricks/lib')])

SimObject('UbHostAdapter.py', sim_objects=['UbHostAdapter'])
Source('UbHostAdapter.cc')
simbricks_flags = ['-Wno-error=format'] if sys.platform == 'darwin' else []
Source('simbricks_base_portable.c', append={'CCFLAGS': simbricks_flags})
