@@ -86,6 +86,7 @@
 #include "target/arm/gtimer.h"
 #include "hw/mem/pc-dimm.h"
 #include "hw/mem/nvdimm.h"
+#include "hw/misc/openurma-ub-host.h"
 #include "hw/acpi/generic_event_device.h"
